+# Columns added after the first release, per table. CREATE TABLE IF NOT EXISTS
+# is a no-op against an existing legacy table, so missing columns have to be
+# added explicitly or every query referencing them fails on upgraded installs.
+SCHEMA_ADDITIONS = {
+    'care_events': (
+        ('severity', "TEXT NOT NULL DEFAULT 'info'"),
+        ('source', "TEXT NOT NULL DEFAULT 'manual'"),
+        ('created_by', "TEXT NOT NULL DEFAULT ''"),
+        ('ts', 'INTEGER NOT NULL DEFAULT 0'),
+    ),
+}
+
+
+def table_columns(conn, table: str) -> set:
+    try:
+        return {str(r['name']) for r in conn.execute(f'PRAGMA table_info({table})').fetchall()}
+    except sqlite3.Error:
+        return set()
+
+
+def migrate_schema(conn):
+    """Add columns missing from legacy tables, preserving existing rows.
+
+    Runs on every startup and is idempotent: only genuinely absent columns are
+    added, and old rows get a sensible backfill instead of NULL.
+    """
+    for table, additions in SCHEMA_ADDITIONS.items():
+        existing = table_columns(conn, table)
+        if not existing:
+            continue  # table absent entirely; CREATE TABLE above already handled it
+        for column, ddl in additions:
+            if column in existing:
+                continue
+            conn.execute(f'ALTER TABLE {table} ADD COLUMN {column} {ddl}')
+            print(f'[DB] migrated {table}: added column {column}')
+
+    # Legacy care_events rows predate `ts`; fall back to their creation time so
+    # ordering and "recent events" queries keep working for historical data.
+    if table_columns(conn, 'care_events') >= {'ts', 'created_ts'}:
+        conn.execute(
+            'UPDATE care_events SET ts = created_ts WHERE ts IS NULL OR ts = 0'
+        )
+        # Only safe to index once the column is guaranteed to exist.
+        conn.execute('CREATE INDEX IF NOT EXISTS idx_care_events_ts ON care_events(ts DESC)')
+
+
