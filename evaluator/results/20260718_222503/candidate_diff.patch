+def _migrate_care_events(conn):
+    """Upgrade pre-v3 care_events tables without replacing historical rows."""
+    existing = {row["name"] for row in conn.execute("PRAGMA table_info(care_events)")}
+    additions = {
+        "severity": "TEXT NOT NULL DEFAULT 'info'",
+        "source": "TEXT NOT NULL DEFAULT 'manual'",
+        "created_by": "TEXT NOT NULL DEFAULT ''",
+        "ts": "INTEGER NOT NULL DEFAULT 0",
+    }
+    for name, definition in additions.items():
+        if name not in existing:
+            conn.execute(f"ALTER TABLE care_events ADD COLUMN {name} {definition}")
+    conn.execute("UPDATE care_events SET severity = 'info' WHERE severity IS NULL OR severity = ''")
+    conn.execute("UPDATE care_events SET source = 'manual' WHERE source IS NULL OR source = ''")
+    conn.execute("UPDATE care_events SET created_by = '' WHERE created_by IS NULL")
+    conn.execute("UPDATE care_events SET ts = created_ts WHERE ts IS NULL OR ts <= 0")
+    conn.execute("CREATE INDEX IF NOT EXISTS idx_care_events_subject_ts ON care_events(subject_id, ts DESC)")
+    conn.execute("CREATE INDEX IF NOT EXISTS idx_care_events_room_bed_ts ON care_events(room, bed, ts DESC)")
+
