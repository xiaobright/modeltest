+def fetch_gateway_current_session() -> Optional[dict]:
+    """Fetch the current gateway session and return it (or None).
+
+    The voice assistant links its sensitive context request to an explicit
+    session obtained from the gateway instead of relying on the gateway's
+    ambient/current session fallback. This keeps the authorization check
+    explicit and prevents accidental data exposure.
+    """
+    if not GATEWAY_CONTEXT_ENABLED:
+        return None
+    try:
+        r = requests.get(GATEWAY_CURRENT_SESSION_URL, timeout=GATEWAY_TIMEOUT_S)
+        r.raise_for_status()
+        obj = r.json()
+        if isinstance(obj, dict):
+            session = obj.get("session")
+            return session if isinstance(session, dict) else None
+    except Exception as e:  # noqa: BLE001
+        print(f"[GATEWAY当前会话获取失败] {e}")
+    return None
+
+
