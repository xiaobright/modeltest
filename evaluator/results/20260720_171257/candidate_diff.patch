+def _migrate_care_events(conn):
+    """Migrate legacy care_events table: add missing columns without losing data."""
+    cursor = conn.execute("PRAGMA table_info(care_events)")
+    existing_cols = {row[1] for row in cursor.fetchall()}
+    migrations = [
+        ("severity", "TEXT NOT NULL DEFAULT 'info'"),
+        ("source", "TEXT NOT NULL DEFAULT 'manual'"),
+        ("created_by", "TEXT NOT NULL DEFAULT ''"),
+        ("ts", "INTEGER NOT NULL DEFAULT 0"),
+    ]
+    for col_name, col_def in migrations:
+        if col_name not in existing_cols:
+            conn.execute(f"ALTER TABLE care_events ADD COLUMN {col_name} {col_def}")
+            print(f"[DB] Migrated care_events: added column '{col_name}'")
+    # Backfill ts from created_ts for old rows where ts is 0
+    conn.execute("UPDATE care_events SET ts = created_ts WHERE ts = 0 AND created_ts > 0")
+
