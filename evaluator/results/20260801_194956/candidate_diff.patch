+def migrate_care_events_schema(conn):
+    """Upgrade legacy care_events tables in place, keeping old rows.
+
+    Old tables may only have event_id/subject_id/room/bed/kind/title/content/
+    created_ts/updated_ts.  We add the v3 columns (severity/source/created_by/
+    ts) with sensible defaults and backfill ts from created_ts so ordering and
+    context aggregation keep working for historical rows.
+    """
+    cols = {row["name"] for row in conn.execute("PRAGMA table_info(care_events)").fetchall()}
+    additions = [
+        ("severity", "ALTER TABLE care_events ADD COLUMN severity TEXT NOT NULL DEFAULT 'info'"),
+        ("source", "ALTER TABLE care_events ADD COLUMN source TEXT NOT NULL DEFAULT 'manual'"),
+        ("created_by", "ALTER TABLE care_events ADD COLUMN created_by TEXT NOT NULL DEFAULT ''"),
+        ("ts", "ALTER TABLE care_events ADD COLUMN ts INTEGER NOT NULL DEFAULT 0"),
+    ]
+    for col, ddl in additions:
+        if col not in cols:
+            conn.execute(ddl)
+            print(f'[DB] migrated care_events: added column {col}')
+    # Backfill ts for legacy rows that predate the column.
+    conn.execute("UPDATE care_events SET ts = created_ts WHERE ts = 0 OR ts IS NULL")
+
