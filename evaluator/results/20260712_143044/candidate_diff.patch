+// =====================
+static void mqtt_publish_sensor_data(const char* topic_suffix,
+                                      const uint8_t* payload_data,
+                                      size_t payload_len) {
+    if (!s_mqtt_connected || s_topic_prefix[0] == '\0') {
+        return;
+    }
+
+    char topic[128];
+    snprintf(topic, sizeof(topic), "%s%s", s_topic_prefix, topic_suffix);
+
+    std::string b64 = base64_encode(payload_data, payload_len);
+    std::string json = "{\"payload_b64\":\"" + b64 + "\"}";
+
+    esp_mqtt_client_publish(s_mqtt_client, topic, json.c_str(), json.length(), 0, 0);
+}
