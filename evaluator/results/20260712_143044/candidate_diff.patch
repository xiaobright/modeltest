+// =====================
+// 初始化MQTT
+// =====================
+static void mqtt_init(void) {
+    if (s_device_config.bemfa_uid[0] == '\0') {
+        ESP_LOGW(TAG, "Bemfa UID not configured, skipping MQTT init");
+        return;
+    }
+
+    char uri[256];
+    snprintf(uri, sizeof(uri), "mqtt://%s:%u",
+             s_device_config.bemfa_host[0] ? s_device_config.bemfa_host : "bemfa.com",
+             s_device_config.bemfa_mqtt_port > 0 ? s_device_config.bemfa_mqtt_port : 9501);
+
+    esp_mqtt_client_config_t mqtt_cfg = {};
+    mqtt_cfg.broker.address.uri = uri;
+    mqtt_cfg.credentials.client_id = s_device_config.bemfa_uid;
+    mqtt_cfg.credentials.username = s_device_config.bemfa_uid;
+
+    s_mqtt_client = esp_mqtt_client_init(&mqtt_cfg);
+    esp_mqtt_client_register_event(s_mqtt_client, MQTT_EVENT_ANY, mqtt_event_handler, NULL);
+    esp_mqtt_client_start(s_mqtt_client);
+
+    ESP_LOGI(TAG, "MQTT init done, connecting to %s", uri);
+}
