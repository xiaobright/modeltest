+// =====================
+// Base64编码
+// =====================
+static std::string base64_encode(const uint8_t* data, size_t len) {
+    if (len == 0) {
+        return "";
+    }
+
+    size_t out_len = 0;
+    mbedtls_base64_encode(NULL, 0, &out_len, data, len);
+
+    std::string result(out_len + 1, '\0');
+    mbedtls_base64_encode((unsigned char*)&result[0], result.size(), &out_len, data, len);
+    result.resize(out_len);
+    return result;
+}
+
+// =====================
+// Wi-Fi事件处理
+// =====================
+static void wifi_event_handler(void* arg, esp_event_base_t event_base,
+                               int32_t event_id, void* event_data) {
+    if (event_base == WIFI_EVENT && event_id == WIFI_EVENT_STA_START) {
+        esp_wifi_connect();
+    } else if (event_base == WIFI_EVENT && event_id == WIFI_EVENT_STA_DISCONNECTED) {
+        s_wifi_connected = false;
+        ESP_LOGI(TAG, "WiFi disconnected, reconnecting...");
+        xEventGroupSetBits(s_wifi_event_group, WIFI_FAIL_BIT);
+        esp_wifi_connect();
+    } else if (event_base == IP_EVENT && event_id == IP_EVENT_STA_GOT_IP) {
+        s_wifi_connected = true;
+        ESP_LOGI(TAG, "WiFi connected, got IP");
+        xEventGroupSetBits(s_wifi_event_group, WIFI_CONNECTED_BIT);
+    }
+}
+
+// =====================
+// MQTT事件处理
+// =====================
+static void mqtt_event_handler(void* arg, esp_event_base_t event_base,
+                               int32_t event_id, void* event_data) {
+    (void)arg; (void)event_base; (void)event_data;
+    switch (event_id) {
+        case MQTT_EVENT_CONNECTED:
+            ESP_LOGI(TAG, "MQTT connected to bemfa");
+            s_mqtt_connected = true;
+            break;
+        case MQTT_EVENT_DISCONNECTED:
+            ESP_LOGI(TAG, "MQTT disconnected");
+            s_mqtt_connected = false;
+            break;
+        case MQTT_EVENT_ERROR:
+            ESP_LOGW(TAG, "MQTT error");
+            break;
+        default:
+            break;
+    }
+}
