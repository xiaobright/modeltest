+def _table_columns(conn, table: str) -> set:
+    return {str(row["name"]) for row in conn.execute(f"PRAGMA table_info({table})").fetchall()}
+
+
+def _table_exists(conn, table: str) -> bool:
+    row = conn.execute(
+        "SELECT 1 FROM sqlite_master WHERE type = 'table' AND name = ?",
+        (table,),
+    ).fetchone()
+    return row is not None
+
+
+def migrate_management_db(conn) -> None:
+    """Upgrade legacy tables in place (ADD COLUMN only) and backfill defaults.
+
+    Never drops tables or columns, so historical rows are preserved.
+    """
+    for table, columns in _TABLE_COLUMN_MIGRATIONS.items():
+        if not _table_exists(conn, table):
+            continue
+        existing = _table_columns(conn, table)
+        for name, ddl in columns:
+            if name not in existing:
+                conn.execute(f"ALTER TABLE {table} ADD COLUMN {name} {ddl}")
+        existing = _table_columns(conn, table)
+        # Backfill the event timestamp from created_ts for legacy rows.
+        if "ts" in existing and "created_ts" in existing:
+            conn.execute(f"UPDATE {table} SET ts = created_ts WHERE ts = 0 OR ts IS NULL")
+
