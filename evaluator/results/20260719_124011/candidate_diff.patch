+        if (usb_lock(pdMS_TO_TICKS(2))) {
+            int avail = tud_cdc_n_write_available(0);
+            if (avail > 0) {
+                int chunk = (len - sent) > (uint32_t)avail ? avail : (int)(len - sent);
+                int written = tud_cdc_n_write(0, payload + sent, chunk);
+                sent += written;
+                tud_cdc_n_write_flush(0);
+            }
+            usb_unlock();
+        }
+        vTaskDelay(1); // 等待 USB 主机取走数据
+    }
+
+    uint8_t crc_bytes[PACKET_CRC_LEN];
+    protocol_pack_crc(crc_bytes, payload, len);
+    if (usb_lock(pdMS_TO_TICKS(2))) {
+        tud_cdc_n_write(0, crc_bytes, sizeof(crc_bytes));
+        tud_cdc_n_write_flush(0);
+        usb_unlock();
+    }
