+# Columns that must exist on legacy tables. CREATE TABLE IF NOT EXISTS only
+# handles brand-new databases; legacy tables created by older builds may be
+# missing columns, so patch them in place and keep existing rows.
+_TABLE_COLUMN_MIGRATIONS = {
+    "care_events": (
+        ("severity", "TEXT NOT NULL DEFAULT 'info'"),
