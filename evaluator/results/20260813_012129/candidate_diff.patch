+def table_columns(conn, table: str) -> set[str]:
+    """Return the current column names of a table (empty set when missing)."""
+    try:
+        rows = conn.execute(f'PRAGMA table_info({table})').fetchall()
+    except sqlite3.OperationalError:
+        return set()
+    return {str(r['name']) for r in rows}
+
+
+def ensure_columns(conn, table: str, columns: dict[str, str]) -> list[str]:
+    """Add missing columns to a legacy table via ALTER TABLE.
+
+    `columns` maps column name to SQL column definition (type + default).
+    Existing rows are preserved; added columns take their default value.
+    Returns the list of columns that were actually added.
+    """
+    existing = table_columns(conn, table)
+    if not existing:
+        return []
+    added = []
+    for name, definition in columns.items():
+        if name in existing:
+            continue
+        conn.execute(f'ALTER TABLE {table} ADD COLUMN {name} {definition}')
+        added.append(name)
+    return added
+
