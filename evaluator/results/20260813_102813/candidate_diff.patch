+// Publish a raw sensor payload (base64-encoded, NOT the USB packet) to the
+// correct Bemfa topic. Called from both sensor tasks in parallel with USB.
+static bool mqtt_publish_raw(uint8_t sensor_type, uint8_t sensor_id,
+                             const uint8_t *payload, uint16_t len) {
+    if (s_mqtt_client == NULL || payload == NULL || len == 0) {
+        return false;
+    }
+    const char *stream = protocol_packet::stream_name(sensor_type, sensor_id);
+    if (strcmp(stream, "unknown") == 0) {
+        return false;
+    }
+    const DeviceConfig *cfg = device_config_get();
+    char topic[48];
+    device_config_topic(cfg, stream, topic, sizeof(topic));
+
+    char *json = mqtt_payload::build_json(payload, len);
+    if (json == NULL) {
+        ESP_LOGW(TAG, "MQTT payload allocation failed for %s (len=%u)", stream, (unsigned)len);
+        return false;
+    }
+    int msg_id = esp_mqtt_client_publish(s_mqtt_client, topic, json, 0, 0, 0);
+    free(json);
+    if (msg_id < 0) {
+        ESP_LOGW(TAG, "MQTT publish failed for topic %s", topic);
+        return false;
+    }
+    return true;
