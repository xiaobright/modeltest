-        if (parser->buffer[i] == 0x00 && parser->buffer[i + 1] == 0xFF) {
-            // 找到帧头，检查是否有足够数据读取长度字段
-            if (i + 4 > parser->buffer_len) {
-                // 数据不足以读取长度，移除帧头之前的数据
