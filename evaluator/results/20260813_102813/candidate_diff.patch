+        )
+        r.raise_for_status()
+        obj = r.json()
+        if isinstance(obj, dict):
+            sess = obj.get("session")
+            if isinstance(sess, dict):
+                return sess
+    except Exception as e:  # noqa: BLE001
+        print(f"[GATEWAY会话获取失败] {e}")
+    return None
+
+
+def resolve_gateway_session_id(explicit_session_id: str = "") -> str:
+    if explicit_session_id:
