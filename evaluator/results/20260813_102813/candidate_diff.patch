+def fetch_current_session() -> Optional[dict]:
+    """Obtain the gateway's current v3 session (recognized actor), if any.
+
+    The local assistant must carry an explicit session_id when requesting
+    sensitive chat context instead of relying on an implicit ambient session.
+    """
+    try:
