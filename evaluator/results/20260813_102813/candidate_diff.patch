+def migrate_care_events(conn):
+    """Upgrade a legacy care_events table in place, preserving old rows.
+
+    Old databases may already have a care_events table that only contains
+    event_id/subject_id/room/bed/kind/title/content/created_ts/updated_ts.
+    Add the missing v3 columns (severity/source/created_by/ts) with sensible
+    defaults and backfill `ts` from `created_ts` for pre-existing rows.
+    """
+    columns = {row['name'] for row in conn.execute('PRAGMA table_info(care_events)').fetchall()}
+
+    if 'severity' not in columns:
+        conn.execute("ALTER TABLE care_events ADD COLUMN severity TEXT NOT NULL DEFAULT 'info'")
+    if 'source' not in columns:
+        conn.execute("ALTER TABLE care_events ADD COLUMN source TEXT NOT NULL DEFAULT 'manual'")
+    if 'created_by' not in columns:
+        conn.execute("ALTER TABLE care_events ADD COLUMN created_by TEXT NOT NULL DEFAULT ''")
+    if 'ts' not in columns:
+        conn.execute("ALTER TABLE care_events ADD COLUMN ts INTEGER NOT NULL DEFAULT 0")
+        conn.execute("UPDATE care_events SET ts = created_ts WHERE ts = 0")
+
