 #include "freertos/semphr.h"
 #include <errno.h>
 
+// Wi-Fi / MQTT / Base64
+#include "esp_wifi.h"
+#include "esp_event.h"
+#include "esp_netif.h"
+#include "mqtt_client.h"
+#include "mbedtls/base64.h"
+
 // TinyUSB 库 (esp_tinyusb 组件)
 #include "tinyusb.h"
 #include "tusb.h"
@@ -126,6 +133,153 @@ typedef struct {
 static device_config_t s_device_config = {};
 static bool s_device_config_ready = false;
 
+// =====================
+// Wi-Fi / MQTT runtime
+// =====================
+static esp_mqtt_client_handle_t s_mqtt_client = NULL;
+static volatile bool s_mqtt_connected = false;
+static SemaphoreHandle_t s_mqtt_mutex = NULL;
+
+static void lower_copy(char *dst, size_t dst_len, const char *src);
+
+static void build_mqtt_topic(const char *stream, char *out, size_t out_len) {
+    char room[16];
+    char bed[16];
+    lower_copy(room, sizeof(room), s_device_config.room);
+    lower_copy(bed, sizeof(bed), s_device_config.bed);
+    snprintf(out, out_len, "%s%s%s", room, bed, stream);
+}
+
+static bool mqtt_topic_ready(void) {
+    return s_device_config.room[0] != '\0' && s_device_config.bed[0] != '\0';
+}
+
+static void publish_sensor_payload(const char *stream, const uint8_t *payload, size_t len) {
+    if (!s_mqtt_client || !s_mqtt_connected || !mqtt_topic_ready() || !payload || len == 0) {
+        return;
+    }
+
+    // Compute base64 length and allocate buffers on heap to avoid large stack frames.
+    size_t b64_len = 4 * ((len + 2) / 3) + 1;
+    char *b64_buf = (char *)malloc(b64_len);
+    if (!b64_buf) {
+        ESP_LOGE(TAG, "MQTT payload malloc failed for %s", stream);
+        return;
+    }
+    size_t olen = 0;
+    int ret = mbedtls_base64_encode((unsigned char *)b64_buf, b64_len, &olen, payload, len);
+    if (ret != 0 || olen == 0) {
+        free(b64_buf);
+        ESP_LOGE(TAG, "Base64 encode failed for %s: %d", stream, ret);
+        return;
+    }
+    b64_buf[olen] = '\0';
+
+    size_t json_len = olen + 32;
+    char *json_buf = (char *)malloc(json_len);
+    if (!json_buf) {
+        free(b64_buf);
+        return;
+    }
+    int written = snprintf(json_buf, json_len, "{\"payload_b64\":\"%s\"}", b64_buf);
+    if (written > 0 && written < (int)json_len) {
+        char topic[64];
+        build_mqtt_topic(stream, topic, sizeof(topic));
+        if (xSemaphoreTake(s_mqtt_mutex, pdMS_TO_TICKS(2)) == pdTRUE) {
+            esp_mqtt_client_publish(s_mqtt_client, topic, json_buf, written, 0, 0);
+            xSemaphoreGive(s_mqtt_mutex);
+        }
+    }
+    free(json_buf);
+    free(b64_buf);
+}
+
+static void mqtt_event_handler(void *handler_args, esp_event_base_t base, int32_t event_id, void *event_data) {
+    (void)handler_args;
+    (void)event_data;
+    (void)base;
+    switch ((esp_mqtt_event_id_t)event_id) {
+        case MQTT_EVENT_CONNECTED:
+            ESP_LOGI(TAG, "MQTT connected");
+            s_mqtt_connected = true;
+            break;
+        case MQTT_EVENT_DISCONNECTED:
+            ESP_LOGI(TAG, "MQTT disconnected");
+            s_mqtt_connected = false;
+            break;
+        case MQTT_EVENT_PUBLISHED:
+            ESP_LOGD(TAG, "MQTT message published");
+            break;
+        default:
+            break;
+    }
+}
+
+static void mqtt_app_start(void) {
+    if (s_mqtt_client != NULL || s_device_config.bemfa_uid[0] == '\0') {
+        return;
+    }
+    char uri[128];
+    snprintf(uri, sizeof(uri), "mqtt://%s:%u",
+             s_device_config.bemfa_host[0] ? s_device_config.bemfa_host : "bemfa.com",
+             s_device_config.bemfa_mqtt_port ? s_device_config.bemfa_mqtt_port : 9501);
+
+    esp_mqtt_client_config_t mqtt_cfg = {};
+    mqtt_cfg.broker.address.uri = uri;
+    mqtt_cfg.credentials.client_id = s_device_config.bemfa_uid;
+    mqtt_cfg.session.keepalive = 60;
+
+    s_mqtt_client = esp_mqtt_client_init(&mqtt_cfg);
+    if (!s_mqtt_client) {
+        ESP_LOGE(TAG, "MQTT client init failed");
+        return;
+    }
+    esp_mqtt_client_register_event(s_mqtt_client, MQTT_EVENT_ANY, mqtt_event_handler, NULL);
+    esp_mqtt_client_start(s_mqtt_client);
+}
+
+static void wifi_event_handler(void *arg, esp_event_base_t event_base, int32_t event_id, void *event_data) {
+    (void)arg;
+    (void)event_data;
+    if (event_base == WIFI_EVENT && event_id == WIFI_EVENT_STA_START) {
+        ESP_LOGI(TAG, "Wi-Fi STA start, connecting...");
+        esp_wifi_connect();
+    } else if (event_base == WIFI_EVENT && event_id == WIFI_EVENT_STA_DISCONNECTED) {
+        ESP_LOGI(TAG, "Wi-Fi disconnected, retrying...");
+        s_mqtt_connected = false;
+        esp_wifi_connect();
+    } else if (event_base == IP_EVENT && event_id == IP_EVENT_STA_GOT_IP) {
+        ESP_LOGI(TAG, "Wi-Fi got IP");
+        mqtt_app_start();
+    }
+}
+
+static void wifi_init_sta(void) {
+    if (s_device_config.wifi_ssid[0] == '\0') {
+        ESP_LOGW(TAG, "Wi-Fi SSID not configured, skipping STA");
+        return;
+    }
+    ESP_ERROR_CHECK(esp_netif_init());
+    ESP_ERROR_CHECK(esp_event_loop_create_default());
+    esp_netif_create_default_wifi_sta();
+
+    wifi_init_config_t cfg = WIFI_INIT_CONFIG_DEFAULT();
+    ESP_ERROR_CHECK(esp_wifi_init(&cfg));
+
+    esp_event_handler_instance_t instance_any_id;
+    esp_event_handler_instance_t instance_got_ip;
+    ESP_ERROR_CHECK(esp_event_handler_instance_register(WIFI_EVENT, ESP_EVENT_ANY_ID, &wifi_event_handler, NULL, &instance_any_id));
+    ESP_ERROR_CHECK(esp_event_handler_instance_register(IP_EVENT, IP_EVENT_STA_GOT_IP, &wifi_event_handler, NULL, &instance_got_ip));
+
+    wifi_config_t wifi_config = {};
+    strlcpy((char *)wifi_config.sta.ssid, s_device_config.wifi_ssid, sizeof(wifi_config.sta.ssid));
+    strlcpy((char *)wifi_config.sta.password, s_device_config.wifi_password, sizeof(wifi_config.sta.password));
+
+    ESP_ERROR_CHECK(esp_wifi_set_mode(WIFI_MODE_STA));
+    ESP_ERROR_CHECK(esp_wifi_set_config(WIFI_IF_STA, &wifi_config));
+    ESP_ERROR_CHECK(esp_wifi_start());
+}
