+def fetch_current_session() -> Optional[dict]:
+    """显式向 gateway 请求当前护士站会话（/api/v3/session/current）。
+
+    收紧鉴权后，/api/v3/context/chat 不再隐式回退到最近的 ambient session，
+    voice 必须先取到当前 session_id，再带着它请求敏感上下文。
+    """
+    try:
+        r = requests.get(GATEWAY_SESSION_CURRENT_URL, timeout=GATEWAY_TIMEOUT_S)
+        r.raise_for_status()
+        obj = r.json()
+        session = obj.get("session") if isinstance(obj, dict) else None
+        if isinstance(session, dict) and session.get("session_id"):
+            return session
+    except Exception as e:  # noqa: BLE001
+        print(f"[GATEWAY当前会话获取失败] {e}")
+    return None
+
+
+def resolve_session_id() -> str:
+    """返回可用于 chat_context 的 session_id：显式配置优先，其次查询网关当前会话。"""
+    if VOICE_SESSION_ID:
+        return VOICE_SESSION_ID
+    now = time.time()
+    if _session_cache["session_id"] and (now - _session_cache["fetched_at"]) < GATEWAY_SESSION_CACHE_TTL_S:
+        return _session_cache["session_id"]
+    session = fetch_current_session()
+    sid = str(session.get("session_id") or "") if session else ""
+    _session_cache["session_id"] = sid
+    _session_cache["fetched_at"] = now
+    return sid
+
