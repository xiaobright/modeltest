+# Columns required by the v3 care_event spec. Legacy databases may only have
+# event_id/subject_id/room/bed/kind/title/content/created_ts/updated_ts.
+CARE_EVENTS_REQUIRED_COLUMNS = (
+    ("severity", "TEXT NOT NULL DEFAULT 'info'"),
+    ("source", "TEXT NOT NULL DEFAULT 'manual'"),
+    ("created_by", "TEXT NOT NULL DEFAULT ''"),
+    ("ts", "INTEGER NOT NULL DEFAULT 0"),
+)
+
+
+def ensure_care_events_schema(conn) -> list[str]:
+    """Upgrade a legacy care_events table in place.
+
+    CREATE TABLE IF NOT EXISTS only covers brand-new databases; existing
+    databases keep their old column set, so missing columns are added with
+    ALTER TABLE and old rows are backfilled instead of dropped.
+    """
+    rows = conn.execute("PRAGMA table_info(care_events)").fetchall()
+    if not rows:
+        return []
+    existing = {str(r["name"]) for r in rows}
+    added = []
+    for name, decl in CARE_EVENTS_REQUIRED_COLUMNS:
+        if name not in existing:
+            conn.execute(f"ALTER TABLE care_events ADD COLUMN {name} {decl}")
+            added.append(name)
+    if "ts" in added:
+        conn.execute(
+            "UPDATE care_events SET ts = created_ts WHERE (ts IS NULL OR ts = 0) AND created_ts IS NOT NULL"
+        )
+    if added:
+        print(f"[DB] care_events schema migrated, added columns: {', '.join(added)}")
+    return added
+
