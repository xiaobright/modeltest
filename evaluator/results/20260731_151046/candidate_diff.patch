     return dict(row) if row is not None else None
 
 
+# Columns that may be missing when the DB file was created by an older build.
+# init_management_db() runs CREATE TABLE IF NOT EXISTS, then migrates any
+# pre-existing tables by adding the missing columns and backfilling defaults —
+# this keeps historical rows intact instead of forcing a fresh schema.
+_LEGACY_COLUMN_MIGRATIONS: dict[str, list[tuple[str, str]]] = {
+    "care_events": [
+        ("severity", "TEXT NOT NULL DEFAULT 'info'"),
+        ("source", "TEXT NOT NULL DEFAULT 'manual'"),
+        ("created_by", "TEXT NOT NULL DEFAULT ''"),
+        ("ts", "INTEGER NOT NULL DEFAULT 0"),
+    ],
+}
+
+
+def _table_exists(conn, name: str) -> bool:
+    row = conn.execute(
+        "SELECT 1 FROM sqlite_master WHERE type = 'table' AND name = ?", (name,)
+    ).fetchone()
+    return row is not None
+
+
+def _table_columns(conn, name: str) -> set[str]:
+    return {str(r[1]) for r in conn.execute(f"PRAGMA table_info({name})").fetchall()}
+
+
+def _ensure_columns(conn, table: str, columns: list[tuple[str, str]]) -> list[str]:
+    if not _table_exists(conn, table):
+        return []
+    existing = _table_columns(conn, table)
+    added = []
+    for column, ddl in columns:
+        if column not in existing:
+            conn.execute(f"ALTER TABLE {table} ADD COLUMN {column} {ddl}")
+            added.append(column)
+    return added
+
+
+def migrate_legacy_schema(conn) -> None:
+    for table, columns in _LEGACY_COLUMN_MIGRATIONS.items():
+        added = _ensure_columns(conn, table, columns)
+        if added:
+            print(f"[DB] migrated table {table}: added columns {', '.join(added)}")
+    if _table_exists(conn, "care_events"):
+        # Historical rows predate the ts column: use created_ts as the event time.
+        conn.execute("UPDATE care_events SET ts = created_ts WHERE ts = 0")
+
+
