+    s_mqtt_client = esp_mqtt_client_init(&mqtt_cfg);
+    if (s_mqtt_client == NULL) {
+        ESP_LOGE(TAG, "Failed to init MQTT client");
+        return false;
+    }
+
+    ESP_ERROR_CHECK(esp_mqtt_client_register_event(s_mqtt_client, ESP_EVENT_ANY_ID, mqtt_event_handler, NULL));
+    
+    EventBits_t bits = xEventGroupWaitBits(s_wifi_event_group, WIFI_CONNECTED_BIT,
+                                            pdFALSE, pdTRUE, pdMS_TO_TICKS(30000));
+    if (!(bits & WIFI_CONNECTED_BIT)) {
+        ESP_LOGW(TAG, "Wi-Fi not connected, MQTT init deferred");
+        return false;
+    }
+
+    ESP_ERROR_CHECK(esp_mqtt_client_start(s_mqtt_client));
+    update_mqtt_topics();
+    return true;
+}
+#endif
+
+// 初始化网络（Wi-Fi + MQTT）
+static bool init_network(void) {
+    if (s_network_initialized) {
+        return true;
+    }
+    
+    s_network_mutex = xSemaphoreCreateMutex();
+    if (s_network_mutex == NULL) {
+        ESP_LOGE(TAG, "Failed to create network mutex");
+        return false;
+    }
+
+    bool wifi_ok = init_wifi();
+    if (!wifi_ok) {
+        ESP_LOGW(TAG, "Wi-Fi init skipped (not configured)");
+    }
+
+#ifdef ESP_MQTT_AVAILABLE
+    if (wifi_ok) {
+        bool mqtt_ok = init_mqtt();
+        if (!mqtt_ok) {
+            ESP_LOGW(TAG, "MQTT init deferred or failed");
+        }
+    }
+#else
+    ESP_LOGI(TAG, "MQTT not available (ESP_MQTT_AVAILABLE not defined)");
+#endif
+
+    s_network_initialized = true;
+    return wifi_ok;
+}
+
+#ifdef ESP_MQTT_AVAILABLE
+// 通过 MQTT 发布 payload
+static void mqtt_publish_payload(const char* payload_type, const uint8_t* raw_payload, size_t payload_len) {
+    if (s_mqtt_client == NULL || !s_mqtt_connected) {
+        return;
+    }
+    if (xSemaphoreTake(s_network_mutex, pdMS_TO_TICKS(10)) != pdTRUE) {
+        return;
+    }
+
+    const char* topic = NULL;
+    if (strcmp(payload_type, "tof1") == 0) {
+        topic = s_mqtt_topic_tof1;
+    } else if (strcmp(payload_type, "tof2") == 0) {
+        topic = s_mqtt_topic_tof2;
+    } else if (strcmp(payload_type, "mlx1") == 0) {
+        topic = s_mqtt_topic_mlx1;
+    } else if (strcmp(payload_type, "mlx2") == 0) {
+        topic = s_mqtt_topic_mlx2;
+    } else {
+        xSemaphoreGive(s_network_mutex);
+        return;
+    }
+
+    if (topic[0] == '\0') {
+        xSemaphoreGive(s_network_mutex);
+        return;
+    }
+
+    size_t b64_len = sizeof(s_b64_buf);
+    int ret = mbedtls_base64_encode((uint8_t*)s_b64_buf, b64_len, &b64_len, raw_payload, payload_len);
+    if (ret != 0) {
+        ESP_LOGE(TAG, "Base64 encode failed: -0x%x", -ret);
+        xSemaphoreGive(s_network_mutex);
+        return;
+    }
+
+    char json_buf[22000];
+    int json_len = snprintf(json_buf, sizeof(json_buf), "{\"payload_b64\":\"%s\"}", s_b64_buf);
+    if (json_len >= (int)sizeof(json_buf)) {
+        json_len = sizeof(json_buf) - 1;
+    }
+
+    int msg_id = esp_mqtt_client_publish(s_mqtt_client, topic, json_buf, json_len, 1, 0);
+    if (msg_id < 0) {
+        ESP_LOGW(TAG, "MQTT publish failed for %s", topic);
+    }
+
+    xSemaphoreGive(s_network_mutex);
+}
+#else
+// MQTT 不可用时的空实现
+static void mqtt_publish_payload(const char* payload_type, const uint8_t* raw_payload, size_t payload_len) {
+    (void)payload_type;
+    (void)raw_payload;
+    (void)payload_len;
+}
+#endif
