+static void network_event_handler(void *arg, esp_event_base_t event_base,
+                                  int32_t event_id, void *event_data) {
+    (void)arg;
+    (void)event_data;
+    if (event_base == WIFI_EVENT) {
+        if (event_id == WIFI_EVENT_STA_START) {
+            esp_wifi_connect();
+        } else if (event_id == WIFI_EVENT_STA_DISCONNECTED) {
+            if (s_network_events) {
+                xEventGroupClearBits(s_network_events, WIFI_CONNECTED_BIT | MQTT_CONNECTED_BIT);
+            }
+            esp_wifi_connect();
+            ESP_LOGW(TAG, "Wi-Fi disconnected; reconnecting");
+        }
+        return;
+    }
+    if (event_base == IP_EVENT && event_id == IP_EVENT_STA_GOT_IP) {
+        if (s_network_events) {
+            xEventGroupSetBits(s_network_events, WIFI_CONNECTED_BIT);
+        }
+        ESP_LOGI(TAG, "Wi-Fi connected");
+    }
+}
+
+static void mqtt_event_handler(void *handler_args, esp_event_base_t base,
+                               int32_t event_id, void *event_data) {
+    (void)handler_args;
+    (void)base;
+    esp_mqtt_event_handle_t event = (esp_mqtt_event_handle_t)event_data;
+    if (event_id == MQTT_EVENT_CONNECTED) {
+        if (s_network_events) {
+            xEventGroupSetBits(s_network_events, MQTT_CONNECTED_BIT);
+        }
+        ESP_LOGI(TAG, "MQTT connected to %s", s_device_config.bemfa_host);
+    } else if (event_id == MQTT_EVENT_DISCONNECTED) {
+        if (s_network_events) {
+            xEventGroupClearBits(s_network_events, MQTT_CONNECTED_BIT);
+        }
+        ESP_LOGW(TAG, "MQTT disconnected");
+    } else if (event_id == MQTT_EVENT_ERROR && event && event->error_handle) {
+        ESP_LOGW(TAG, "MQTT error event type=%d", (int)event->error_handle->error_type);
+    }
+}
+
+static bool mqtt_publish_raw(uint8_t sensor_type, uint8_t sensor_id,
+                             const uint8_t *payload, size_t payload_len) {
+    if (!s_mqtt_client || !s_network_events ||
+        (xEventGroupGetBits(s_network_events) & MQTT_CONNECTED_BIT) == 0) {
+        return false;
+    }
+    char *message = NULL;
+    size_t message_len = 0;
+    message = mqtt_build_payload_json(payload, payload_len, &message_len);
+    if (!message) {
+        ESP_LOGW(TAG, "MQTT payload encoding failed type=%u id=%u len=%u",
+                 (unsigned)sensor_type, (unsigned)sensor_id, (unsigned)payload_len);
+        return false;
+    }
+
+    const char *topic = NULL;
+    if (sensor_id < 1 || sensor_id > 2) {
+        free(message);
+        return false;
+    }
+    if (sensor_type == SENSOR_TYPE_TOF) {
+        topic = s_mqtt_topics[2 + (sensor_id - 1)];
+    } else if (sensor_type == SENSOR_TYPE_MLX) {
+        topic = s_mqtt_topics[sensor_id - 1];
+    }
+    if (!topic || topic[0] == '\0') {
+        free(message);
+        return false;
+    }
+
+    bool published = false;
+    if (s_mqtt_mutex && xSemaphoreTake(s_mqtt_mutex, pdMS_TO_TICKS(100)) == pdTRUE) {
+        int msg_id = esp_mqtt_client_publish(
+            s_mqtt_client, topic, message, (int)message_len, 1, 0
+        );
+        published = msg_id >= 0;
+        xSemaphoreGive(s_mqtt_mutex);
+    }
+    free(message);
+    return published;
+}
