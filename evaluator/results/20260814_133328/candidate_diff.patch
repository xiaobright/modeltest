+/* main/main.cpp
+ *
+ * ESP32-S3 posture sensor bridge (Project2):
+ *   - MaixSense ToF x2  via UART  -> USB CDC1 (+ Bemfa MQTT backhaul)
+ *   - MLX90640 x2     via I2C   -> USB CDC0 (+ Bemfa MQTT backhaul)
+ *
+ * Module layout:
+ *   protocol_packet.{h,cpp}   USB packet constants / CRC16-CCITT
+ *   maixsense_parser.{h,cpp}  MaixSense raw frame byte-stream parser
+ *   device_config.{h,cpp}     NVS config (ssid/password/uid/room/bed)
+ *   mqtt_payload.{h,cpp}      topic selection + payload_b64 JSON
+ *   network_backhaul.{h,cpp}  Wi-Fi STA + Bemfa MQTT client
+ *   main.cpp                  ESP-IDF init, tasks, hardware glue
+ *
+ * USB packet: [AA 55][TYPE][ID][LEN_L LEN_H][PAYLOAD...][CRC_L CRC_H]
+ *   TYPE=0x01 MLX90640, TYPE=0x02 MaixSense ToF.
+ *   CRC16-CCITT (init 0xFFFF, poly 0x1021) covers the payload only; LEN and
+ *   CRC are little-endian.
+ * MQTT: topic {room}{bed}{tof1|tof2|mlx1|mlx2} (lowercased),
+ *   message {"payload_b64":"<base64 raw payload>"} — the base64 content is
+ *   the raw sensor payload, not the full USB packet.
+ */
