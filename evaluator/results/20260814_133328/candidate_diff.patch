+// ==========================================================
+// Task 1: ToF sensor stream (UART1/2 -> USB CDC1 + MQTT)
+// ==========================================================
+struct TofStreamParams {
+    uart_port_t uart_num; // physical UART port
+    uint8_t src_id;       // ToF source id (1/2)
+};
+
+static const TofStreamParams s_tof_params[] = {
+    { .uart_num = UART1_PORT, .src_id = 1 },
+    { .uart_num = UART2_PORT, .src_id = 2 },
+};
+
+// Send one ToF raw MaixSense frame over USB CDC1 (unified packet format) and
+// mirror the raw payload to the Bemfa MQTT topic in parallel.
+static void usb_send_tof_payload(uint8_t src_id, const uint8_t *payload, uint16_t len) {
+    bool usb_connected = false;
+    if (usb_lock(pdMS_TO_TICKS(2))) {
+        usb_connected = tud_cdc_n_connected(1);
+        if (usb_connected) {
+            uint8_t header[protocol_packet::PACKET_HEADER_LEN];
+            protocol_packet::build_packet_header(
+                protocol_packet::SENSOR_TYPE_TOF, src_id, len, header);
+            tud_cdc_n_write(1, header, sizeof(header));
+            tud_cdc_n_write_flush(1);
+        }
+        usb_unlock();
+    }
+
+    if (usb_connected) {
+        uint32_t sent = 0;
+        while (sent < len) {
+            if (!usb_lock(pdMS_TO_TICKS(2))) {
+                vTaskDelay(1);
+                continue;
+            }
+            int avail = tud_cdc_n_write_available(1);
+            if (avail > 0) {
+                int chunk = (len - sent) > (uint32_t)avail ? avail : (int)(len - sent);
+                int written = tud_cdc_n_write(1, payload + sent, chunk);
+                sent += written;
+                tud_cdc_n_write_flush(1);
+            }
+            usb_unlock();
+            vTaskDelay(1);
+        }
+
+        uint8_t crc_bytes[protocol_packet::PACKET_CRC_LEN];
+        uint16_t crc = protocol_packet::crc16_ccitt(payload, len);
+        protocol_packet::build_packet_crc(crc, crc_bytes);
+        if (usb_lock(pdMS_TO_TICKS(2))) {
+            tud_cdc_n_write(1, crc_bytes, sizeof(crc_bytes));
+            tud_cdc_n_write_flush(1);
+            usb_unlock();
+        }
+    }
+
+    // Parallel MQTT backhaul: publish the raw payload (full MaixSense frame)
+    // to {room}{bed}{tof1|tof2}. Dropped silently while the link is down.
+    network_backhaul::publish(s_device_config, tof_stream_name(src_id), payload, len);
+}
+
+void tof_stream_task(void *pvParameters) {
+    (void)pvParameters;
+
+    static MaixSenseFrameParser parser1;
+    static MaixSenseFrameParser parser2;
+
+    static uint8_t frame_buffer1[MaixSenseFrameParser::kBufferCapacity];
+    static uint8_t frame_buffer2[MaixSenseFrameParser::kBufferCapacity];
+    static bool frame1_ready = false;
+    static bool frame2_ready = false;
+    static uint16_t frame1_len = 0;
+    static uint16_t frame2_len = 0;
+
+    uint8_t uart_buf[512];
+
+    static uint32_t uart1_total_bytes = 0;
+    static uint32_t uart2_total_bytes = 0;
+    static uint32_t sent_frames = 0;
+    static uint32_t last_debug_time = 0;
+
+    static bool send_sensor1_next = true;
+
+    ESP_LOGI(TAG, "Starting ToF Stream Task with Alternating Frame Sending");
+
+    while (1) {
+        bool did_work = false;
+        // ===== Phase 1: receive + parse =====
+        size_t buffered_len = 0;
+        uart_get_buffered_data_len(UART1_PORT, &buffered_len);
+        if (buffered_len > 0) {
+            int len = uart_read_bytes(UART1_PORT, uart_buf,
+                                      (buffered_len > sizeof(uart_buf)) ? sizeof(uart_buf) : buffered_len,
+                                      pdMS_TO_TICKS(2));
+            if (len > 0) {
+                uart1_total_bytes += len;
+                did_work = true;
+                parser1.feed(uart_buf, len);
+                uint32_t parsed_len = parser1.next_frame(frame_buffer1);
+                if (parsed_len > 0) {
+                    frame1_ready = true;
+                    frame1_len = (uint16_t)parsed_len;
+                }
+            }
+        }
+
+        buffered_len = 0;
+        uart_get_buffered_data_len(UART2_PORT, &buffered_len);
+        if (buffered_len > 0) {
+            int len = uart_read_bytes(UART2_PORT, uart_buf,
+                                      (buffered_len > sizeof(uart_buf)) ? sizeof(uart_buf) : buffered_len,
+                                      pdMS_TO_TICKS(2));
+            if (len > 0) {
+                uart2_total_bytes += len;
+                did_work = true;
+                parser2.feed(uart_buf, len);
+                uint32_t parsed_len = parser2.next_frame(frame_buffer2);
+                if (parsed_len > 0) {
+                    frame2_ready = true;
+                    frame2_len = (uint16_t)parsed_len;
+                }
+            }
+        }
+
+        // ===== Phase 2: alternate frame sending =====
+        if (send_sensor1_next && frame1_ready) {
+            usb_send_tof_payload(1, frame_buffer1, frame1_len);
+            frame1_ready = false;
+            send_sensor1_next = false;
+            sent_frames++;
+            did_work = true;
+        } else if (!send_sensor1_next && frame2_ready) {
+            usb_send_tof_payload(2, frame_buffer2, frame2_len);
+            frame2_ready = false;
+            send_sensor1_next = true;
+            sent_frames++;
+            did_work = true;
+        } else if (send_sensor1_next && !frame1_ready && frame2_ready) {
+            vTaskDelay(pdMS_TO_TICKS(1));
+        } else if (!send_sensor1_next && !frame2_ready && frame1_ready) {
+            vTaskDelay(pdMS_TO_TICKS(1));
+        }
+
+        uint32_t now = xTaskGetTickCount();
+        if (now - last_debug_time > pdMS_TO_TICKS(30000)) {
+            ESP_LOGI(TAG, "ToF Status: Sensor1=%lu frames, Sensor2=%lu frames, Sent=%lu frames",
+                     parser1.frames_parsed(), parser2.frames_parsed(), sent_frames);
+            last_debug_time = now;
+        }
+
+        if (did_work) {
+            vTaskDelay(pdMS_TO_TICKS(1));
+        } else {
+            vTaskDelay(pdMS_TO_TICKS(5));
+        }
+    }
+}
