+def migrate_care_events_table(conn):
+    """Upgrade legacy care_events tables in place without dropping old rows.
+
+    Historical databases may already contain a care_events table that only has
+    ``event_id/subject_id/room/bed/kind/title/content/created_ts/updated_ts``.
+    Missing columns are added one by one and legacy rows are backfilled with
+    safe defaults instead of being discarded.
+    """
+    try:
+        existing = {
+            str(row[1]) for row in conn.execute("PRAGMA table_info(care_events)").fetchall()
+        }
+    except Exception:
+        return
+
+    additions = [
+        ("severity", "TEXT NOT NULL DEFAULT 'info'"),
+        ("source", "TEXT NOT NULL DEFAULT 'manual'"),
+        ("created_by", "TEXT NOT NULL DEFAULT ''"),
+        ("ts", "INTEGER NOT NULL DEFAULT 0"),
+    ]
+    for column, ddl in additions:
+        if column not in existing:
+            try:
+                conn.execute(f"ALTER TABLE care_events ADD COLUMN {column} {ddl}")
+            except Exception:
+                # Column may have been added by a concurrent initializer.
+                pass
+
+    # Backfill ts from created_ts so legacy rows sort with the new timeline.
+    try:
+        conn.execute(
+            "UPDATE care_events SET ts = created_ts WHERE ts IS NULL OR ts = 0"
+        )
+    except Exception:
+        pass
+
