-static void config_console_task(void *pvParameters) {
-    (void)pvParameters;
-    setvbuf(stdin, NULL, _IONBF, 0);
-    char line[384];
-    size_t pos = 0;
-    while (1) {
-        int ch = getchar();
-        if (ch == EOF) {
-            vTaskDelay(pdMS_TO_TICKS(50));
-            continue;
-        }
-        if (ch == '\r' || ch == '\n') {
-            line[pos] = '\0';
-            process_config_line(line);
-            pos = 0;
-        } else if (pos + 1 < sizeof(line)) {
-            line[pos++] = (char)ch;
-        }
-    }
-}
