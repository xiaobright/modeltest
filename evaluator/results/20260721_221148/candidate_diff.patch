+def fetch_current_session() -> Optional[str]:
+    """Return the current session_id from the gateway (or None).
+
+    The voice loop uses this when no explicit ``VOICE_SESSION_ID`` is set so
+    that chat-context calls are bound to the latest recognized operator
+    session instead of relying on the (now stricter) ambient session policy.
+    """
+    if not GATEWAY_CONTEXT_ENABLED:
+        return None
+    try:
+        r = requests.get(GATEWAY_SESSION_URL, timeout=GATEWAY_TIMEOUT_S)
+        r.raise_for_status()
+        obj = r.json()
+        if isinstance(obj, dict):
+            sess = obj.get("session") or {}
+            sid = str(sess.get("session_id") or "").strip()
+            return sid or None
+    except Exception as e:  # noqa: BLE001
+        print(f"[GATEWAY当前会话获取失败] {e}")
+    return None
