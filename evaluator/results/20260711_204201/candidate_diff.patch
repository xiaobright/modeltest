+def fetch_current_session_id() -> str:
+    """Fetch the current active session_id from the gateway.
+
+    After the v3 auth tightening, the context endpoint requires a valid
+    session_id.  The voice assistant may not have one pre-configured, so
+    we fetch the gateway's current session (which is a local-service path
+    allowed without admin cookie) before requesting sensitive context.
+    """
+    if not GATEWAY_CONTEXT_ENABLED:
+        return ""
+    try:
+        r = requests.get(GATEWAY_SESSION_CURRENT_URL, timeout=GATEWAY_TIMEOUT_S)
+        r.raise_for_status()
+        obj = r.json()
+        if isinstance(obj, dict):
+            sess = obj.get("session")
+            if isinstance(sess, dict) and sess.get("session_id"):
+                return str(sess["session_id"])
+    except Exception as e:  # noqa: BLE001
+        print(f"[GATEWAY获取当前会话失败] {e}")
+    return ""
+
+
