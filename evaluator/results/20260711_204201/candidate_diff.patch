+def _migrate_care_events_table(conn):
+    """Migrate legacy care_events table: add missing columns while preserving old data.
+
+    CREATE TABLE IF NOT EXISTS cannot upgrade an existing table, so we use
+    PRAGMA table_info to detect missing columns and ALTER TABLE ADD COLUMN.
+    """
+    cols = {row[1] for row in conn.execute("PRAGMA table_info(care_events)").fetchall()}
+    if not cols:
+        return  # table doesn't exist yet — CREATE TABLE will handle it
+    migrations = [
+        ("severity", "TEXT NOT NULL DEFAULT 'info'"),
+        ("source", "TEXT NOT NULL DEFAULT 'manual'"),
+        ("created_by", "TEXT NOT NULL DEFAULT ''"),
+        ("ts", "INTEGER NOT NULL DEFAULT 0"),
+    ]
+    for col_name, col_def in migrations:
+        if col_name not in cols:
+            conn.execute(f"ALTER TABLE care_events ADD COLUMN {col_name} {col_def}")
+    # Backfill ts from created_ts for legacy rows that now have ts=0.
+    conn.execute("UPDATE care_events SET ts = created_ts WHERE ts = 0")
+    # Recreate indexes with ts DESC ordering (IF NOT EXISTS is safe).
+    conn.execute(
+        "CREATE INDEX IF NOT EXISTS idx_care_events_subject "
+        "ON care_events(subject_id, ts DESC)"
+    )
+    conn.execute(
+        "CREATE INDEX IF NOT EXISTS idx_care_events_room_bed "
