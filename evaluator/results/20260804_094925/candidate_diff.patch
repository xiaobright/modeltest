+def fetch_current_gateway_session() -> Optional[dict]:
+    if not GATEWAY_CONTEXT_ENABLED:
+        return None
+    now = time.time()
+    if _cached_session["id"] and _cached_session["expires_at"] > now:
+        return {"session_id": _cached_session["id"]}
+    try:
+        r = requests.get(GATEWAY_SESSION_CURRENT_URL, timeout=GATEWAY_TIMEOUT_S)
+        r.raise_for_status()
+        obj = r.json()
+        if isinstance(obj, dict):
+            sess = obj.get("session")
+            if isinstance(sess, dict):
+                sid = str(sess.get("session_id") or "").strip()
+                if sid:
+                    expires_ms = _as_int(sess.get("expires_ts"), 0)
+                    if expires_ms:
+                        _cached_session["id"] = sid
+                        _cached_session["expires_at"] = now + max(5.0, expires_ms / 1000.0 - now * 1000.0) / 1000.0 - 10.0
+                    else:
+                        _cached_session["id"] = sid
+                        _cached_session["expires_at"] = now + 30.0
+                    return sess
+    except Exception as e:
+        print(f"[GATEWAY当前会话获取失败] {e}")
+    return None
+
+
+def resolve_gateway_session_id(session_id=None) -> str:
+    sid = (session_id if session_id is not None else VOICE_SESSION_ID).strip()
+    if sid:
+        return sid
+    cur = fetch_current_gateway_session()
+    if cur:
+        sid = str(cur.get("session_id") or "").strip()
+        if sid:
+            return sid
+    return ""
