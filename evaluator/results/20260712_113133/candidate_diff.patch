+def fetch_current_session_id() -> str:
+    """Best-effort fetch of the gateway's current v3 session id.
+
+    After auth was tightened, the chat context endpoint requires a real
+    session to release patient data — relying on a silent ambient/current
+    session would either leak data or silently break the assistant's sync.
+    We obtain the explicit session id from ``/api/v3/session/current`` and pass
+    it along so the gateway makes a deterministic allow/deny decision.
+    """
+    if not GATEWAY_CONTEXT_ENABLED:
+        return ""
+    try:
+        url = f"{GATEWAY_BASE}/api/v3/session/current"
+        r = requests.get(url, timeout=GATEWAY_TIMEOUT_S)
+        r.raise_for_status()
+        obj = r.json()
+        if isinstance(obj, dict):
+            session = obj.get("session") if isinstance(obj.get("session"), dict) else {}
+            sid = str(session.get("session_id") or "").strip()
+            return sid
+    except Exception as e:  # noqa: BLE001
+        print(f"[GATEWAY当前会话获取失败] {e}")
+    return ""
+
