+def fetch_current_session_id() -> str:
+    """从 gateway 获取当前 session_id。
+
+    收紧鉴权后，voice 不应再依赖 gateway 静默选取的 ambient session；
+    这里显式拉取当前会话并随上下文请求一并携带 session_id。
+    """
+    try:
+        r = requests.get(f"{GATEWAY_BASE}/api/v3/session/current", timeout=GATEWAY_TIMEOUT_S)
+        r.raise_for_status()
+        data = r.json()
+        session = data.get("session") if isinstance(data, dict) else None
+        if isinstance(session, dict):
+            return str(session.get("session_id") or "").strip()
+    except Exception as e:  # noqa: BLE001
+        print(f"[GATEWAY当前会话获取失败] {e}")
+    return ""
