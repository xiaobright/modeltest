+// ============================================================
+// v4: 网络回传 (Wi-Fi STA + 巴法云 MQTT)
+// 与 USB CDC 并行回传，不互相干扰。
+// 协议规范：
+//   reference/espidf_protocol_contract.md — "MQTT" 章节
+//   docs/protocol.md — "LAN 回传（MQTT 巴法云）" 章节
+//   gateway/bed_config.py — topics_for() Topic 命名规范
+// ============================================================
+static void wifi_event_handler(void* arg, esp_event_base_t base,
+                             int32_t event_id, void* event_data) {
+    (void)arg; (void)event_data;
+    if (base == WIFI_EVENT && event_id == WIFI_EVENT_STA_START) {
+        esp_wifi_connect();
+    } else if (base == IP_EVENT && event_id == IP_EVENT_STA_GOT_IP) {
+        ESP_LOGI(TAG, "WiFi STA got IP, starting MQTT client");
+        if (g_mqtt_client) {
+            esp_mqtt_client_start(g_mqtt_client);
+        }
+    } else if (base == WIFI_EVENT && event_id == WIFI_EVENT_STA_DISCONNECTED) {
+        ESP_LOGW(TAG, "WiFi disconnected, retrying");
+        esp_wifi_connect();
+    }
+}
+
+static void mqtt_event_handler(void* handler_args, esp_event_base_t base,
+                             int32_t event_id, void* event_data) {
+    // Handler is registered only for MQTT client events via
+    // esp_mqtt_client_register_event(..., MQTT_EVENT_ANY, ...), so no base check.
+    (void)base;
+    switch (event_id) {
+        case MQTT_EVENT_CONNECTED:
+            g_mqtt_connected = true;
+            ESP_LOGI(TAG, "MQTT connected to %s", g_device_config.bemfa_host);
+            break;
+        case MQTT_EVENT_DISCONNECTED:
+            g_mqtt_connected = false;
+            ESP_LOGW(TAG, "MQTT disconnected");
+            break;
+        case MQTT_EVENT_ERROR:
+            ESP_LOGE(TAG, "MQTT error");
+            break;
+        default:
+            break;
+    }
+    (void)handler_args; (void)event_data;
+}
+
+static void network_init(void) {
+    if (!dc_load(&g_device_config)) {
+        ESP_LOGW(TAG, "NVS config namespace not present; network backhaul disabled");
+        return;
+    }
+    if (!dc_is_complete(&g_device_config)) {
+        ESP_LOGW(TAG,
+            "Network config incomplete (need wifi_ssid/bemfa_uid/room/bed); "
+            "MQTT backhaul disabled, USB CDC keeps running");
+        return;
+    }
+
+    ESP_ERROR_CHECK(esp_netif_init());
+    ESP_ERROR_CHECK(esp_event_loop_create_default());
+    esp_netif_create_default_wifi_sta();
+
+    wifi_init_config_t cfg = WIFI_INIT_CONFIG_DEFAULT();
+    ESP_ERROR_CHECK(esp_wifi_init(&cfg));
+
+    wifi_config_t wifi_config = {};
+    strncpy(reinterpret_cast<char*>(wifi_config.sta.ssid),
+             g_device_config.wifi_ssid, sizeof(wifi_config.sta.ssid) - 1);
+    strncpy(reinterpret_cast<char*>(wifi_config.sta.password),
+             g_device_config.wifi_password, sizeof(wifi_config.sta.password) - 1);
+    wifi_config.sta.threshold.authmode = WIFI_AUTH_WPA2_PSK;
+
+    ESP_ERROR_CHECK(esp_event_handler_instance_register(
+        WIFI_EVENT, ESP_EVENT_ANY_ID, &wifi_event_handler, nullptr, nullptr));
+    ESP_ERROR_CHECK(esp_event_handler_instance_register(
+        IP_EVENT, IP_EVENT_STA_GOT_IP, &wifi_event_handler, nullptr, nullptr));
+
+    ESP_ERROR_CHECK(esp_wifi_set_mode(WIFI_MODE_STA));
+    ESP_ERROR_CHECK(esp_wifi_set_config(WIFI_IF_STA, &wifi_config));
+    ESP_ERROR_CHECK(esp_wifi_start());
+
+    // Bemfa MQTT: broker host/port from NVS, ClientID = bemfa_uid.
+    esp_mqtt_client_config_t mqtt_cfg = {};
+    mqtt_cfg.broker.address.hostname = g_device_config.bemfa_host;
+    mqtt_cfg.broker.address.port = g_device_config.bemfa_mqtt_port;
+    mqtt_cfg.broker.address.transport = MQTT_TRANSPORT_OVER_TCP;
+    mqtt_cfg.credentials.client_id = g_device_config.bemfa_uid;
+    mqtt_cfg.session.keepalive = 30;
+    g_mqtt_client = esp_mqtt_client_init(&mqtt_cfg);
+    if (g_mqtt_client) {
+        ESP_ERROR_CHECK(esp_mqtt_client_register_event(
+            g_mqtt_client, MQTT_EVENT_ANY, mqtt_event_handler, g_mqtt_client));
+        // Starting is deferred until IP_EVENT_STA_GOT_IP.
+    }
+    ESP_LOGI(TAG, "Network backhaul initialized (uid=%s host=%s:%u)",
+             g_device_config.bemfa_uid, g_device_config.bemfa_host,
+             g_device_config.bemfa_mqtt_port);
+}
+
+static void publish_sensor_payload(uint8_t sensor_type, uint8_t sensor_id,
+                                 const uint8_t* payload, uint16_t len) {
+    // Publish the RAW sensor payload (not the full USB packet) to the
+    // lowercase "{room}{bed}{stream}" Bemfa topic.
+    mqtt_publish_sensor(&g_device_config, sensor_type, sensor_id, payload, len);
+}
