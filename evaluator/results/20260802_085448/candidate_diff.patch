+def fetch_current_session() -> dict:
+    """Fetch the gateway's current (most recent valid) session.
+
+    After authorization tightening the assistant must carry an explicit session
+    when requesting sensitive chat context; relying on the gateway to silently
+    pick an ambient/current session can leak patient data or break sync. The
+    assistant therefore fetches the current session first and forwards its
+    session_id. Returns {} when unavailable.
+    """
+    if not GATEWAY_CONTEXT_ENABLED:
+        return {}
+    try:
+        r = requests.get(GATEWAY_CURRENT_SESSION_URL, timeout=GATEWAY_TIMEOUT_S)
+        r.raise_for_status()
+        obj = r.json()
+        session = obj.get("session") if isinstance(obj, dict) else None
+        return session if isinstance(session, dict) else {}
+    except Exception as e:  # noqa: BLE001
+        print(f"[GATEWAY当前会话获取失败] {e}")
+        return {}
+
+
+def fetch_current_session_id() -> str:
+    return str(fetch_current_session().get("session_id") or "")
