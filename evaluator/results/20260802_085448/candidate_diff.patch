+def migrate_legacy_schema(conn):
+    """Upgrade pre-existing tables that predate the current schema.
+
+    ``CREATE TABLE IF NOT EXISTS`` only handles brand-new databases.  A legacy
+    ``care_events`` table may already exist with only the draft columns
+    (event_id/subject_id/room/bed/kind/title/content/created_ts/updated_ts).
+    We add the missing v3 columns and backfill sensible values so old rows are
+    preserved and remain queryable in ts/created_ts order.
+    """
+    rows = conn.execute(
+        "SELECT name FROM sqlite_master WHERE type = 'table' AND name = 'care_events'"
+    ).fetchone()
+    if not rows:
+        return
+
+    existing = {r["name"] for r in conn.execute("PRAGMA table_info(care_events)").fetchall()}
+    additions = [
+        ("severity", "TEXT NOT NULL DEFAULT 'info'"),
+        ("source", "TEXT NOT NULL DEFAULT 'manual'"),
+        ("created_by", "TEXT NOT NULL DEFAULT ''"),
+        ("ts", "INTEGER NOT NULL DEFAULT 0"),
+    ]
+    for col_name, col_ddl in additions:
+        if col_name not in existing:
+            conn.execute(f"ALTER TABLE care_events ADD COLUMN {col_name} {col_ddl}")
+
+    # Backfill ts from created_ts for rows that predate the ts column so the
+    # ts/created_ts descending ordering stays meaningful for legacy data.
+    conn.execute("UPDATE care_events SET ts = created_ts WHERE ts = 0 AND created_ts > 0")
+
+    # Indexes reference ts, so they must be created only after the column is
+    # guaranteed to exist (legacy tables only get it via the ALTER above).
+    conn.executescript(
+        """
+        CREATE INDEX IF NOT EXISTS idx_care_events_subject
+            ON care_events(subject_id, ts DESC, created_ts DESC);
+        CREATE INDEX IF NOT EXISTS idx_care_events_room_bed
+            ON care_events(room, bed, ts DESC, created_ts DESC);
+        """
+    )
+
