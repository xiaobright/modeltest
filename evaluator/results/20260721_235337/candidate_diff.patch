+// 网络回传链路（Wi-Fi + MQTT 巴法云）
 // ==========================================================
+static void wifi_event_handler(void* arg, esp_event_base_t event_base,
+                               int32_t event_id, void* event_data) {
+    if (event_base == WIFI_EVENT && event_id == WIFI_EVENT_STA_START) {
+        esp_wifi_connect();
+    } else if (event_base == WIFI_EVENT && event_id == WIFI_EVENT_STA_DISCONNECTED) {
+        s_wifi_connected = false;
+        s_mqtt_connected = false;
+        ESP_LOGW(TAG, "Wi-Fi disconnected, retrying...");
+        esp_wifi_connect();
+    } else if (event_base == IP_EVENT && event_id == IP_EVENT_STA_GOT_IP) {
+        ip_event_got_ip_t* event = (ip_event_got_ip_t*) event_data;
+        ESP_LOGI(TAG, "Wi-Fi Got IP: " IPSTR, IP2STR(&event->ip_info.ip));
+        s_wifi_connected = true;
+        if (s_mqtt_client != NULL) {
+            esp_mqtt_client_start(s_mqtt_client);
+        }
+    }
+}
+
+static void mqtt_event_handler(void *handler_args, esp_event_base_t base, int32_t event_id, void *event_data) {
+    switch ((esp_mqtt_event_id_t)event_id) {
+    case MQTT_EVENT_CONNECTED:
+        ESP_LOGI(TAG, "MQTT Connected to broker");
+        s_mqtt_connected = true;
+        break;
+    case MQTT_EVENT_DISCONNECTED:
+        ESP_LOGW(TAG, "MQTT Disconnected");
+        s_mqtt_connected = false;
+        break;
+    case MQTT_EVENT_ERROR:
+        ESP_LOGE(TAG, "MQTT Event Error");
+        break;
+    default:
+        break;
+    }
+}
+
+static void init_network_backhaul(void) {
+    if (s_device_config.wifi_ssid[0] == '\0' || s_device_config.bemfa_uid[0] == '\0') {
+        ESP_LOGW(TAG, "Wi-Fi SSID or Bemfa UID missing in NVS config. Network backhaul disabled until configured.");
+        return;
+    }
+
+    ESP_LOGI(TAG, "Initializing Wi-Fi STA (SSID: %s)...", s_device_config.wifi_ssid);
+    ESP_ERROR_CHECK(esp_netif_init());
+    ESP_ERROR_CHECK(esp_event_loop_create_default());
+    esp_netif_create_default_wifi_sta();
+
+    wifi_init_config_t cfg = WIFI_INIT_CONFIG_DEFAULT();
+    ESP_ERROR_CHECK(esp_wifi_init(&cfg));
+
+    ESP_ERROR_CHECK(esp_event_handler_instance_register(WIFI_EVENT, ESP_EVENT_ANY_ID, &wifi_event_handler, NULL, NULL));
+    ESP_ERROR_CHECK(esp_event_handler_instance_register(IP_EVENT, IP_EVENT_STA_GOT_IP, &wifi_event_handler, NULL, NULL));
+
+    wifi_config_t wifi_config = {};
+    strncpy((char *)wifi_config.sta.ssid, s_device_config.wifi_ssid, sizeof(wifi_config.sta.ssid) - 1);
+    wifi_config.sta.ssid[sizeof(wifi_config.sta.ssid) - 1] = '\0';
+    strncpy((char *)wifi_config.sta.password, s_device_config.wifi_password, sizeof(wifi_config.sta.password) - 1);
+    wifi_config.sta.password[sizeof(wifi_config.sta.password) - 1] = '\0';
+    wifi_config.sta.threshold.authmode = s_device_config.wifi_password[0] ? WIFI_AUTH_WPA2_PSK : WIFI_AUTH_OPEN;
+
+    ESP_ERROR_CHECK(esp_wifi_set_mode(WIFI_MODE_STA));
+    ESP_ERROR_CHECK(esp_wifi_set_config(WIFI_IF_STA, &wifi_config));
+    ESP_ERROR_CHECK(esp_wifi_start());
+
+    // MQTT Client Configuration for 巴法云 (Bemfa)
+    char broker_uri[128];
+    const char *host = s_device_config.bemfa_host[0] ? s_device_config.bemfa_host : "bemfa.com";
+    uint16_t port = s_device_config.bemfa_mqtt_port > 0 ? s_device_config.bemfa_mqtt_port : 9501;
+    snprintf(broker_uri, sizeof(broker_uri), "mqtt://%s:%u", host, (unsigned)port);
+
+    esp_mqtt_client_config_t mqtt_cfg = {};
+    mqtt_cfg.broker.address.uri = broker_uri;
+    mqtt_cfg.credentials.client_id = s_device_config.bemfa_uid;
+
+    s_mqtt_client = esp_mqtt_client_init(&mqtt_cfg);
+    if (s_mqtt_client != NULL) {
+        esp_mqtt_client_register_event(s_mqtt_client, (esp_mqtt_event_id_t)ESP_EVENT_ANY_ID, mqtt_event_handler, NULL);
+        ESP_LOGI(TAG, "MQTT client initialized URI=%s client_id=%s", broker_uri, s_device_config.bemfa_uid);
+    } else {
+        ESP_LOGE(TAG, "Failed to initialize MQTT client");
+    }
+}
+
+static void make_mqtt_topic(char *dst, size_t dst_len, const char *kind) {
+    char room_lower[16] = {0};
+    char bed_lower[16] = {0};
+    lower_copy(room_lower, sizeof(room_lower), s_device_config.room);
+    lower_copy(bed_lower, sizeof(bed_lower), s_device_config.bed);
+    snprintf(dst, dst_len, "%s%s%s", room_lower, bed_lower, kind);
+}
+
+static void publish_mqtt_payload_b64(const char *topic, const uint8_t *raw_payload, size_t payload_len) {
+    if (!s_mqtt_connected || s_mqtt_client == NULL) {
+        return;
+    }
+    size_t b64_len = 0;
+    mbedtls_base64_encode(NULL, 0, &b64_len, raw_payload, payload_len);
+    if (b64_len == 0) return;
+
+    char *b64_buf = (char *)malloc(b64_len + 1);
+    if (!b64_buf) {
+        ESP_LOGE(TAG, "Failed to allocate memory for base64 encoding (size %zu)", b64_len);
+        return;
+    }
+
+    size_t out_len = 0;
+    if (mbedtls_base64_encode((unsigned char *)b64_buf, b64_len + 1, &out_len, raw_payload, payload_len) != 0) {
+        free(b64_buf);
+        return;
+    }
+    b64_buf[out_len] = '\0';
+
+    size_t json_len = out_len + 30;
+    char *json_buf = (char *)malloc(json_len);
+    if (json_buf) {
+        snprintf(json_buf, json_len, "{\"payload_b64\":\"%s\"}", b64_buf);
+        esp_mqtt_client_publish(s_mqtt_client, topic, json_buf, 0, 0, 0);
+        free(json_buf);
+    }
+    free(b64_buf);
+}
 
