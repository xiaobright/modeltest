+def migrate_legacy_tables(conn) -> list[str]:
+    """为历史 SQLite 库补齐缺失列，返回实际执行的迁移列表。"""
+    applied = []
+    for table, columns in _LEGACY_COLUMN_MIGRATIONS.items():
+        existing = _table_columns(conn, table)
+        if not existing:
+            continue
+        for col_name, col_ddl in columns:
+            if col_name in existing:
+                continue
+            conn.execute(f"ALTER TABLE {table} ADD COLUMN {col_name} {col_ddl}")
+            applied.append(f"{table}.{col_name}")
