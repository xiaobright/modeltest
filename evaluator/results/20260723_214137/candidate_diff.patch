+def migrate_care_events(conn):
+    """Upgrade legacy care_events tables that predate the v3 columns.
+
+    CREATE TABLE IF NOT EXISTS cannot add columns to an existing table, so an
+    old database may still have a care_events table without
+    severity/source/created_by/ts. Detect missing columns via PRAGMA and add
+    them in place; existing rows are preserved and their event timestamp is
+    backfilled from created_ts so ordering by ts keeps working.
+    """
+    info = conn.execute("PRAGMA table_info(care_events)").fetchall()
+    if not info:
+        return
+    columns = {row["name"] for row in info}
+    add_specs = [
+        ("severity", "TEXT NOT NULL DEFAULT 'info'"),
+        ("source", "TEXT NOT NULL DEFAULT 'manual'"),
+        ("created_by", "TEXT NOT NULL DEFAULT ''"),
+        ("ts", "INTEGER NOT NULL DEFAULT 0"),
+    ]
+    ts_added = False
+    for name, decl in add_specs:
+        if name not in columns:
+            conn.execute(f"ALTER TABLE care_events ADD COLUMN {name} {decl}")
+            if name == "ts":
+                ts_added = True
+    if ts_added and "created_ts" in columns:
+        conn.execute("UPDATE care_events SET ts = created_ts WHERE ts = 0 OR ts IS NULL")
+    conn.execute(
+        "CREATE INDEX IF NOT EXISTS idx_care_events_subject ON care_events(subject_id, ts DESC)"
+    )
+    conn.execute(
+        "CREATE INDEX IF NOT EXISTS idx_care_events_room_bed ON care_events(room, bed, ts DESC)"
+    )
+
