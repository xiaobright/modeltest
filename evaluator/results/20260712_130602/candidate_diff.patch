+    room_lower[i] = '\0';
+    for (i = 0; i < sizeof(bed_lower) - 1 && bed[i]; ++i)
+        bed_lower[i] = (char)tolower((unsigned char)bed[i]);
+    bed_lower[i] = '\0';
+
+    snprintf(prefix, sizeof(prefix), "%s%s", room_lower, bed_lower);
+    snprintf(s_topic_tof1, sizeof(s_topic_tof1), "%stof1", prefix);
