+#define MQTT_MAX_PAYLOAD 32768
+
+static void mqtt_publish_payload(const char *topic, const uint8_t *payload, size_t len) {
+    if (!s_mqtt_connected || s_mqtt_client == NULL || topic == NULL) return;
+    if (payload == NULL || len == 0 || len > MQTT_MAX_PAYLOAD) return;
+    size_t b64_len = ((len + 2) / 3) * 4;
+    size_t json_len_needed = b64_len + 32;
+    char *b64_buf = (char *)malloc(b64_len + 1);
+    char *json_buf = (char *)malloc(json_len_needed);
+    if (!b64_buf || !json_buf) {
+        if (b64_buf) free(b64_buf);
+        if (json_buf) free(json_buf);
+        return;
+    }
+    size_t olen = 0;
+    int rc = mbedtls_base64_encode((unsigned char*)b64_buf, b64_len, &olen, payload, len);
+    if (rc != 0 || olen == 0) {
+        free(b64_buf);
+        free(json_buf);
+        return;
+    }
+    b64_buf[olen] = '\0';
+    int json_len = snprintf(json_buf, json_len_needed, "{\"payload_b64\":\"%s\"}", b64_buf);
+    if (json_len > 0 && json_len < (int)json_len_needed) {
+        esp_mqtt_client_publish(s_mqtt_client, topic, json_buf, 0, 1, 0);
+    }
+    free(b64_buf);
+    free(json_buf);
+}
+
+static void lower_copy(char *dst, size_t dst_len, const char *src) {
+    if (dst == NULL || dst_len == 0) return;
+    size_t i = 0;
+    for (; i + 1 < dst_len && src != NULL && src[i] != '\0'; ++i) {
+        dst[i] = (char)tolower((unsigned char)src[i]);
+    }
+    dst[i] = '\0';
+}
