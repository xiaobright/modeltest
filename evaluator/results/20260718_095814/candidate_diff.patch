+static const char *stream_suffix(uint8_t sensor_type, uint8_t sensor_id) {
+    if (sensor_type == SENSOR_TYPE_TOF && sensor_id == 1) return "tof1";
+    if (sensor_type == SENSOR_TYPE_TOF && sensor_id == 2) return "tof2";
+    if (sensor_type == SENSOR_TYPE_MLX && sensor_id == 1) return "mlx1";
+    if (sensor_type == SENSOR_TYPE_MLX && sensor_id == 2) return "mlx2";
+    return nullptr;
+}
+
+static void mqtt_event_handler(void *handler_args, esp_event_base_t base,
+                               int32_t event_id, void *event_data) {
+    (void)handler_args;
+    (void)base;
+    (void)event_data;
+    switch (static_cast<esp_mqtt_event_id_t>(event_id)) {
+        case MQTT_EVENT_CONNECTED:
+            s_mqtt_connected = true;
+            ESP_LOGI(TAG, "MQTT connected to %s", s_device_config.bemfa_host);
+            break;
+        case MQTT_EVENT_DISCONNECTED:
+            s_mqtt_connected = false;
+            ESP_LOGW(TAG, "MQTT disconnected; automatic reconnect remains enabled");
+            break;
+        case MQTT_EVENT_ERROR:
+            s_mqtt_connected = false;
+            ESP_LOGE(TAG, "MQTT transport error");
+            break;
+        default:
+            break;
+    }
+}
+
+static void wifi_event_handler(void *arg, esp_event_base_t event_base,
+                               int32_t event_id, void *event_data) {
+    (void)arg;
+    if (event_base == WIFI_EVENT && event_id == WIFI_EVENT_STA_START) {
+        esp_wifi_connect();
+        return;
+    }
+    if (event_base == WIFI_EVENT && event_id == WIFI_EVENT_STA_DISCONNECTED) {
+        s_wifi_connected = false;
+        s_mqtt_connected = false;
+        ESP_LOGW(TAG, "WiFi disconnected; reconnecting");
+        esp_wifi_connect();
+        return;
+    }
+    if (event_base == IP_EVENT && event_id == IP_EVENT_STA_GOT_IP) {
+        const auto *event = static_cast<const ip_event_got_ip_t *>(event_data);
+        s_wifi_connected = true;
+        ESP_LOGI(TAG, "WiFi connected, IP=" IPSTR, IP2STR(&event->ip_info.ip));
+        if (s_mqtt_client != nullptr && !s_mqtt_started) {
+            const esp_err_t err = esp_mqtt_client_start(s_mqtt_client);
+            if (err == ESP_OK) {
+                s_mqtt_started = true;
+            } else {
+                ESP_LOGE(TAG, "MQTT start failed: %s", esp_err_to_name(err));
+            }
+        }
+    }
+}
+
+static bool publish_sensor_payload(uint8_t sensor_type, uint8_t sensor_id,
+                                   const uint8_t *payload, size_t payload_len) {
+    if (!s_mqtt_connected || s_mqtt_client == nullptr || s_mqtt_publish_mutex == nullptr) {
+        return false;
+    }
+    const char *suffix = stream_suffix(sensor_type, sensor_id);
+    char topic[64] = {};
+    if (suffix == nullptr
+        || !device_config_build_topic(s_device_config, suffix, topic, sizeof(topic))) {
+        return false;
+    }
+    if (xSemaphoreTake(s_mqtt_publish_mutex, pdMS_TO_TICKS(250)) != pdTRUE) {
+        ESP_LOGW(TAG, "MQTT publish busy; drop topic=%s", topic);
+        return false;
+    }
+
+    char *json = nullptr;
+    size_t json_len = 0;
+    bool ok = mqtt_payload_build_json(payload, payload_len, &json, &json_len);
+    if (ok) {
+        const int message_id = esp_mqtt_client_publish(
+            s_mqtt_client,
+            topic,
+            json,
+            static_cast<int>(json_len),
+            0,
+            0);
+        ok = message_id >= 0;
+        if (!ok) {
+            ESP_LOGW(TAG, "MQTT publish failed topic=%s bytes=%u",
+                     topic, static_cast<unsigned>(payload_len));
+        }
+    } else {
+        ESP_LOGE(TAG, "MQTT JSON allocation/base64 failed bytes=%u",
+                 static_cast<unsigned>(payload_len));
+    }
+    mqtt_payload_free_json(json);
+    xSemaphoreGive(s_mqtt_publish_mutex);
+    return ok;
+}
+
