index 0000000..c454340
--- /dev/null
+++ b/esp32/testpro4/main/device_config.cpp
@@ -0,0 +1,189 @@
+#include "device_config.h"
+
+#include <ctype.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "nvs.h"
+
+namespace {
+
+void set_error(char *error, size_t error_len, const char *message) {
+    if (error != nullptr && error_len > 0) {
+        snprintf(error, error_len, "%s", message == nullptr ? "" : message);
+    }
+}
+
+void lower_copy(char *dst, size_t dst_len, const char *src) {
+    if (dst == nullptr || dst_len == 0) {
+        return;
+    }
+    size_t i = 0;
+    for (; i + 1 < dst_len && src != nullptr && src[i] != '\0'; ++i) {
+        dst[i] = static_cast<char>(tolower(static_cast<unsigned char>(src[i])));
+    }
+    dst[i] = '\0';
+}
+
+bool valid_topic_segment(const char *value) {
+    if (value == nullptr || value[0] == '\0') {
+        return false;
+    }
+    for (const char *p = value; *p != '\0'; ++p) {
+        if (!isalnum(static_cast<unsigned char>(*p)) && *p != '-' && *p != '_') {
+            return false;
+        }
+    }
+    return true;
+}
+
+void get_string_or_default(nvs_handle_t handle, const char *key, char *dst, size_t dst_len,
+                           const char *fallback) {
+    dst[0] = '\0';
+    size_t required = dst_len;
+    const esp_err_t err = nvs_get_str(handle, key, dst, &required);
+    if (err != ESP_OK) {
+        snprintf(dst, dst_len, "%s", fallback == nullptr ? "" : fallback);
+    }
+}
+
+}  // namespace
+
+bool device_config_is_complete(const DeviceConfig &config, char *error, size_t error_len) {
+    if (config.wifi_ssid[0] == '\0') {
+        set_error(error, error_len, "wifi_ssid is required");
+        return false;
+    }
+    if (config.wifi_password[0] == '\0') {
+        set_error(error, error_len, "wifi_pass is required");
+        return false;
+    }
+    if (config.bemfa_uid[0] == '\0') {
+        set_error(error, error_len, "bemfa_uid is required");
+        return false;
+    }
+    if (!valid_topic_segment(config.room)) {
+        set_error(error, error_len, "room is missing or contains invalid topic characters");
+        return false;
+    }
+    if (!valid_topic_segment(config.bed)) {
+        set_error(error, error_len, "bed is missing or contains invalid topic characters");
+        return false;
+    }
+    if (config.bemfa_host[0] == '\0' || config.bemfa_mqtt_port == 0) {
+        set_error(error, error_len, "bemfa host/port is invalid");
+        return false;
+    }
+    set_error(error, error_len, "");
+    return true;
+}
+
+bool device_config_load(DeviceConfig *config, char *error, size_t error_len) {
+    if (config == nullptr) {
+        set_error(error, error_len, "config pointer is null");
+        return false;
+    }
+    memset(config, 0, sizeof(*config));
+    snprintf(config->bemfa_host, sizeof(config->bemfa_host), "bemfa.com");
+    config->bemfa_mqtt_port = 9501;
+
+    nvs_handle_t handle;
+    const esp_err_t open_err = nvs_open(DEVICE_CONFIG_NAMESPACE, NVS_READONLY, &handle);
+    if (open_err == ESP_ERR_NVS_NOT_FOUND) {
+        set_error(error, error_len, "NVS project2 namespace is not configured");
+        return false;
+    }
+    if (open_err != ESP_OK) {
+        set_error(error, error_len, esp_err_to_name(open_err));
+        return false;
+    }
+
+    get_string_or_default(handle, "wifi_ssid", config->wifi_ssid, sizeof(config->wifi_ssid), "");
+    get_string_or_default(handle, "wifi_pass", config->wifi_password, sizeof(config->wifi_password), "");
+    get_string_or_default(handle, "bemfa_uid", config->bemfa_uid, sizeof(config->bemfa_uid), "");
+    get_string_or_default(handle, "bemfa_host", config->bemfa_host, sizeof(config->bemfa_host), "bemfa.com");
+    get_string_or_default(handle, "room", config->room, sizeof(config->room), "");
+    get_string_or_default(handle, "bed", config->bed, sizeof(config->bed), "");
+    get_string_or_default(handle, "device_id", config->device_id, sizeof(config->device_id), "");
+    uint16_t port = 9501;
+    if (nvs_get_u16(handle, "bemfa_port", &port) == ESP_OK) {
+        config->bemfa_mqtt_port = port;
+    }
+    nvs_close(handle);
+    return device_config_is_complete(*config, error, error_len);
+}
+
+bool device_config_build_topic(const DeviceConfig &config, const char *stream_suffix,
+                               char *topic, size_t topic_len) {
+    if (stream_suffix == nullptr || topic == nullptr || topic_len == 0
+        || !valid_topic_segment(config.room) || !valid_topic_segment(config.bed)
+        || !valid_topic_segment(stream_suffix)) {
+        return false;
+    }
+    char room[sizeof(config.room)] = {};
+    char bed[sizeof(config.bed)] = {};
+    char suffix[16] = {};
+    lower_copy(room, sizeof(room), config.room);
+    lower_copy(bed, sizeof(bed), config.bed);
+    lower_copy(suffix, sizeof(suffix), stream_suffix);
+    const int written = snprintf(topic, topic_len, "%s%s%s", room, bed, suffix);
+    return written > 0 && static_cast<size_t>(written) < topic_len;
+}
+
+esp_err_t device_config_save_value(const char *key_in, const char *value) {
+    if (key_in == nullptr || value == nullptr) {
+        return ESP_ERR_INVALID_ARG;
+    }
+    char key[32] = {};
+    lower_copy(key, sizeof(key), key_in);
+
+    nvs_handle_t handle;
+    esp_err_t err = nvs_open(DEVICE_CONFIG_NAMESPACE, NVS_READWRITE, &handle);
+    if (err != ESP_OK) {
+        return err;
+    }
+    if (strcmp(key, "ssid") == 0 || strcmp(key, "wifi_ssid") == 0) {
+        err = nvs_set_str(handle, "wifi_ssid", value);
+    } else if (strcmp(key, "password") == 0 || strcmp(key, "pass") == 0
+               || strcmp(key, "wifi_password") == 0) {
+        err = nvs_set_str(handle, "wifi_pass", value);
+    } else if (strcmp(key, "uid") == 0 || strcmp(key, "bemfa_uid") == 0) {
+        err = nvs_set_str(handle, "bemfa_uid", value);
+    } else if (strcmp(key, "host") == 0 || strcmp(key, "bemfa_host") == 0) {
+        err = nvs_set_str(handle, "bemfa_host", value);
+    } else if (strcmp(key, "port") == 0 || strcmp(key, "bemfa_port") == 0) {
+        char *end = nullptr;
+        const long port = strtol(value, &end, 10);
+        err = (end != value && *end == '\0' && port > 0 && port <= 65535)
+                  ? nvs_set_u16(handle, "bemfa_port", static_cast<uint16_t>(port))
+                  : ESP_ERR_INVALID_ARG;
+    } else if (strcmp(key, "room") == 0) {
+        err = nvs_set_str(handle, "room", value);
+    } else if (strcmp(key, "bed") == 0) {
+        err = nvs_set_str(handle, "bed", value);
+    } else if (strcmp(key, "device_id") == 0) {
+        err = nvs_set_str(handle, "device_id", value);
+    } else {
+        err = ESP_ERR_INVALID_ARG;
+    }
+    if (err == ESP_OK) {
+        err = nvs_commit(handle);
+    }
+    nvs_close(handle);
+    return err;
+}
+
+esp_err_t device_config_reset() {
+    nvs_handle_t handle;
+    esp_err_t err = nvs_open(DEVICE_CONFIG_NAMESPACE, NVS_READWRITE, &handle);
+    if (err != ESP_OK) {
+        return err;
+    }
+    err = nvs_erase_all(handle);
+    if (err == ESP_OK) {
+        err = nvs_commit(handle);
+    }
+    nvs_close(handle);
+    return err;
+}
