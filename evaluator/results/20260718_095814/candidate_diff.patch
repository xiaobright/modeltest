@@ -0,0 +1,24 @@
+#pragma once
+
+#include <stddef.h>
+#include <stdint.h>
+
+class MaixSenseFrameParser {
+public:
+    static constexpr size_t kBufferCapacity = 12000;
+    static constexpr size_t kMinDataLength = 16;
+
+    void append(const uint8_t *data, size_t len);
+    size_t extract_frame(uint8_t *frame_out, size_t frame_capacity);
+
+    uint32_t frames_parsed() const { return frames_parsed_; }
+    uint32_t dropped_bytes() const { return dropped_bytes_; }
+
+private:
+    void discard_prefix(size_t count);
+
+    uint8_t buffer_[kBufferCapacity] = {};
+    size_t buffer_len_ = 0;
+    uint32_t frames_parsed_ = 0;
+    uint32_t dropped_bytes_ = 0;
+};
diff --git a/esp32/testpro4/main/mqtt_payload.cpp b/esp32/testpro4/main/mqtt_payload.cpp
new file mode 100644
index 0000000..afd91a2
--- /dev/null
+++ b/esp32/testpro4/main/mqtt_payload.cpp
@@ -0,0 +1,57 @@
+#include "mqtt_payload.h"
+
+#include <stdlib.h>
+#include <string.h>
+
+#include "esp_heap_caps.h"
+#include "mbedtls/base64.h"
+
+namespace {
+constexpr char kJsonPrefix[] = "{\"payload_b64\":\"";
+constexpr char kJsonSuffix[] = "\"}";
+}
+
+bool mqtt_payload_build_json(const uint8_t *payload, size_t payload_len,
+                             char **json_out, size_t *json_len_out) {
+    if (payload == nullptr || payload_len == 0 || json_out == nullptr || json_len_out == nullptr) {
+        return false;
+    }
+    *json_out = nullptr;
+    *json_len_out = 0;
+
+    const size_t encoded_capacity = 4U * ((payload_len + 2U) / 3U);
+    const size_t json_capacity =
+        (sizeof(kJsonPrefix) - 1U) + encoded_capacity + (sizeof(kJsonSuffix) - 1U) + 1U;
+    char *json = static_cast<char *>(
+        heap_caps_malloc(json_capacity, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT));
+    if (json == nullptr) {
+        json = static_cast<char *>(malloc(json_capacity));
+    }
+    if (json == nullptr) {
+        return false;
+    }
+
+    const size_t prefix_len = sizeof(kJsonPrefix) - 1U;
+    memcpy(json, kJsonPrefix, prefix_len);
+    size_t encoded_len = 0;
+    const int rc = mbedtls_base64_encode(
+        reinterpret_cast<unsigned char *>(json + prefix_len),
+        encoded_capacity + 1U,
+        &encoded_len,
+        payload,
+        payload_len);
+    if (rc != 0) {
+        free(json);
+        return false;
+    }
+    memcpy(json + prefix_len + encoded_len, kJsonSuffix, sizeof(kJsonSuffix) - 1U);
+    const size_t json_len = prefix_len + encoded_len + (sizeof(kJsonSuffix) - 1U);
+    json[json_len] = '\0';
+    *json_out = json;
+    *json_len_out = json_len;
+    return true;
+}
+
+void mqtt_payload_free_json(char *json) {
+    free(json);
+}
