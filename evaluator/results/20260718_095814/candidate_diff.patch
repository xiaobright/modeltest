diff --git a/esp32/testpro4/main/protocol_packet.cpp b/esp32/testpro4/main/protocol_packet.cpp
new file mode 100644
index 0000000..cab6ef9
--- /dev/null
+++ b/esp32/testpro4/main/protocol_packet.cpp
@@ -0,0 +1,23 @@
+#include "protocol_packet.h"
+
+uint16_t protocol_crc16_ccitt(const uint8_t *data, size_t len) {
+    uint16_t crc = 0xFFFF;
+    for (size_t i = 0; i < len; ++i) {
+        crc ^= static_cast<uint16_t>(data[i]) << 8;
+        for (int bit = 0; bit < 8; ++bit) {
+            crc = (crc & 0x8000) ? static_cast<uint16_t>((crc << 1) ^ 0x1021)
+                                 : static_cast<uint16_t>(crc << 1);
+        }
+    }
+    return crc;
+}
+
+void protocol_build_header(uint8_t sensor_type, uint8_t sensor_id, uint16_t payload_len,
+                           uint8_t out_header[PROTOCOL_HEADER_SIZE]) {
+    out_header[0] = PACKET_SYNC1;
+    out_header[1] = PACKET_SYNC2;
+    out_header[2] = sensor_type;
+    out_header[3] = sensor_id;
+    out_header[4] = static_cast<uint8_t>(payload_len & 0xFF);
+    out_header[5] = static_cast<uint8_t>((payload_len >> 8) & 0xFF);
+}
