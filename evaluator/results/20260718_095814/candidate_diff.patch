diff --git a/esp32/testpro4/main/maixsense_parser.cpp b/esp32/testpro4/main/maixsense_parser.cpp
new file mode 100644
index 0000000..96359ab
--- /dev/null
+++ b/esp32/testpro4/main/maixsense_parser.cpp
@@ -0,0 +1,89 @@
+#include "maixsense_parser.h"
+
+#include <string.h>
+
+void MaixSenseFrameParser::discard_prefix(size_t count) {
+    if (count >= buffer_len_) {
+        dropped_bytes_ += static_cast<uint32_t>(buffer_len_);
+        buffer_len_ = 0;
+        return;
+    }
+    memmove(buffer_, buffer_ + count, buffer_len_ - count);
+    buffer_len_ -= count;
+    dropped_bytes_ += static_cast<uint32_t>(count);
+}
+
+void MaixSenseFrameParser::append(const uint8_t *data, size_t len) {
+    if (data == nullptr || len == 0) {
+        return;
+    }
+    if (len >= kBufferCapacity) {
+        data += len - kBufferCapacity;
+        dropped_bytes_ += static_cast<uint32_t>(buffer_len_ + len - kBufferCapacity);
+        memcpy(buffer_, data, kBufferCapacity);
+        buffer_len_ = kBufferCapacity;
+        return;
+    }
+    const size_t required = buffer_len_ + len;
+    if (required > kBufferCapacity) {
+        discard_prefix(required - kBufferCapacity);
+    }
+    memcpy(buffer_ + buffer_len_, data, len);
+    buffer_len_ += len;
+}
+
+size_t MaixSenseFrameParser::extract_frame(uint8_t *frame_out, size_t frame_capacity) {
+    if (frame_out == nullptr || frame_capacity == 0) {
+        return 0;
+    }
+
+    while (buffer_len_ >= 2) {
+        size_t header_index = 0;
+        while (header_index + 1 < buffer_len_
+               && !(buffer_[header_index] == 0x00 && buffer_[header_index + 1] == 0xFF)) {
+            ++header_index;
+        }
+        if (header_index + 1 >= buffer_len_) {
+            const bool keep_zero = buffer_[buffer_len_ - 1] == 0x00;
+            const uint8_t trailing = buffer_[buffer_len_ - 1];
+            dropped_bytes_ += static_cast<uint32_t>(buffer_len_ - (keep_zero ? 1 : 0));
+            buffer_len_ = keep_zero ? 1 : 0;
+            if (keep_zero) {
+                buffer_[0] = trailing;
+            }
+            return 0;
+        }
+        if (header_index > 0) {
+            discard_prefix(header_index);
+        }
+        if (buffer_len_ < 4) {
+            return 0;
+        }
+
+        const uint16_t data_len =
+            static_cast<uint16_t>(buffer_[2])
+            | (static_cast<uint16_t>(buffer_[3]) << 8);
+        const size_t frame_len = 4U + static_cast<size_t>(data_len) + 2U;
+        if (data_len < kMinDataLength || frame_len > kBufferCapacity || frame_len > frame_capacity) {
+            discard_prefix(1);
+            continue;
+        }
+        if (buffer_len_ < frame_len) {
+            return 0;
+        }
+        if (buffer_[frame_len - 1] != 0xDD) {
+            discard_prefix(1);
+            continue;
+        }
+
+        memcpy(frame_out, buffer_, frame_len);
+        const size_t remaining = buffer_len_ - frame_len;
+        if (remaining > 0) {
+            memmove(buffer_, buffer_ + frame_len, remaining);
+        }
+        buffer_len_ = remaining;
+        ++frames_parsed_;
+        return frame_len;
+    }
+    return 0;
+}
