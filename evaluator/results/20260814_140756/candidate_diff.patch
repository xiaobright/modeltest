-static char *trim_in_place(char *s) {
-    if (s == NULL) return s;
-    while (*s && isspace((unsigned char)*s)) s++;
-    char *end = s + strlen(s);
-    while (end > s && isspace((unsigned char)*(end - 1))) {
-        *(--end) = '\0';
-    }
-    return s;
-}
