+def fetch_current_session() -> Optional[str]:
+    """从 gateway 获取当前视觉会话的 session_id。
+
+    上下文鉴权收紧后，本地助手应显式携带会话凭证请求敏感上下文；
+    拿不到会话时返回 None，由网关按未认证拒绝，不静默泄露患者数据。
