+"""Care event tracking for nursing actions.
+
+护理事件模块：建表与旧表迁移、CRUD、room/bed 规范化，以及 v3 授权
+上下文中的最近事件摘要。授权判定由 gateway 的 session 上下文层负责，
+本模块只处理数据与查询。
+"""
+from db import db_connect, row_to_dict
+from utils import as_int, make_id, normalize_bed, normalize_room, now_ms
+
+# 旧版本 care_events 表可能缺失这些列，初始化时按此声明补齐并保留旧行。
+_MISSING_COLUMN_DDL = {
+    "severity": "TEXT NOT NULL DEFAULT 'info'",
+    "source": "TEXT NOT NULL DEFAULT 'manual'",
+    "created_by": "TEXT NOT NULL DEFAULT ''",
+    "ts": "INTEGER NOT NULL DEFAULT 0",
+}
+
+_CREATE_TABLE_SQL = """
+CREATE TABLE IF NOT EXISTS care_events (
+    event_id TEXT PRIMARY KEY,
+    subject_id TEXT NOT NULL,
+    room TEXT NOT NULL,
+    bed TEXT NOT NULL,
+    kind TEXT NOT NULL,
+    title TEXT NOT NULL DEFAULT '',
+    content TEXT NOT NULL DEFAULT '',
+    severity TEXT NOT NULL DEFAULT 'info',
+    source TEXT NOT NULL DEFAULT 'manual',
+    created_by TEXT NOT NULL DEFAULT '',
+    ts INTEGER NOT NULL DEFAULT 0,
+    created_ts INTEGER NOT NULL,
+    updated_ts INTEGER NOT NULL
+);
+"""
+
+_INDEX_SQL = [
+    "CREATE INDEX IF NOT EXISTS idx_care_events_subject ON care_events(subject_id, ts DESC, created_ts DESC);",
+    "CREATE INDEX IF NOT EXISTS idx_care_events_room_bed ON care_events(room, bed, ts DESC, created_ts DESC);",
+]
+
+
+def init_care_events_table():
+    """创建 care_events 表并迁移旧表缺失列，保留旧数据。"""
+    with db_connect() as conn:
+        conn.executescript(_CREATE_TABLE_SQL)
+        columns = {row["name"] for row in conn.execute("PRAGMA table_info(care_events)").fetchall()}
+        for name, declaration in _MISSING_COLUMN_DDL.items():
+            if name not in columns:
+                conn.execute(f"ALTER TABLE care_events ADD COLUMN {name} {declaration}")
+        # 旧行回填：ts 取自 created_ts，避免旧事件被排到时间线最前面。
+        conn.execute(
+            "UPDATE care_events SET ts = created_ts WHERE ts IS NULL OR ts <= 0"
+        )
+        conn.execute(
+            "UPDATE care_events SET severity = 'info' WHERE severity IS NULL OR severity = ''"
+        )
+        conn.execute(
+            "UPDATE care_events SET source = 'manual' WHERE source IS NULL OR source = ''"
+        )
+        for sql in _INDEX_SQL:
+            conn.execute(sql)
+
+
+def _validate_event_row(row: dict) -> dict:
+    if not isinstance(row, dict):
+        raise ValueError("payload must be object")
+    subject_id = str(row.get("subject_id") or "").strip()
+    room = normalize_room(row.get("room"))
+    bed = normalize_bed(row.get("bed"))
+    kind = str(row.get("kind") or "note").strip()
+    if not subject_id:
+        raise ValueError("subject_id is required")
+    if not room or not bed:
+        raise ValueError("room and bed are required")
+    if not kind:
+        kind = "note"
+    ts = as_int(row.get("ts"), 0)
+    if ts <= 0:
+        ts = now_ms()
+    return {
+        "event_id": str(row.get("event_id") or make_id("care")),
+        "subject_id": subject_id,
+        "room": room,
+        "bed": bed,
+        "kind": kind,
+        "title": str(row.get("title") or ""),
+        "content": str(row.get("content") or ""),
+        "severity": str(row.get("severity") or "info"),
+        "source": str(row.get("source") or "manual"),
+        "created_by": str(row.get("created_by") or ""),
+        "ts": ts,
+    }
+
+
+def create_care_event(row: dict) -> dict:
+    """Create a new care event record.
+
+    room/bed 按 gateway 约定统一大写规范化存储；小写入参 r1203/b1 与
+    大写查询 R1203/B1 互相命中。授权判定在 HTTP 路由层完成。
+    """
+    data = _validate_event_row(row)
+    ts = now_ms()
+    with db_connect() as conn:
+        conn.execute(
+            """
+            INSERT INTO care_events
+                (event_id, subject_id, room, bed, kind, title, content,
+                 severity, source, created_by, ts, created_ts, updated_ts)
+            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
+            """,
+            (
+                data["event_id"], data["subject_id"], data["room"], data["bed"],
+                data["kind"], data["title"], data["content"], data["severity"],
+                data["source"], data["created_by"], data["ts"], ts, ts,
+            ),
+        )
+    return dict(data, ok=True)
+
+
+def list_care_events(
+    subject_id: str = "",
+    room: str = "",
+    bed: str = "",
+    limit: int = 0,
+) -> list[dict]:
+    """List care events, filtered by subject or bed, newest first.
+
+    limit=0 表示不限制；limit>0 时只返回最近 limit 条。
+    """
+    sql = "SELECT * FROM care_events WHERE 1=1"
+    args = []
+    if subject_id:
+        sql += " AND subject_id = ?"
+        args.append(str(subject_id).strip())
+    if room:
+        sql += " AND room = ?"
+        args.append(normalize_room(room))
+    if bed:
+        sql += " AND bed = ?"
+        args.append(normalize_bed(bed))
+    sql += " ORDER BY ts DESC, created_ts DESC"
+    limit = as_int(limit, 0)
+    if limit and limit > 0:
+        sql += " LIMIT ?"
+        args.append(limit)
+    with db_connect() as conn:
+        rows = conn.execute(sql, args).fetchall()
+    return [row_to_dict(r) for r in rows]
+
+
+def build_care_events_context(subject_id: str, limit: int = 10) -> dict:
+    """Build the care-events section for the v3 chat context.
+
+    只返回事件摘要（kind/title/content/ts/room/bed），供授权上下文注入；
+    未授权路径不应调用本函数。
+    """
+    items = []
+    rows = list_care_events(subject_id=subject_id, limit=max(1, min(as_int(limit, 10), 50))) if subject_id else []
+    for row in rows:
+        items.append({
+            "event_id": row.get("event_id", ""),
+            "kind": row.get("kind", ""),
+            "title": row.get("title", ""),
+            "content": row.get("content", ""),
+            "severity": row.get("severity", "info"),
+            "room": row.get("room", ""),
+            "bed": row.get("bed", ""),
+            "ts": as_int(row.get("ts"), as_int(row.get("created_ts"), 0)),
+        })
+    brief = "；".join(
+        f"{str(x.get('title') or '').strip()}（{str(x.get('content') or '').strip()}）"
+        for x in items
+        if str(x.get("title") or "").strip() or str(x.get("content") or "").strip()
+    ).strip()
+    return {"items": items, "brief": brief}
