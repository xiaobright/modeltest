+// =====================
+// 串口配置控制台（CFG? / CFGSET key=value / CFGRESET / REBOOT）
+// =====================
+static char *trim_in_place(char *s) {
+    if (s == NULL) return s;
+    while (*s && isspace((unsigned char)*s)) s++;
+    char *end = s + strlen(s);
+    while (end > s && isspace((unsigned char)*(end - 1))) {
+        *(--end) = '\0';
+    }
+    return s;
+}
+
+static void process_config_line(char *line) {
+    char *cmd = trim_in_place(line);
+    if (cmd[0] == '\0') return;
+
+    if (strcmp(cmd, "HELP") == 0 || strcmp(cmd, "CFGHELP") == 0) {
+        device_config_print_help();
+        return;
+    }
+    if (strcmp(cmd, "CFG?") == 0) {
+        device_config_print();
+        return;
+    }
+    if (strcmp(cmd, "CFGRESET") == 0) {
+        device_config_reset();
+        ESP_LOGW(TAG, "Config cleared. Send REBOOT to restart.");
+        return;
+    }
+    if (strcmp(cmd, "REBOOT") == 0) {
+        ESP_LOGW(TAG, "Rebooting...");
+        vTaskDelay(pdMS_TO_TICKS(200));
+        esp_restart();
+        return;
+    }
+    if (strncmp(cmd, "CFGSET ", 7) == 0) {
+        char *pair = trim_in_place(cmd + 7);
+        char *eq = strchr(pair, '=');
+        if (eq == NULL || eq == pair) {
+            ESP_LOGW(TAG, "Invalid CFGSET. Use CFGSET key=value");
+            return;
+        }
+        *eq = '\0';
+        char *key = trim_in_place(pair);
+        char *value = trim_in_place(eq + 1);
+        bool ok = device_config_set(key, value);
+        ESP_LOGI(TAG, "%s", ok ? "Config saved. Send REBOOT to apply network config."
+                                : "Config save failed or unknown key.");
+        device_config_print();
+        return;
+    }
+
+    ESP_LOGW(TAG, "Unknown command. Send CFGHELP for help.");
+}
