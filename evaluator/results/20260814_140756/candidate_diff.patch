+// ==========================================================
+// 任务 1: ToF 传感器数据回传 (单任务处理 UART1/2，共用 CDC 1)
+// USB CDC 与 MQTT 巴法云并行回传
+// ==========================================================
+struct TofStreamParams {
+    uart_port_t uart_num; // 物理串口编号
+    uint8_t src_id;       // ToF 数据来源 ID
+};
+
+static const TofStreamParams s_tof_params[] = {
+    { .uart_num = UART1_PORT, .src_id = 1 },
+    { .uart_num = UART2_PORT, .src_id = 2 },
+};
+
+static void usb_send_tof_payload(uint8_t src_id, const uint8_t *payload, uint16_t len) {
+    bool usb_connected = false;
+    if (usb_lock(pdMS_TO_TICKS(2))) {
+        usb_connected = tud_cdc_n_connected(1);
+        if (usb_connected) {
+            // 统一包头格式: [0xAA, 0x55, SENSOR_TYPE, SENSOR_ID, LEN_LOW, LEN_HIGH]
+            uint8_t header[PACKET_HEADER_LEN];
+            packet_build_header(header, SENSOR_TYPE_TOF, src_id, len);
+            tud_cdc_n_write(1, header, sizeof(header));
+            tud_cdc_n_write_flush(1);
+        }
+        usb_unlock();
+    }
+
+    if (usb_connected) {
+        uint32_t sent = 0;
+        while (sent < len) {
+            if (!usb_lock(pdMS_TO_TICKS(2))) {
+                vTaskDelay(1);
+                continue;
+            }
+            int avail = tud_cdc_n_write_available(1);
+            if (avail > 0) {
+                int chunk = (len - sent) > (uint32_t)avail ? avail : (int)(len - sent);
+                int written = tud_cdc_n_write(1, payload + sent, chunk);
+                sent += written;
+                tud_cdc_n_write_flush(1);
+            }
+            usb_unlock();
+            vTaskDelay(1);
+        }
+
+        // 发送 CRC 校验（小端，只覆盖 payload）
+        uint8_t crc_bytes[PACKET_CRC_LEN];
+        packet_build_crc(payload, len, crc_bytes);
+        if (usb_lock(pdMS_TO_TICKS(2))) {
+            tud_cdc_n_write(1, crc_bytes, sizeof(crc_bytes));
+            tud_cdc_n_write_flush(1);
+            usb_unlock();
+        }
+    }
+
+    // 并行 MQTT 回传：发布原始 payload（不是 USB packet）到 {room}{bed}tofN
+    mqtt_publish_raw_payload(src_id == 1 ? "tof1" : "tof2", payload, len);
+}
+
+void tof_stream_task(void *pvParameters) {
+    (void)pvParameters;
+
+    // 为每个传感器分配帧解析器（处理噪声/分块/坏尾/异常长度/半帧）
+    static maixsense_parser_t parser1;
+    static maixsense_parser_t parser2;
+    maixsense_parser_init(&parser1);
+    maixsense_parser_init(&parser2);
+
+    // 为每个传感器分配独立的帧缓冲区（交替发送）
+    static uint8_t frame_buffer1[MAIXSENSE_FRAME_MAX_LEN];
+    static uint8_t frame_buffer2[MAIXSENSE_FRAME_MAX_LEN];
+    static bool frame1_ready = false;
+    static bool frame2_ready = false;
+    static uint16_t frame1_len = 0;
+    static uint16_t frame2_len = 0;
+
+    uint8_t uart_buf[512]; // UART 读取缓冲区
+
+    // 调试计数器
+    static uint32_t uart1_total_bytes = 0;
+    static uint32_t uart2_total_bytes = 0;
+    static uint32_t sent_frames = 0;
+    static uint32_t last_debug_time = 0;
+
+    // 交替发送状态：true=下次发送传感器1, false=下次发送传感器2
+    static bool send_sensor1_next = true;
+
+    ESP_LOGI(TAG, "Starting ToF Stream Task with Alternating Frame Sending");
+
+    while (1) {
+        bool did_work = false;
+        // ===== 阶段1：接收并解析数据 =====
+
+        // 处理UART1（允许覆盖旧帧，保留最新帧）
+        size_t buffered_len = 0;
+        uart_get_buffered_data_len(UART1_PORT, &buffered_len);
+        if (buffered_len > 0) {
+            int len = uart_read_bytes(UART1_PORT, uart_buf,
+                                      (buffered_len > sizeof(uart_buf)) ? sizeof(uart_buf) : buffered_len,
+                                      pdMS_TO_TICKS(2));
+            if (len > 0) {
+                uart1_total_bytes += len;
+                did_work = true;
+
+                maixsense_parser_feed(&parser1, uart_buf, (size_t)len);
+
+                // 尝试解析完整帧（覆盖旧帧）
+                uint32_t parsed_len = maixsense_parser_next_frame(&parser1, frame_buffer1,
+                                                                  sizeof(frame_buffer1));
+                if (parsed_len > 0) {
+                    frame1_ready = true;
+                    frame1_len = (uint16_t)parsed_len;
+                }
+            }
+        }
+
+        // 处理UART2（允许覆盖旧帧，保留最新帧）
+        buffered_len = 0;
+        uart_get_buffered_data_len(UART2_PORT, &buffered_len);
+        if (buffered_len > 0) {
+            int len = uart_read_bytes(UART2_PORT, uart_buf,
+                                      (buffered_len > sizeof(uart_buf)) ? sizeof(uart_buf) : buffered_len,
+                                      pdMS_TO_TICKS(2));
+            if (len > 0) {
+                uart2_total_bytes += len;
+                did_work = true;
+
+                maixsense_parser_feed(&parser2, uart_buf, (size_t)len);
+
+                // 尝试解析完整帧（覆盖旧帧）
+                uint32_t parsed_len = maixsense_parser_next_frame(&parser2, frame_buffer2,
+                                                                  sizeof(frame_buffer2));
+                if (parsed_len > 0) {
+                    frame2_ready = true;
+                    frame2_len = (uint16_t)parsed_len;
+                }
+            }
+        }
+
+        // ===== 阶段2：交替发送帧 =====
+
+        if (send_sensor1_next && frame1_ready) {
+            usb_send_tof_payload(1, frame_buffer1, frame1_len);
+            frame1_ready = false;
+            send_sensor1_next = false;  // 下次发送传感器2
+            sent_frames++;
+            did_work = true;
+        } else if (!send_sensor1_next && frame2_ready) {
+            usb_send_tof_payload(2, frame_buffer2, frame2_len);
+            frame2_ready = false;
+            send_sensor1_next = true;   // 下次发送传感器1
+            sent_frames++;
+            did_work = true;
+        } else if (send_sensor1_next && !frame1_ready && frame2_ready) {
+            vTaskDelay(pdMS_TO_TICKS(1));  // 等待传感器1的帧，暂不发送传感器2
+        } else if (!send_sensor1_next && !frame2_ready && frame1_ready) {
+            vTaskDelay(pdMS_TO_TICKS(1));  // 等待传感器2的帧，暂不发送传感器1
+        }
+
+        // 每30秒打印状态统计
+        uint32_t now = xTaskGetTickCount();
+        if (now - last_debug_time > pdMS_TO_TICKS(30000)) {
+            ESP_LOGI(TAG, "ToF Status: Sensor1=%lu frames, Sensor2=%lu frames, Sent=%lu frames, MQTT=%s",
+                     (unsigned long)parser1.frames_parsed,
+                     (unsigned long)parser2.frames_parsed,
+                     (unsigned long)sent_frames,
+                     network_backhaul_mqtt_connected() ? "connected" : "down");
+            last_debug_time = now;
+        }
+
+        if (did_work) {
+            vTaskDelay(pdMS_TO_TICKS(1));
+        } else {
+            vTaskDelay(pdMS_TO_TICKS(5));
+        }
+    }
+}
