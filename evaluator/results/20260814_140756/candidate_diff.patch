+// ==========================================================
+// 任务 2: MLX90640 数据发送
+// 负责从 MLXManager 获取计算好的温度，发给 CDC 0 + MQTT mlx1/mlx2
+// ==========================================================
+void mlx_sender_task(void *pvParameters) {
+    MLXManager *mlx = (MLXManager *)pvParameters;
+
+    // 分配大缓冲区用于存放浮点数据
+    // 768 float * 4 bytes = 3072 bytes
+    static float temp_buf1[768];
+    static float temp_buf2[768];
+
+    ESP_LOGI(TAG, "Starting MLX Sender Task on CDC 0");
+
+    while (1) {
+        // 1. 获取最新数据 (线程安全复制)
+        mlx->get_temperature_data(temp_buf1, temp_buf2);
+        const uint32_t total = sizeof(temp_buf1);
+
+        // 2. 检查 USB 连接状态
+        bool cdc0_connected = false;
+        if (usb_lock(pdMS_TO_TICKS(2))) {
+            cdc0_connected = tud_cdc_n_connected(0);
+            usb_unlock();
+        }
+        if (cdc0_connected) {
+            // --- 发送传感器 1 数据 ---
+            // 发送统一包头: [0xAA, 0x55, TYPE, ID, LEN_LOW, LEN_HIGH]
+            if (usb_lock(pdMS_TO_TICKS(2))) {
+                uint8_t header1[PACKET_HEADER_LEN];
+                packet_build_header(header1, SENSOR_TYPE_MLX, 0x01, (uint16_t)total);
+                tud_cdc_n_write(0, header1, sizeof(header1));
+                tud_cdc_n_write_flush(0);
+                usb_unlock();
+            }
+
+            // 发送 3072 字节的 Body（分块发送，等待 TinyUSB FIFO 取走）
+            uint32_t sent = 0;
+            uint8_t *p = (uint8_t*)temp_buf1;
+            while (sent < total) {
+                if (usb_lock(pdMS_TO_TICKS(2))) {
+                    int avail = tud_cdc_n_write_available(0);
+                    if (avail > 0) {
+                        int chunk = (total - sent) > avail ? avail : (total - sent);
+                        int written = tud_cdc_n_write(0, p + sent, chunk);
+                        sent += written;
+                        tud_cdc_n_write_flush(0);
+                    }
+                    usb_unlock();
+                }
+                vTaskDelay(1); // 等待 USB 主机取走数据
+            }
+
+            // 发送CRC校验（小端，只覆盖 payload）
+            uint8_t crc_bytes1[PACKET_CRC_LEN];
+            packet_build_crc((uint8_t*)temp_buf1, total, crc_bytes1);
+            if (usb_lock(pdMS_TO_TICKS(2))) {
+                tud_cdc_n_write(0, crc_bytes1, sizeof(crc_bytes1));
+                tud_cdc_n_write_flush(0);
+                usb_unlock();
+            }
+
+            // --- 发送传感器 2 数据 ---
+            if (usb_lock(pdMS_TO_TICKS(2))) {
+                uint8_t header2[PACKET_HEADER_LEN];
+                packet_build_header(header2, SENSOR_TYPE_MLX, 0x02, (uint16_t)total);
+                tud_cdc_n_write(0, header2, sizeof(header2));
+                tud_cdc_n_write_flush(0);
+                usb_unlock();
+            }
+
+            sent = 0;
+            p = (uint8_t*)temp_buf2;
+            while (sent < total) {
+                if (usb_lock(pdMS_TO_TICKS(2))) {
+                    int avail = tud_cdc_n_write_available(0);
+                    if (avail > 0) {
+                        int chunk = (total - sent) > avail ? avail : (total - sent);
+                        int written = tud_cdc_n_write(0, p + sent, chunk);
+                        sent += written;
+                        tud_cdc_n_write_flush(0);
+                    }
+                    usb_unlock();
+                }
+                vTaskDelay(1);
+            }
+
+            // 发送CRC校验
+            uint8_t crc_bytes2[PACKET_CRC_LEN];
+            packet_build_crc((uint8_t*)temp_buf2, total, crc_bytes2);
+            if (usb_lock(pdMS_TO_TICKS(2))) {
+                tud_cdc_n_write(0, crc_bytes2, sizeof(crc_bytes2));
+                tud_cdc_n_write_flush(0);
+                usb_unlock();
+            }
+        }
+
+        // 并行 MQTT 回传：发布原始 float32 payload 到 {room}{bed}mlx1/mlx2
+        mqtt_publish_raw_payload("mlx1", (const uint8_t *)temp_buf1, total);
+        mqtt_publish_raw_payload("mlx2", (const uint8_t *)temp_buf2, total);
+
+        // 控制刷新率，例如 4Hz (250ms)，跟 MLXManager 内部的 FPS 匹配即可
+        vTaskDelay(pdMS_TO_TICKS(250));
+    }
+}
