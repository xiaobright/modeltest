+static esp_mqtt_client_handle_t s_mqtt_client = NULL;
+
+static void mqtt_event_handler(void *handler_args, esp_event_base_t base, int32_t event_id, void *event_data) {
+    switch ((esp_mqtt_event_id_t)event_id) {
+        case MQTT_EVENT_CONNECTED:
+            s_mqtt_connected = true;
+            ESP_LOGI("MQTT", "MQTT Connected");
+            break;
+        case MQTT_EVENT_DISCONNECTED:
+            s_mqtt_connected = false;
+            ESP_LOGI("MQTT", "MQTT Disconnected");
+            break;
+        default:
+            break;
+    }
+}
+
+static void wifi_event_handler(void* arg, esp_event_base_t event_base, int32_t event_id, void* event_data) {
+    if (event_base == WIFI_EVENT && event_id == WIFI_EVENT_STA_START) {
+        esp_wifi_connect();
+    } else if (event_base == WIFI_EVENT && event_id == WIFI_EVENT_STA_DISCONNECTED) {
+        esp_wifi_connect();
+    } else if (event_base == IP_EVENT && event_id == IP_EVENT_STA_GOT_IP) {
+        ESP_LOGI("WIFI", "Got IP");
+    }
+}
+
+static void start_network_backhaul() {
+    if (s_device_config.wifi_ssid[0] == '\0') {
+        ESP_LOGW("NET", "No WiFi SSID configured, skipping network backhaul");
+        return;
+    }
+    
+    esp_netif_init();
+    esp_event_loop_create_default();
+    esp_netif_create_default_wifi_sta();
+    wifi_init_config_t cfg = WIFI_INIT_CONFIG_DEFAULT();
+    esp_wifi_init(&cfg);
+    
+    esp_event_handler_instance_register(WIFI_EVENT, ESP_EVENT_ANY_ID, &wifi_event_handler, NULL, NULL);
+    esp_event_handler_instance_register(IP_EVENT, IP_EVENT_STA_GOT_IP, &wifi_event_handler, NULL, NULL);
+    
+    wifi_config_t wifi_config = {};
+    strncpy((char*)wifi_config.sta.ssid, s_device_config.wifi_ssid, 32);
+    strncpy((char*)wifi_config.sta.password, s_device_config.wifi_password, 64);
+    
+    esp_wifi_set_mode(WIFI_MODE_STA);
+    esp_wifi_set_config(WIFI_IF_STA, &wifi_config);
+    esp_wifi_start();
+
+    if (s_device_config.bemfa_uid[0] != '\0') {
+        char uri[128];
+        snprintf(uri, sizeof(uri), "mqtt://%s:%u", s_device_config.bemfa_host, s_device_config.bemfa_mqtt_port);
+        esp_mqtt_client_config_t mqtt_cfg = {};
+        mqtt_cfg.broker.address.uri = uri;
+        mqtt_cfg.credentials.client_id = s_device_config.bemfa_uid;
+        s_mqtt_client = esp_mqtt_client_init(&mqtt_cfg);
+        esp_mqtt_client_register_event(s_mqtt_client, MQTT_EVENT_ANY, mqtt_event_handler, NULL);
+        esp_mqtt_client_start(s_mqtt_client);
+    }
+}
+
+static void publish_mqtt_payload(const char* suffix, const uint8_t* payload, size_t len) {
+    if (!s_mqtt_connected || !s_mqtt_client) return;
+    
+    char topic[128];
+    char room_lower[32] = {0};
+    char bed_lower[32] = {0};
+    strncpy(room_lower, s_device_config.room, 31);
+    strncpy(bed_lower, s_device_config.bed, 31);
+    for(int i=0; room_lower[i]; i++) room_lower[i] = tolower((unsigned char)room_lower[i]);
+    for(int i=0; bed_lower[i]; i++) bed_lower[i] = tolower((unsigned char)bed_lower[i]);
+    snprintf(topic, sizeof(topic), "%s%s%s", room_lower, bed_lower, suffix);
+
+    size_t out_len = 0;
+    mbedtls_base64_encode(NULL, 0, &out_len, payload, len);
+    char* b64_buf = (char*)malloc(out_len + 1);
+    if (!b64_buf) return;
+    mbedtls_base64_encode((unsigned char*)b64_buf, out_len, &out_len, payload, len);
+    b64_buf[out_len] = '\0';
+
+    cJSON *root = cJSON_CreateObject();
+    cJSON_AddStringToObject(root, "payload_b64", b64_buf);
+    char *json_str = cJSON_PrintUnformatted(root);
+    
+    esp_mqtt_client_publish(s_mqtt_client, topic, json_str, 0, 0, 0);
+    
+    cJSON_Delete(root);
+    free(json_str);
+    free(b64_buf);
+}
