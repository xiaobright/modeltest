+def migrate_care_events_schema(conn):
+    """Migrate a legacy care_events table that is missing newer columns.
+
+    Older databases may already have a care_events table with only
+    event_id/subject_id/room/bed/kind/title/content/created_ts/updated_ts.
+    ALTER TABLE ADD COLUMN adds the missing columns without dropping any
+    existing rows; ts is backfilled from created_ts so ordering still works.
+    """
+    cols = {str(row["name"]) for row in conn.execute("PRAGMA table_info(care_events)").fetchall()}
+    added = []
+    if "severity" not in cols:
+        conn.execute("ALTER TABLE care_events ADD COLUMN severity TEXT NOT NULL DEFAULT 'info'")
+        added.append("severity")
+    if "source" not in cols:
+        conn.execute("ALTER TABLE care_events ADD COLUMN source TEXT NOT NULL DEFAULT 'manual'")
+        added.append("source")
+    if "created_by" not in cols:
+        conn.execute("ALTER TABLE care_events ADD COLUMN created_by TEXT NOT NULL DEFAULT ''")
+        added.append("created_by")
+    if "ts" not in cols:
+        conn.execute("ALTER TABLE care_events ADD COLUMN ts INTEGER NOT NULL DEFAULT 0")
+        conn.execute("UPDATE care_events SET ts = created_ts WHERE ts = 0 OR ts IS NULL")
+        added.append("ts")
+    if added:
+        print(f'[DB] migrated care_events: added columns {", ".join(added)} (existing rows preserved)')
+
+
+def ensure_care_events_schema(conn=None):
+    """Create/migrate the care_events table outside full init.
+
+    Reusable by gateway/care_events.py so the CRUD module stays the single
+    owner of care-event business logic while the schema lives in db.py.
+    """
+    owns = conn is None
+    if owns:
+        conn = db_connect()
+    try:
+        conn.executescript(
+            """
+            CREATE TABLE IF NOT EXISTS care_events (
+                event_id TEXT PRIMARY KEY,
+                subject_id TEXT NOT NULL,
+                room TEXT NOT NULL,
+                bed TEXT NOT NULL,
+                kind TEXT NOT NULL,
+                title TEXT NOT NULL DEFAULT '',
+                content TEXT NOT NULL DEFAULT '',
+                severity TEXT NOT NULL DEFAULT 'info',
+                source TEXT NOT NULL DEFAULT 'manual',
+                created_by TEXT NOT NULL DEFAULT '',
+                ts INTEGER NOT NULL DEFAULT 0,
+                created_ts INTEGER NOT NULL,
+                updated_ts INTEGER NOT NULL
+            );
+            CREATE INDEX IF NOT EXISTS idx_care_events_subject
+                ON care_events(subject_id, created_ts DESC);
+            CREATE INDEX IF NOT EXISTS idx_care_events_room_bed
+                ON care_events(room, bed, created_ts DESC);
+            """
+        )
+        migrate_care_events_schema(conn)
+    finally:
+        if owns:
+            conn.close()
+
