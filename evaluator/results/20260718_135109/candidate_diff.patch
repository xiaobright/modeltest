+static void build_mqtt_topics(void) {
+    char room[sizeof(s_device_config.room)] = {};
+    char bed[sizeof(s_device_config.bed)] = {};
+    lower_copy(room, sizeof(room), s_device_config.room);
+    lower_copy(bed, sizeof(bed), s_device_config.bed);
+    char prefix[sizeof(room) + sizeof(bed)] = {};
+    snprintf(prefix, sizeof(prefix), "%s%s", room, bed);
+    snprintf(s_mqtt_topics[0], sizeof(s_mqtt_topics[0]), "%stof1", prefix);
+    snprintf(s_mqtt_topics[1], sizeof(s_mqtt_topics[1]), "%stof2", prefix);
+    snprintf(s_mqtt_topics[2], sizeof(s_mqtt_topics[2]), "%smlx1", prefix);
+    snprintf(s_mqtt_topics[3], sizeof(s_mqtt_topics[3]), "%smlx2", prefix);
+    ESP_LOGI(TAG, "MQTT topics: %s / %s / %s / %s",
+             s_mqtt_topics[0], s_mqtt_topics[1], s_mqtt_topics[2], s_mqtt_topics[3]);
+}
+
+static void mqtt_event_handler(void *handler_args, esp_event_base_t base,
+                               int32_t event_id, void *event_data) {
+    (void)handler_args;
+    (void)base;
+    esp_mqtt_event_handle_t event = static_cast<esp_mqtt_event_handle_t>(event_data);
+    switch (static_cast<esp_mqtt_event_id_t>(event_id)) {
+        case MQTT_EVENT_CONNECTED:
+            s_mqtt_connected = true;
+            ESP_LOGI(TAG, "MQTT connected to %s", s_device_config.bemfa_host);
+            break;
+        case MQTT_EVENT_DISCONNECTED:
+            s_mqtt_connected = false;
+            ESP_LOGW(TAG, "MQTT disconnected; client will retry");
+            break;
+        case MQTT_EVENT_ERROR:
+            s_mqtt_connected = false;
+            ESP_LOGW(TAG, "MQTT error event");
+            break;
+        default:
+            break;
+    }
+    (void)event;
+}
+
+static void wifi_event_handler(void *arg, esp_event_base_t event_base,
+                               int32_t event_id, void *event_data) {
+    (void)arg;
+    (void)event_data;
+    if (event_base == WIFI_EVENT && event_id == WIFI_EVENT_STA_START) {
+        esp_wifi_connect();
+    } else if (event_base == WIFI_EVENT && event_id == WIFI_EVENT_STA_DISCONNECTED) {
+        s_mqtt_connected = false;
+        if (s_wifi_event_group) {
+            xEventGroupClearBits(s_wifi_event_group, WIFI_CONNECTED_BIT);
+        }
+        esp_wifi_connect();
+    } else if (event_base == IP_EVENT && event_id == IP_EVENT_STA_GOT_IP) {
+        if (s_wifi_event_group) {
+            xEventGroupSetBits(s_wifi_event_group, WIFI_CONNECTED_BIT);
+        }
+        ESP_LOGI(TAG, "WiFi connected");
+    }
+}
+
+static bool start_mqtt_client(void) {
+    snprintf(s_mqtt_uri, sizeof(s_mqtt_uri), "mqtt://%s:%u",
+             s_device_config.bemfa_host,
+             (unsigned)s_device_config.bemfa_mqtt_port);
+    esp_mqtt_client_config_t mqtt_cfg = {};
+    mqtt_cfg.broker.address.uri = s_mqtt_uri;
+    mqtt_cfg.credentials.client_id = s_device_config.bemfa_uid;
+    s_mqtt_client = esp_mqtt_client_init(&mqtt_cfg);
+    if (s_mqtt_client == NULL) {
+        ESP_LOGE(TAG, "Failed to initialize MQTT client");
+        return false;
+    }
+    esp_err_t err = esp_mqtt_client_register_event(
+        s_mqtt_client, static_cast<esp_mqtt_event_id_t>(ESP_EVENT_ANY_ID),
+        mqtt_event_handler, NULL);
+    if (err != ESP_OK) {
+        ESP_LOGE(TAG, "Failed to register MQTT event handler: %s", esp_err_to_name(err));
+        esp_mqtt_client_destroy(s_mqtt_client);
+        s_mqtt_client = NULL;
+        return false;
+    }
+    err = esp_mqtt_client_start(s_mqtt_client);
+    if (err != ESP_OK) {
+        ESP_LOGE(TAG, "Failed to start MQTT client: %s", esp_err_to_name(err));
+        esp_mqtt_client_destroy(s_mqtt_client);
+        s_mqtt_client = NULL;
+        return false;
+    }
+    ESP_LOGI(TAG, "MQTT client started, UID=***");
+    return true;
+}
+
+static bool init_network_backhaul(void) {
+    if (!s_device_config_ready) {
+        ESP_LOGW(TAG, "Network disabled: NVS requires ssid/password/uid/room/bed");
+        return false;
+    }
+    build_mqtt_topics();
+    esp_err_t err = esp_netif_init();
+    if (err != ESP_OK && err != ESP_ERR_INVALID_STATE) {
+        ESP_LOGE(TAG, "esp_netif_init failed: %s", esp_err_to_name(err));
+        return false;
+    }
+    err = esp_event_loop_create_default();
+    if (err != ESP_OK && err != ESP_ERR_INVALID_STATE) {
+        ESP_LOGE(TAG, "event loop init failed: %s", esp_err_to_name(err));
+        return false;
+    }
+    s_wifi_event_group = xEventGroupCreate();
+    if (s_wifi_event_group == NULL) {
+        ESP_LOGE(TAG, "WiFi event group allocation failed");
+        return false;
+    }
+    esp_netif_t *sta_netif = esp_netif_create_default_wifi_sta();
+    if (sta_netif == NULL) {
+        ESP_LOGE(TAG, "Failed to create WiFi STA netif");
+        return false;
+    }
+    wifi_init_config_t wifi_cfg = WIFI_INIT_CONFIG_DEFAULT();
+    ESP_ERROR_CHECK(esp_wifi_init(&wifi_cfg));
+    ESP_ERROR_CHECK(esp_event_handler_register(WIFI_EVENT, ESP_EVENT_ANY_ID, &wifi_event_handler, NULL));
+    ESP_ERROR_CHECK(esp_event_handler_register(IP_EVENT, IP_EVENT_STA_GOT_IP, &wifi_event_handler, NULL));
+
+    wifi_config_t sta_config = {};
+    memcpy(sta_config.sta.ssid, s_device_config.wifi_ssid, sizeof(sta_config.sta.ssid));
+    sta_config.sta.ssid[sizeof(sta_config.sta.ssid) - 1] = '\0';
+    memcpy(sta_config.sta.password, s_device_config.wifi_password, sizeof(sta_config.sta.password));
+    sta_config.sta.password[sizeof(sta_config.sta.password) - 1] = '\0';
+    ESP_ERROR_CHECK(esp_wifi_set_mode(WIFI_MODE_STA));
+    ESP_ERROR_CHECK(esp_wifi_set_config(WIFI_IF_STA, &sta_config));
+    ESP_ERROR_CHECK(esp_wifi_start());
+    if (!start_mqtt_client()) {
+        return false;
+    }
+    ESP_LOGI(TAG, "WiFi+MQTT init done, MQTT target=%s:%u",
+             s_device_config.bemfa_host, (unsigned)s_device_config.bemfa_mqtt_port);
+    return true;
+}
+
+static void mqtt_publish_payload(uint8_t sensor_type, uint8_t sensor_id,
+                                 const uint8_t *payload, size_t len) {
+    if (!s_mqtt_client || !s_mqtt_connected || !payload || len == 0 || len > 12000) {
+        return;
+    }
+    int topic_index = -1;
+    if (sensor_type == SENSOR_TYPE_TOF && sensor_id >= 1 && sensor_id <= 2) {
+        topic_index = sensor_id - 1;
+    } else if (sensor_type == SENSOR_TYPE_MLX && sensor_id >= 1 && sensor_id <= 2) {
+        topic_index = 2 + sensor_id - 1;
+    }
+    if (topic_index < 0 || s_mqtt_topics[topic_index][0] == '\0') {
+        return;
+    }
+
+    const char prefix[] = "{\"payload_b64\":\"";
+    const size_t prefix_len = sizeof(prefix) - 1;
+    if (prefix_len >= sizeof(s_mqtt_json)) {
+        return;
+    }
+    size_t encoded_len = 0;
+    int err = mbedtls_base64_encode(
+        reinterpret_cast<unsigned char *>(s_mqtt_json + prefix_len),
+        sizeof(s_mqtt_json) - prefix_len - 3,
+        &encoded_len, payload, len);
+    if (err != 0 || prefix_len + encoded_len + 3 > sizeof(s_mqtt_json)) {
+        ESP_LOGW(TAG, "MQTT base64 encoding failed len=%u err=%d", (unsigned)len, err);
+        return;
+    }
+    memcpy(s_mqtt_json, prefix, prefix_len);
+    s_mqtt_json[prefix_len + encoded_len] = '"';
+    s_mqtt_json[prefix_len + encoded_len + 1] = '}';
+    s_mqtt_json[prefix_len + encoded_len + 2] = '\0';
+    int msg_id = esp_mqtt_client_publish(
+        s_mqtt_client, s_mqtt_topics[topic_index], s_mqtt_json,
+        static_cast<int>(prefix_len + encoded_len + 2), 1, 0);
+    if (msg_id < 0) {
+        ESP_LOGW(TAG, "MQTT publish failed topic=%s", s_mqtt_topics[topic_index]);
+    }
+}
 
