+        "SELECT 1 FROM sqlite_master WHERE type='table' AND name='care_events'"
+    ).fetchone()
+    if not table_exists:
+        return
+    existing = {row[1] for row in conn.execute("PRAGMA table_info(care_events)").fetchall()}
+    desired = {
+        "severity": "TEXT NOT NULL DEFAULT 'info'",
+        "source": "TEXT NOT NULL DEFAULT 'manual'",
+        "created_by": "TEXT NOT NULL DEFAULT ''",
+        "ts": "INTEGER NOT NULL DEFAULT 0",
+    }
+    ts = now_ms()
+    for col, definition in desired.items():
+        if col not in existing:
+            conn.execute(f"ALTER TABLE care_events ADD COLUMN {col} {definition}")
+    # Backfill ts from created_ts when missing/zero, preserving chronological order.
+    conn.execute(
+        "UPDATE care_events SET ts = created_ts WHERE ts IS NULL OR ts = 0"
+    )
+    conn.execute(
