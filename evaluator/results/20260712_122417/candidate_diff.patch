+def _migrate_care_events(conn):
+    """Migrate legacy care_events tables that may be missing columns.
+
+    Old seeds may only have event_id/subject_id/room/bed/kind/title/content/
+    created_ts/updated_ts. We add the v3 columns (severity/source/created_by/ts)
+    when missing and backfill sensible defaults so existing rows are preserved.
+    """
