+                ESP_LOGW(TAG, "Network: MQTT not connected (sent=%lu failures=%d)",
+                         (unsigned long)s_mqtt_bytes_sent, s_mqtt_publish_failures);
+            }
+        }
+        vTaskDelay(pdMS_TO_TICKS(30000));
+    }
