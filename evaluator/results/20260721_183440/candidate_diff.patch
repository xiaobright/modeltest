+        return;
+    }
+    if (s_device_config.wifi_ssid[0] == '\0' && s_device_config.bemfa_uid[0] == '\0') {
+        ESP_LOGW(TAG, "No Wi-Fi SSID or BEMFA UID configured, skipping network backhaul");
+        return;
+    }
+    init_wifi_sta();
+    init_mqtt_client();
+    xTaskCreate(network_monitor_task, "net_mon", 4096, NULL, 2, NULL);
+}
