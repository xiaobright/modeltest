+def _table_columns(conn, table: str) -> set:
+    rows = conn.execute(f"PRAGMA table_info({table})").fetchall()
+    return {str(r["name"]) for r in rows}
+
+
+def _ensure_columns(conn, table: str, columns: list[tuple[str, str]]) -> None:
+    """Add any missing columns to `table` without dropping existing data.
+
+    `columns` is a list of (name, column_def) pairs. column_def must include a
+    DEFAULT so SQLite can back-fill existing rows for NOT NULL columns.
+    """
+    existing = _table_columns(conn, table)
+    if not existing:
+        # Table does not exist yet — nothing to migrate.
+        return
+    for name, column_def in columns:
+        if name not in existing:
+            conn.execute(f"ALTER TABLE {table} ADD COLUMN {column_def}")
+
+
+def migrate_management_db(conn) -> None:
+    """Best-effort in-place migration for databases created by older builds.
+
+    Old deployments may be missing columns that newer code expects. We add them
+    with sensible defaults so historical rows are preserved rather than wiped.
+    """
+    _ensure_columns(conn, "care_events", [
+        ("severity", "severity TEXT NOT NULL DEFAULT 'info'"),
+        ("source", "source TEXT NOT NULL DEFAULT 'manual'"),
+        ("created_by", "created_by TEXT NOT NULL DEFAULT ''"),
+        ("ts", "ts INTEGER NOT NULL DEFAULT 0"),
+    ])
+    # Sessions gained identity/assurance/expiry columns over time.
+    _ensure_columns(conn, "sessions", [
+        ("assurance_level", "assurance_level TEXT NOT NULL DEFAULT 'none'"),
+        ("identity_state", "identity_state TEXT NOT NULL DEFAULT 'unknown'"),
+        ("expires_ts", "expires_ts INTEGER NOT NULL DEFAULT 0"),
+    ])
+    # Admin auth tables gained salted hashes + hashed session tokens.
+    _ensure_columns(conn, "admin_accounts", [
+        ("salt", "salt TEXT NOT NULL DEFAULT ''"),
+        ("status", "status TEXT NOT NULL DEFAULT 'active'"),
+    ])
+
