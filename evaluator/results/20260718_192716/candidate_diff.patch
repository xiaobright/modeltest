+    lower_copy(room_lc, sizeof(room_lc), s_device_config.room);
+    lower_copy(bed_lc, sizeof(bed_lc), s_device_config.bed);
+    snprintf(s_topic_tof1, sizeof(s_topic_tof1), "%s%stof1", room_lc, bed_lc);
+    snprintf(s_topic_tof2, sizeof(s_topic_tof2), "%s%stof2", room_lc, bed_lc);
+    snprintf(s_topic_mlx1, sizeof(s_topic_mlx1), "%s%smlx1", room_lc, bed_lc);
+    snprintf(s_topic_mlx2, sizeof(s_topic_mlx2), "%s%smlx2", room_lc, bed_lc);
+    ESP_LOGI(TAG, "Backhaul topics: %s %s %s %s",
+             s_topic_tof1, s_topic_tof2, s_topic_mlx1, s_topic_mlx2);
+}
+
+// 根据 sensor 类型 + src_id 选出目标 topic。
+static const char *topic_for(uint8_t sensor_type, uint8_t src_id) {
+    if (sensor_type == SENSOR_TYPE_TOF) {
+        return (src_id == 1) ? s_topic_tof1 : s_topic_tof2;
+    }
+    if (sensor_type == SENSOR_TYPE_MLX) {
+        return (src_id == 1) ? s_topic_mlx1 : s_topic_mlx2;
+    }
+    return NULL;
+}
+
+// 把原始 payload base64 编码后作为 {"payload_b64":"..."} 发布到 MQTT。
+// 注意：ToF payload ~10002 字节，base64 后 ~13336 字符，JSON 缓冲必须动态分配，
+// 绝不能用 char b64_buf[256] 这种固定小缓冲（会截断整帧）。
+static void publish_payload(uint8_t sensor_type, uint8_t src_id,
+                            const uint8_t *payload, size_t len) {
+    if (!s_mqtt_connected || s_mqtt_client == NULL || payload == NULL || len == 0) {
+        return;
+    }
+    const char *topic = topic_for(sensor_type, src_id);
+    if (topic == NULL || topic[0] == '\0') {
+        return;
+    }
+
+    // base64 编码长度: 4 * ceil(len/3)，再加 NUL。
+    size_t b64_cap = ((len + 2) / 3) * 4 + 1;
+    unsigned char *b64 = (unsigned char *)malloc(b64_cap);
+    if (b64 == NULL) {
+        ESP_LOGW(TAG, "publish_payload: OOM for b64 (%u bytes)", (unsigned)b64_cap);
+        return;
+    }
+    size_t b64_len = 0;
+    int rc = mbedtls_base64_encode(b64, b64_cap, &b64_len, payload, len);
+    if (rc != 0) {
+        ESP_LOGW(TAG, "publish_payload: base64 encode failed rc=%d", rc);
+        free(b64);
+        return;
+    }
+
+    // JSON: {"payload_b64":"<b64>"} —— 前后缀 18 字节 + NUL。
+    size_t json_cap = b64_len + 32;
+    char *json = (char *)malloc(json_cap);
+    if (json == NULL) {
+        ESP_LOGW(TAG, "publish_payload: OOM for json (%u bytes)", (unsigned)json_cap);
+        free(b64);
+        return;
+    }
+    int json_len = snprintf(json, json_cap, "{\"payload_b64\":\"%s\"}", (char *)b64);
+    free(b64);
+    if (json_len < 0 || (size_t)json_len >= json_cap) {
+        ESP_LOGW(TAG, "publish_payload: json truncated");
+        free(json);
+        return;
+    }
+
+    // QoS 0，不保留：姿态帧是高频实时流，丢一帧无所谓，也避免 broker 堆积。
+    esp_mqtt_client_publish(s_mqtt_client, topic, json, json_len, 0, 0);
+    free(json);
+}
+
+static void wifi_event_handler(void *arg, esp_event_base_t event_base,
+                               int32_t event_id, void *event_data) {
+    (void)arg;
+    (void)event_data;
+    if (event_base == WIFI_EVENT && event_id == WIFI_EVENT_STA_START) {
+        esp_wifi_connect();
+    } else if (event_base == WIFI_EVENT && event_id == WIFI_EVENT_STA_DISCONNECTED) {
+        s_mqtt_connected = false;
+        if (s_wifi_retry_count < WIFI_MAX_RETRY) {
+            esp_wifi_connect();
+            s_wifi_retry_count++;
+            ESP_LOGW(TAG, "Wi-Fi disconnected, retry %d/%d", s_wifi_retry_count, WIFI_MAX_RETRY);
+        } else {
+            ESP_LOGE(TAG, "Wi-Fi retry limit reached; will keep retrying slowly");
+            // 超过上限后不放弃，交给后续慢速重连（此处简单重置计数）。
+            s_wifi_retry_count = 0;
+            esp_wifi_connect();
+        }
+        if (s_net_event_group) {
+            xEventGroupClearBits(s_net_event_group, WIFI_CONNECTED_BIT);
+        }
+    } else if (event_base == IP_EVENT && event_id == IP_EVENT_STA_GOT_IP) {
+        ip_event_got_ip_t *event = (ip_event_got_ip_t *)event_data;
+        ESP_LOGI(TAG, "Wi-Fi got IP: " IPSTR, IP2STR(&event->ip_info.ip));
+        s_wifi_retry_count = 0;
+        if (s_net_event_group) {
+            xEventGroupSetBits(s_net_event_group, WIFI_CONNECTED_BIT);
+        }
+    }
+}
+
+static void mqtt_event_handler(void *handler_args, esp_event_base_t base,
+                               int32_t event_id, void *event_data) {
+    (void)handler_args;
+    (void)base;
+    (void)event_data;
+    switch ((esp_mqtt_event_id_t)event_id) {
+        case MQTT_EVENT_CONNECTED:
+            s_mqtt_connected = true;
+            ESP_LOGI(TAG, "MQTT connected to %s:%u",
+                     s_device_config.bemfa_host, (unsigned)s_device_config.bemfa_mqtt_port);
+            break;
+        case MQTT_EVENT_DISCONNECTED:
+            s_mqtt_connected = false;
+            ESP_LOGW(TAG, "MQTT disconnected");
+            break;
+        case MQTT_EVENT_ERROR:
+            ESP_LOGW(TAG, "MQTT event error");
+            break;
+        default:
+            break;
+    }
+}
+
+static esp_err_t wifi_init_sta(void) {
+    if (s_net_event_group == NULL) {
+        s_net_event_group = xEventGroupCreate();
+    }
+    ESP_ERROR_CHECK(esp_netif_init());
+    ESP_ERROR_CHECK(esp_event_loop_create_default());
+    esp_netif_create_default_wifi_sta();
+
+    wifi_init_config_t cfg = WIFI_INIT_CONFIG_DEFAULT();
+    ESP_ERROR_CHECK(esp_wifi_init(&cfg));
+
+    ESP_ERROR_CHECK(esp_event_handler_instance_register(
+        WIFI_EVENT, ESP_EVENT_ANY_ID, &wifi_event_handler, NULL, NULL));
+    ESP_ERROR_CHECK(esp_event_handler_instance_register(
+        IP_EVENT, IP_EVENT_STA_GOT_IP, &wifi_event_handler, NULL, NULL));
+
+    wifi_config_t wifi_config = {};
+    // 用 strncpy 而非 snprintf("%s")，避免 -Werror=format-truncation
+    // （sta.ssid 为 32 字节，源 wifi_ssid 为 33 字节，snprintf 会被判定可能截断）。
+    strncpy((char *)wifi_config.sta.ssid, s_device_config.wifi_ssid,
+            sizeof(wifi_config.sta.ssid) - 1);
+    wifi_config.sta.ssid[sizeof(wifi_config.sta.ssid) - 1] = '\0';
+    strncpy((char *)wifi_config.sta.password, s_device_config.wifi_password,
+            sizeof(wifi_config.sta.password) - 1);
+    wifi_config.sta.password[sizeof(wifi_config.sta.password) - 1] = '\0';
+    wifi_config.sta.threshold.authmode = WIFI_AUTH_WPA2_PSK;
+    if (s_device_config.wifi_password[0] == '\0') {
+        wifi_config.sta.threshold.authmode = WIFI_AUTH_OPEN;
+    }
+
+    ESP_ERROR_CHECK(esp_wifi_set_mode(WIFI_MODE_STA));
+    ESP_ERROR_CHECK(esp_wifi_set_config(WIFI_IF_STA, &wifi_config));
+    ESP_ERROR_CHECK(esp_wifi_start());
+    ESP_LOGI(TAG, "Wi-Fi STA started, connecting to SSID '%s'", s_device_config.wifi_ssid);
+    return ESP_OK;
+}
+
+static esp_err_t mqtt_backhaul_start(void) {
+    // 巴法云 MQTT: broker = mqtt://<host>:<port>，client_id = 用户私钥(UID)。
+    char uri[96];
+    snprintf(uri, sizeof(uri), "mqtt://%s:%u",
+             s_device_config.bemfa_host, (unsigned)s_device_config.bemfa_mqtt_port);
+
+    esp_mqtt_client_config_t mqtt_cfg = {};
+    mqtt_cfg.broker.address.uri = uri;
+    mqtt_cfg.credentials.client_id = s_device_config.bemfa_uid;
+    mqtt_cfg.session.keepalive = 60;
+    // 姿态帧较大且高频，放宽出站缓冲。
+    mqtt_cfg.buffer.out_size = 16384;
+
+    s_mqtt_client = esp_mqtt_client_init(&mqtt_cfg);
+    if (s_mqtt_client == NULL) {
+        ESP_LOGE(TAG, "esp_mqtt_client_init failed");
+        return ESP_FAIL;
+    }
+    ESP_ERROR_CHECK(esp_mqtt_client_register_event(
+        s_mqtt_client, (esp_mqtt_event_id_t)ESP_EVENT_ANY_ID, mqtt_event_handler, NULL));
+    ESP_ERROR_CHECK(esp_mqtt_client_start(s_mqtt_client));
+    ESP_LOGI(TAG, "MQTT client started -> %s (client_id=%s)",
+             uri, s_device_config.bemfa_uid[0] ? "***" : "(empty)");
+    return ESP_OK;
+}
+
+// 启动完整网络回传链路：Wi-Fi STA -> 等待获取 IP -> 启动 MQTT。
+static void network_backhaul_start(void) {
+    if (!network_config_is_complete()) {
+        ESP_LOGW(TAG, "Network backhaul disabled: Wi-Fi/MQTT config incomplete");
+        return;
+    }
+    if (!bed_config_is_complete()) {
+        ESP_LOGW(TAG, "Network backhaul disabled: room/bed not set (topics unknown)");
+        return;
+    }
+
+    build_backhaul_topics();
+    ESP_ERROR_CHECK(wifi_init_sta());
+
+    // 等待首次拿到 IP（最多 15s），拿到后再启动 MQTT；即便超时也启动，
+    // MQTT 客户端自身会在 Wi-Fi 恢复后自动重连。
+    if (s_net_event_group) {
+        EventBits_t bits = xEventGroupWaitBits(
+            s_net_event_group, WIFI_CONNECTED_BIT, pdFALSE, pdTRUE,
+            pdMS_TO_TICKS(15000));
+        if (!(bits & WIFI_CONNECTED_BIT)) {
+            ESP_LOGW(TAG, "Wi-Fi not connected within 15s; starting MQTT anyway (will auto-reconnect)");
+        }
+    }
+    mqtt_backhaul_start();
+}
