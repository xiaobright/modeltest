+def fetch_current_session() -> Optional[dict]:
+    """Ask the gateway which identity session is currently active at this station.
+
+    After the gateway tightened v3 authorization, sensitive chat context is only
+    returned for an explicit, authenticated session. Rather than relying on the
+    gateway silently falling back to an ambient/current session (which risks
+    leaking one caller's data to another), the local assistant explicitly fetches
+    the current session here and then passes its session_id when requesting
+    context. Returns the session dict, or None if unavailable.
+    """
+    if not GATEWAY_CONTEXT_ENABLED:
+        return None
+    try:
+        r = requests.get(GATEWAY_SESSION_CURRENT_URL, timeout=GATEWAY_TIMEOUT_S)
+        r.raise_for_status()
+        obj = r.json()
+        if isinstance(obj, dict):
+            session = obj.get("session")
+            return session if isinstance(session, dict) else None
+    except Exception as e:  # noqa: BLE001
+        print(f"[GATEWAY当前会话获取失败] {e}")
+    return None
+
+
+def resolve_session_id(session_id=None) -> str:
+    """Resolve the session_id to use for a context request.
+
+    Priority: explicit arg > VOICE_SESSION_ID env > gateway current session.
+    We always try to end up with a concrete session_id so the gateway can apply
+    per-session identity/assurance/expiry checks instead of guessing.
+    """
+    sid = (session_id if session_id is not None else VOICE_SESSION_ID).strip()
+    if sid:
+        return sid
+    session = fetch_current_session()
+    if isinstance(session, dict):
+        return str(session.get("session_id") or "").strip()
+    return ""
+
