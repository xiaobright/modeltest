+    conn.execute("UPDATE care_events SET room = UPPER(TRIM(room)), bed = UPPER(TRIM(bed))")
+    conn.execute("UPDATE care_events SET ts = created_ts WHERE ts IS NULL OR ts <= 0")
+    conn.execute(
+        "CREATE INDEX IF NOT EXISTS idx_care_events_ts ON care_events(ts DESC, created_ts DESC)"
+    )
+
+
+def _migrate_legacy_admin_passwords(conn) -> None:
+    rows = conn.execute(
+        "SELECT username, password_hash FROM admin_accounts WHERE salt = ''"
+    ).fetchall()
+    for row in rows:
+        legacy_password = str(row["password_hash"] or "")
+        if not legacy_password:
+            continue
+        salt = secrets.token_bytes(16)
+        digest = hashlib.pbkdf2_hmac(
+            "sha256", legacy_password.encode("utf-8"), salt, 200_000
+        ).hex()
+        conn.execute(
+            "UPDATE admin_accounts SET password_hash = ?, salt = ?, updated_ts = ? WHERE username = ?",
+            (digest, salt.hex(), now_ms(), str(row["username"])),
+        )
+
