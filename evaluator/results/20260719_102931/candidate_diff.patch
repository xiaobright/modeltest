+  -d '{"event_id":"care_test_1","subject_id":"sub_patient_test","room":"r1203","bed":"b1","kind":"turning_assist","title":"协助翻身","content":"22:10 已协助翻身","severity":"info","source":"manual","ts":1710000000000}'
