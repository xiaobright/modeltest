+// Publish a raw sensor payload as {"payload_b64":"..."} to the proper topic.
+static void publish_sensor_payload(uint8_t sensor_type, uint8_t sensor_id,
+                                    const uint8_t *payload, uint16_t len) {
+    if (s_mqtt_client == NULL || !s_mqtt_connected || payload == NULL || len == 0) {
+        return;
+    }
+    const char *kind = "unknown";
+    if (sensor_type == SENSOR_TYPE_TOF && sensor_id == 1) kind = "tof1";
+    else if (sensor_type == SENSOR_TYPE_TOF && sensor_id == 2) kind = "tof2";
+    else if (sensor_type == SENSOR_TYPE_MLX && sensor_id == 1) kind = "mlx1";
+    else if (sensor_type == SENSOR_TYPE_MLX && sensor_id == 2) kind = "mlx2";
+
+    char topic[48] = {0};
+    build_topic(topic, sizeof(topic), kind);
+
+    size_t b64_len = 0;
+    mbedtls_base64_encode(NULL, 0, &b64_len, payload, len);
+    if (b64_len == 0) return;
+    // mbedtls_base64_encode output length includes null terminator.
+    char *b64_buf = (char *)malloc(b64_len);
+    if (b64_buf == NULL) {
+        ESP_LOGE(TAG_NET, "Failed to allocate base64 buffer");
+        return;
+    }
+    size_t written = 0;
+    int ret = mbedtls_base64_encode((uint8_t *)b64_buf, b64_len, &written, payload, len);
+    if (ret != 0) {
+        free(b64_buf);
+        ESP_LOGE(TAG_NET, "Base64 encoding failed: %d", ret);
+        return;
+    }
+
+    int json_len = snprintf(NULL, 0, "{\"payload_b64\":\"%s\"}", b64_buf) + 1;
+    char *json_buf = (char *)malloc(json_len);
+    if (json_buf == NULL) {
+        free(b64_buf);
+        ESP_LOGE(TAG_NET, "Failed to allocate JSON buffer");
+        return;
+    }
+    snprintf(json_buf, json_len, "{\"payload_b64\":\"%s\"}", b64_buf);
+
+    int msg_id = esp_mqtt_client_publish(s_mqtt_client, topic, json_buf, strlen(json_buf), 0, 0);
+    if (msg_id < 0) {
+        ESP_LOGW(TAG_NET, "MQTT publish failed for topic=%s", topic);
+    } else {
+        ESP_LOGD(TAG_NET, "MQTT published topic=%s len=%u", topic, len);
+    }
+    free(b64_buf);
+    free(json_buf);
+}
