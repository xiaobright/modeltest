+static void network_event_handler(void *arg, esp_event_base_t event_base,
+                                   int32_t event_id, void *event_data) {
+    (void)arg;
+    if (event_base == WIFI_EVENT && event_id == WIFI_EVENT_STA_START) {
+        esp_wifi_connect();
+    } else if (event_base == WIFI_EVENT && event_id == WIFI_EVENT_STA_DISCONNECTED) {
+        ESP_LOGW(TAG_NET, "Wi-Fi disconnected, reconnecting...");
+        s_mqtt_connected = false;
+        if (s_wifi_event_group) {
+            xEventGroupClearBits(s_wifi_event_group, WIFI_CONNECTED_BIT);
+        }
+        esp_wifi_connect();
+    } else if (event_base == IP_EVENT && event_id == IP_EVENT_STA_GOT_IP) {
+        ESP_LOGI(TAG_NET, "Wi-Fi got IP");
+        if (s_wifi_event_group) {
+            xEventGroupSetBits(s_wifi_event_group, WIFI_CONNECTED_BIT);
+        }
+    } else if (event_id == MQTT_EVENT_CONNECTED) {
+        ESP_LOGI(TAG_NET, "MQTT connected");
+        s_mqtt_connected = true;
+        if (s_wifi_event_group) {
+            xEventGroupSetBits(s_wifi_event_group, MQTT_CONNECTED_BIT);
+        }
+    } else if (event_id == MQTT_EVENT_DISCONNECTED) {
+        ESP_LOGW(TAG_NET, "MQTT disconnected");
+        s_mqtt_connected = false;
+        if (s_wifi_event_group) {
+            xEventGroupClearBits(s_wifi_event_group, MQTT_CONNECTED_BIT);
+        }
+    }
+}
