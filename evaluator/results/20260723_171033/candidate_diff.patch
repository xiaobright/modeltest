+
+    esp_event_handler_register(WIFI_EVENT, ESP_EVENT_ANY_ID,  &wifi_event_handler, NULL);
+    esp_event_handler_register(IP_EVENT,   IP_EVENT_STA_GOT_IP, &wifi_event_handler, NULL);
+
+    wifi_config_t wifi_cfg = {};
+    strncpy((char *)wifi_cfg.sta.ssid,     s_device_config.wifi_ssid,     sizeof(wifi_cfg.sta.ssid)     - 1);
+    strncpy((char *)wifi_cfg.sta.password, s_device_config.wifi_password, sizeof(wifi_cfg.sta.password) - 1);
+    wifi_cfg.sta.threshold.authmode = WIFI_AUTH_WPA2_PSK;
+
+    ESP_ERROR_CHECK(esp_wifi_set_mode(WIFI_MODE_STA));
+    ESP_ERROR_CHECK(esp_wifi_set_config(WIFI_IF_STA, &wifi_cfg));
+    ESP_ERROR_CHECK(esp_wifi_start());
+    esp_wifi_connect();
+
+    // MQTT broker URI: mqtt://<uid>@<host>:<port>
+    // Bemfa 用 clientId = uid
+    char broker_uri[160];
+    snprintf(broker_uri, sizeof(broker_uri), "mqtt://%s:%u",
+             s_device_config.bemfa_host[0] ? s_device_config.bemfa_host : "bemfa.com",
+             (unsigned)s_device_config.bemfa_mqtt_port);
+
+    esp_mqtt_client_config_t mqtt_cfg = {};
+    mqtt_cfg.broker.address.uri    = broker_uri;
+    mqtt_cfg.credentials.client_id = s_device_config.bemfa_uid;
+
+    s_mqtt_client = esp_mqtt_client_init(&mqtt_cfg);
+    esp_mqtt_client_register_event(s_mqtt_client, MQTT_EVENT_ANY,
+                                   mqtt_event_handler, NULL);
+    esp_mqtt_client_start(s_mqtt_client);
+
+    build_topic_prefix();
+    ESP_LOGI(TAG, "[NET] MQTT client started, topic_prefix=%s", s_topic_prefix);
+}
+
+// 将 payload 做 base64 编码后发布到 MQTT topic
+// topic_suffix: e.g. "tof1", "tof2", "mlx1", "mlx2"
+// 注意: 对于 ToF，payload 是完整 MaixSense 原始帧；对于 MLX，payload 是 float 数组
+static void mqtt_publish_payload(const char *topic_suffix,
+                                 const uint8_t *payload, size_t payload_len) {
+    if (!s_mqtt_connected || !s_mqtt_client) {
+        return;
+    }
+    if (s_topic_prefix[0] == '\0') {
+        return;
+    }
+
+    // base64 输出长度: ceil(payload_len / 3) * 4 + 1
+    size_t b64_len = ((payload_len + 2) / 3) * 4 + 1;
+    // JSON 包含 {"payload_b64":"..."} 额外 18 字节开销
+    size_t json_len = b64_len + 20;
+    char *json_buf = (char *)malloc(json_len);
+    if (!json_buf) {
+        ESP_LOGE(TAG, "[NET] mqtt_publish_payload: malloc failed (need %u bytes)", (unsigned)json_len);
+        return;
+    }
+
+    size_t out_len = 0;
+    int rc = mbedtls_base64_encode(
+        (unsigned char *)json_buf + 16,   // reserve space for prefix
+        b64_len,
+        &out_len,
+        payload, payload_len
+    );
+    if (rc != 0) {
+        ESP_LOGE(TAG, "[NET] base64 encode failed: %d", rc);
+        free(json_buf);
+        return;
+    }
+    // Build JSON: {"payload_b64":"<base64>"}
+    // Shift b64 data to correct position and prepend key
+    memmove(json_buf + 16, json_buf + 16, out_len);
+    memcpy(json_buf, "{\"payload_b64\":\"", 16);
+    json_buf[16 + out_len]     = '"';
+    json_buf[16 + out_len + 1] = '}';
+    json_buf[16 + out_len + 2] = '\0';
+
+    char topic[80];
+    snprintf(topic, sizeof(topic), "%s%s", s_topic_prefix, topic_suffix);
+
+    esp_mqtt_client_publish(s_mqtt_client, topic, json_buf,
+                            (int)(16 + out_len + 2), 0, 0);
+    free(json_buf);
+}
 
