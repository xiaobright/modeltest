+    ESP_ERROR_CHECK(esp_wifi_set_config(WIFI_IF_STA, &wifi_config));
+    ESP_ERROR_CHECK(esp_wifi_start());
+
+    ESP_LOGI(TAG, "Wi-Fi STA connecting to %s...", s_device_config.wifi_ssid);
+    EventBits_t bits = xEventGroupWaitBits(s_wifi_event_group,
+            WIFI_CONNECTED_BIT | WIFI_FAIL_BIT,
+            pdFALSE, pdFALSE,
+            pdMS_TO_TICKS(30000));
+    if (bits & WIFI_CONNECTED_BIT) {
+        ESP_LOGI(TAG, "Wi-Fi STA connected");
+        return true;
+    }
+    ESP_LOGE(TAG, "Wi-Fi STA connection failed");
+    return false;
+}
+
+#if CONFIG_MQTT_BACKHAUL_ENABLED
+static void build_mqtt_topic(char *dst, size_t dst_len, const char *stream) {
+    char room_lower[16] = {};
+    char bed_lower[16] = {};
+    lower_copy(room_lower, sizeof(room_lower), s_device_config.room);
+    lower_copy(bed_lower, sizeof(bed_lower), s_device_config.bed);
+    snprintf(dst, dst_len, "%s%s%s", room_lower, bed_lower, stream);
+}
+
+static void mqtt_event_handler(void *handler_args, esp_event_base_t base,
+                                int32_t event_id, void *event_data) {
+    (void)handler_args;
+    (void)base;
+    esp_mqtt_event_handle_t event = (esp_mqtt_event_handle_t)event_data;
+    switch ((esp_mqtt_event_id_t)event_id) {
+    case MQTT_EVENT_CONNECTED:
+        ESP_LOGI(TAG, "MQTT connected to bemfa");
+        xEventGroupSetBits(s_mqtt_event_group, MQTT_CONNECTED_BIT);
+        break;
+    case MQTT_EVENT_DISCONNECTED:
+        ESP_LOGW(TAG, "MQTT disconnected");
+        break;
+    case MQTT_EVENT_ERROR:
+        ESP_LOGE(TAG, "MQTT error");
+        break;
+    default:
+        break;
+    }
+}
+
+static bool mqtt_init_client(void) {
+    s_mqtt_event_group = xEventGroupCreate();
+    if (!s_mqtt_event_group) {
+        ESP_LOGE(TAG, "Failed to create MQTT event group");
+        return false;
+    }
+    char uri[128];
+    snprintf(uri, sizeof(uri), "mqtt://%s:%u",
+             s_device_config.bemfa_host, (unsigned)s_device_config.bemfa_mqtt_port);
+    esp_mqtt_client_config_t mqtt_cfg = {};
+    mqtt_cfg.broker.address.uri = uri;
+    mqtt_cfg.credentials.client_id = s_device_config.bemfa_uid;
+    mqtt_cfg.session.keepalive = 60;
+    mqtt_cfg.network.disable_auto_reconnect = false;
+
+    s_mqtt_client = esp_mqtt_client_init(&mqtt_cfg);
+    if (!s_mqtt_client) {
+        ESP_LOGE(TAG, "Failed to init MQTT client");
+        return false;
+    }
+    esp_mqtt_client_register_event(s_mqtt_client, MQTT_EVENT_ANY,
+                                    mqtt_event_handler, NULL);
+    esp_err_t err = esp_mqtt_client_start(s_mqtt_client);
+    if (err != ESP_OK) {
+        ESP_LOGE(TAG, "Failed to start MQTT client: %s", esp_err_to_name(err));
+        return false;
+    }
+    EventBits_t bits = xEventGroupWaitBits(s_mqtt_event_group,
+            MQTT_CONNECTED_BIT, pdFALSE, pdFALSE, pdMS_TO_TICKS(10000));
+    if (bits & MQTT_CONNECTED_BIT) {
+        return true;
+    }
+    ESP_LOGW(TAG, "MQTT connect timeout, will retry on publish");
+    return true;
+}
+
+static bool mqtt_publish_payload(const char *stream, const uint8_t *payload, size_t payload_len) {
+    if (!s_mqtt_client || !s_device_config.bemfa_uid[0]) {
+        return false;
+    }
+    if (payload_len == 0) {
+        return false;
+    }
+
+    size_t b64_len = 0;
+    mbedtls_base64_encode(NULL, 0, &b64_len, payload, payload_len);
+    uint8_t *b64_buf = (uint8_t *)malloc(b64_len + 1);
+    if (!b64_buf) {
+        ESP_LOGE(TAG, "MQTT publish: malloc failed for b64_buf (%u bytes)",
+                 (unsigned)b64_len);
+        return false;
+    }
+    size_t olen = 0;
+    int ret = mbedtls_base64_encode(b64_buf, b64_len, &olen, payload, payload_len);
+    if (ret != 0) {
+        ESP_LOGE(TAG, "MQTT publish: base64 encode failed ret=%d", ret);
+        free(b64_buf);
+        return false;
+    }
+    b64_buf[olen] = '\0';
+
+    size_t json_len = olen + 64;
+    char *json_buf = (char *)malloc(json_len);
+    if (!json_buf) {
+        ESP_LOGE(TAG, "MQTT publish: malloc failed for json_buf");
+        free(b64_buf);
+        return false;
+    }
+    int written = snprintf(json_buf, json_len, "{\"payload_b64\":\"%s\"}", b64_buf);
+
+    if (written < 0 || (size_t)written >= json_len) {
+        free(json_buf);
+        json_len = (size_t)written + 1;
+        json_buf = (char *)malloc(json_len);
+        if (!json_buf) {
+            free(b64_buf);
+            return false;
+        }
+        snprintf(json_buf, json_len, "{\"payload_b64\":\"%s\"}", b64_buf);
+    }
+    free(b64_buf);
+
+    char topic[48];
+    build_mqtt_topic(topic, sizeof(topic), stream);
+    int msg_id = esp_mqtt_client_publish(s_mqtt_client, topic,
+                                          json_buf, 0, 1, 0);
+    free(json_buf);
+    if (msg_id < 0) {
+        ESP_LOGW(TAG, "MQTT publish failed for topic %s", topic);
+        return false;
+    }
+    return true;
+}
