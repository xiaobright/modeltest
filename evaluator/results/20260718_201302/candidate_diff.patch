+def migrate_care_events_schema(conn):
+    """Upgrade legacy care_events rows without dropping their contents."""
+    existing = {str(row[1]) for row in conn.execute("PRAGMA table_info(care_events)").fetchall()}
+    columns = {
+        "severity": "TEXT NOT NULL DEFAULT 'info'",
+        "source": "TEXT NOT NULL DEFAULT 'manual'",
+        "created_by": "TEXT NOT NULL DEFAULT ''",
+        "ts": "INTEGER NOT NULL DEFAULT 0",
+    }
+    for name, definition in columns.items():
+        if name not in existing:
+            conn.execute(f"ALTER TABLE care_events ADD COLUMN {name} {definition}")
+    conn.execute("UPDATE care_events SET ts = created_ts WHERE (ts IS NULL OR ts = 0) AND created_ts > 0")
+    conn.execute("UPDATE care_events SET room = UPPER(TRIM(room)), bed = UPPER(TRIM(bed))")
+    conn.execute(
+        "CREATE INDEX IF NOT EXISTS idx_care_events_subject_ts "
+        "ON care_events(subject_id, ts DESC, created_ts DESC)"
+    )
+    conn.execute(
+        "CREATE INDEX IF NOT EXISTS idx_care_events_room_bed_ts "
+        "ON care_events(room, bed, ts DESC, created_ts DESC)"
+    )
+
+
+def migrate_legacy_admin_passwords(conn):
+    """Hash old seed rows whose empty salt indicates a plaintext password."""
+    rows = conn.execute(
+        "SELECT username, password_hash FROM admin_accounts WHERE salt = '' AND password_hash <> ''"
+    ).fetchall()
+    for row in rows:
+        password = str(row["password_hash"])
+        salt = secrets.token_bytes(16)
+        digest = hashlib.pbkdf2_hmac("sha256", password.encode("utf-8"), salt, 200_000).hex()
+        conn.execute(
+            "UPDATE admin_accounts SET password_hash = ?, salt = ? WHERE username = ?",
+            (digest, salt.hex(), row["username"]),
+        )
+
