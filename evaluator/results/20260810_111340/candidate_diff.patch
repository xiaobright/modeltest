+def migrate_management_db(conn):
+    """Patch legacy SQLite databases whose tables predate new columns.
+
+    CREATE TABLE IF NOT EXISTS only handles greenfield databases. Real deployments
+    ship with an older schema that is missing columns such as severity/source/
+    created_by/ts on care_events. This inspects each table via PRAGMA table_info
+    and adds missing columns with sensible defaults, preserving existing rows.
+    """
+    table = conn.execute("SELECT name FROM sqlite_master WHERE type='table' AND name='care_events'").fetchone()
+    if table is not None:
+        _ensure_column(conn, "care_events", "severity", "TEXT NOT NULL DEFAULT 'info'", default_expr="'info'")
+        _ensure_column(conn, "care_events", "source", "TEXT NOT NULL DEFAULT 'manual'", default_expr="'manual'")
+        _ensure_column(conn, "care_events", "created_by", "TEXT NOT NULL DEFAULT ''", default_expr="''")
+        _ensure_column(conn, "care_events", "ts", "INTEGER NOT NULL DEFAULT 0", default_expr="0")
+        try:
+            conn.execute(
+                "UPDATE care_events SET ts = created_ts WHERE ts = 0 AND created_ts > 0"
+            )
+        except sqlite3.OperationalError:
+            pass
+
+    table = conn.execute("SELECT name FROM sqlite_master WHERE type='table' AND name='admin_accounts'").fetchone()
+    if table is not None:
+        _ensure_column(conn, "admin_accounts", "subject_id", "TEXT NOT NULL DEFAULT ''", default_expr="''")
+        _ensure_column(conn, "admin_accounts", "status", "TEXT NOT NULL DEFAULT 'active'", default_expr="'active'")
+        _ensure_column(conn, "admin_accounts", "created_ts", "INTEGER NOT NULL DEFAULT 0", default_expr="0")
+        _ensure_column(conn, "admin_accounts", "updated_ts", "INTEGER NOT NULL DEFAULT 0", default_expr="0")
+
+    table = conn.execute("SELECT name FROM sqlite_master WHERE type='table' AND name='admin_http_sessions'").fetchone()
+    if table is not None:
+        _ensure_column(conn, "admin_http_sessions", "username", "TEXT NOT NULL DEFAULT ''", default_expr="''")
