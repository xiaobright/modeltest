+// Wi-Fi 事件回调
+static void wifi_event_handler(void *arg, esp_event_base_t event_base,
+                              int32_t event_id, void *event_data) {
+    (void)arg;
+    (void)event_data;
+    if (event_base == WIFI_EVENT && event_id == WIFI_EVENT_STA_START) {
+        // 已关联触发 STA 开始；等待 IP
+        return;
+    }
+    if (event_base == WIFI_EVENT && event_id == WIFI_EVENT_STA_DISCONNECTED) {
+        s_wifi_connected = false;
+        ESP_LOGW(NET_TAG, "WiFi disconnected, retrying connect...");
+        esp_wifi_connect();
+        return;
+    }
+    if (event_base == IP_EVENT && event_id == IP_EVENT_STA_GOT_IP) {
+        s_wifi_connected = true;
+        ESP_LOGI(NET_TAG, "Got IP, starting MQTT...");
+        mqtt_start_blocking();
+        return;
+    }
+}
+
+// MQTT 事件回调
+static void mqtt_event_handler(void *arg, esp_event_base_t event_base,
+                               int32_t event_id, void *event_data) {
+    (void)event_base;
+    switch (event_id) {
+    case MQTT_EVENT_CONNECTED:
+        s_mqtt_connected = true;
+        ESP_LOGI(NET_TAG, "MQTT connected to %s:%u", s_device_config.bemfa_host,
+                 (unsigned)s_device_config.bemfa_mqtt_port);
+        break;
+    case MQTT_EVENT_DISCONNECTED:
+        s_mqtt_connected = false;
+        ESP_LOGW(NET_TAG, "MQTT disconnected");
+        break;
+    default:
+        break;
+    }
+}
+
+// 发布一个 sensor payload 到巴法云。
+// topic 命名: {room}{bed}{kind}{sensor_id}，全部小写。
+// kind 由 SENSOR_TYPE 决定: 0x01 -> "mlx", 0x02 -> "tof"。
+// payload_b64 只编码 *payload*（不含 USB 帧头/CRC），与协议约定一致。
+static void mqtt_publish_payload(uint8_t sensor_type, uint8_t sensor_id,
+                                 const uint8_t *payload, uint16_t len) {
+    if (!s_mqtt_connected || s_mqtt_client == NULL) {
+        return;
+    }
+
+    const char *kind = (sensor_type == SENSOR_TYPE_MLX) ? "mlx" :
+                       (sensor_type == SENSOR_TYPE_TOF) ? "tof" : "unk";
+    // topic = "{room}{bed}{kind}{id}"
+    char topic[64];
+    int n = snprintf(topic, sizeof(topic), "%s%s%s%u",
+                     s_device_config.room, s_device_config.bed, kind, (unsigned)sensor_id);
+    if (n < 0 || (size_t)n >= sizeof(topic)) {
+        ESP_LOGW(NET_TAG, "topic too long, skip publish");
+        return;
+    }
+    lower_copy(topic, sizeof(topic), topic);
+
+    // base64 编码 (输出最长 4*ceil(len/3)+1)
+    size_t b64_len = ((size_t)len + 2) / 3 * 4 + 1;
+    size_t json_len = b64_len + 32;
+    char *b64 = (char *)malloc(b64_len);
+    char *json = (char *)malloc(json_len);
+    if (b64 == NULL || json == NULL) {
+        free(b64);
+        free(json);
+        ESP_LOGW(NET_TAG, "publish OOM");
+        return;
+    }
+
+    size_t out_len = 0;
+    if (mbedtls_base64_encode((unsigned char *)b64, b64_len, &out_len,
+                              payload, len) != 0) {
+        free(b64);
+        free(json);
+        ESP_LOGW(NET_TAG, "base64 encode failed");
+        return;
+    }
+    b64[out_len] = '\0';
+
+    int jn = snprintf(json, json_len, "{\"payload_b64\":\"%s\"}", b64);
+    if (jn < 0 || (size_t)jn >= json_len) {
+        free(b64);
+        free(json);
+        ESP_LOGW(NET_TAG, "json build truncated");
+        return;
+    }
+
+    int msg_id = esp_mqtt_client_publish(s_mqtt_client, topic, json, jn,
+                                         0 /* QoS0 */, 0 /* retain off */);
+    free(b64);
+    free(json);
+    if (msg_id < 0) {
+        ESP_LOGW(NET_TAG, "publish failed topic=%s rc=%d", topic, msg_id);
+    }
+}
