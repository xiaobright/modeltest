+def _ensure_column(conn, table: str, column: str, definition: str, default_expr: str | None = None):
+    cols = [row["name"].lower() for row in conn.execute(f'PRAGMA table_info("{table}")').fetchall()]
+    if column.lower() in cols:
+        return
+    sql = f'ALTER TABLE "{table}" ADD COLUMN {column} {definition}'
+    if default_expr is not None:
+        sql += f' DEFAULT {default_expr}'
+    conn.execute(sql)
+
