+def fetch_current_session(timeout: float | None = None) -> Optional[dict]:
+    """Fetch the current v3 identity session from the gateway.
+
+    Voice must carry an explicit session_id so that tightened authorization
+    is applied server-side rather than relying on a silent ambient session
+    that could either leak data when it should be denied or drop context
+    when it should be allowed.
+    """
