+        r.raise_for_status()
+        obj = r.json()
+        if isinstance(obj, dict):
+            return obj.get("session")
+    except Exception as e:  # noqa: BLE001
+        print(f"[GATEWAY当前会话获取失败] {e}")
+    return None
+
