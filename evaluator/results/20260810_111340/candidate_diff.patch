+// 启动 Wi-Fi STA (blocking until got IP, then starts MQTT)
+static void wifi_init_sta(void) {
+    if (s_device_config.wifi_ssid[0] == '\0') {
+        ESP_LOGW(NET_TAG, "No WiFi SSID configured, network backhaul disabled");
+        return;
+    }
+    ESP_LOGI(NET_TAG, "Init WiFi STA ssid=%s", s_device_config.wifi_ssid);
+
+    if (s_net_lock == NULL) {
+        s_net_lock = xSemaphoreCreateMutexStatic(&s_net_lock_stack);
+    }
+
+    ESP_ERROR_CHECK(esp_netif_init());
+    esp_netif_create_default_wifi_sta();
+    wifi_init_config_t cfg = WIFI_INIT_CONFIG_DEFAULT();
+    ESP_ERROR_CHECK(esp_wifi_init(&cfg));
+
+    ESP_ERROR_CHECK(esp_event_handler_instance_register(
+        WIFI_EVENT, ESP_EVENT_ANY_ID, &wifi_event_handler, NULL, NULL));
+    ESP_ERROR_CHECK(esp_event_handler_instance_register(
+        IP_EVENT, IP_EVENT_STA_GOT_IP, &wifi_event_handler, NULL, NULL));
+
+    wifi_config_t sta_cfg = {};
+    memcpy(sta_cfg.sta.ssid, s_device_config.wifi_ssid,
+           sizeof(s_device_config.wifi_ssid));
+    memcpy(sta_cfg.sta.password, s_device_config.wifi_password,
+           sizeof(s_device_config.wifi_password));
+    if (s_device_config.wifi_password[0] == '\0') {
+        sta_cfg.sta.threshold.authmode = WIFI_AUTH_OPEN;
+    }
+
+    ESP_ERROR_CHECK(esp_wifi_set_mode(WIFI_MODE_STA));
+    ESP_ERROR_CHECK(esp_wifi_set_config(WIFI_IF_STA, &sta_cfg));
+    ESP_ERROR_CHECK(esp_wifi_start());
+    ESP_ERROR_CHECK(esp_wifi_connect());
+    ESP_LOGI(NET_TAG, "WiFi connect started");
+}
+
+// 启动 MQTT 客户端 (bemfa.com:9501)，client_id 采用 bemfa_uid
+static void mqtt_start_blocking(void) {
+    if (s_device_config.bemfa_uid[0] == '\0') {
+        ESP_LOGW(NET_TAG, "No BEMFA UID configured, MQTT disabled");
+        return;
+    }
+    if (s_mqtt_client != NULL) {
+        ESP_LOGI(NET_TAG, "MQTT already initialized");
+        return;
+    }
+
+    char client_id[128];
+    const char *did = s_device_config.device_id[0] ? s_device_config.device_id : "stdpro";
+    // bemfa_uid/did are fixed arrays; explicitly truncate uid so client_id
+    // ("<uid>_<did>\0") never overflows the 128-byte buffer.
+    size_t did_len = strnlen(did, 47);
+    size_t uid_len = strnlen(s_device_config.bemfa_uid, 95);
+    size_t uid_room = sizeof(client_id) > did_len + 1 ? (sizeof(client_id) - did_len - 1) : 1;
+    if (uid_len > uid_room) uid_len = uid_room;
+    memcpy(client_id, s_device_config.bemfa_uid, uid_len);
+    client_id[uid_len] = '_';
+    memcpy(client_id + uid_len + 1, did, did_len);
+    client_id[uid_len + 1 + did_len] = '\0';
+
+    esp_mqtt_client_config_t mqtt_cfg = {};
+    mqtt_cfg.broker.address.hostname = s_device_config.bemfa_host;
+    mqtt_cfg.broker.address.port = (uint32_t)s_device_config.bemfa_mqtt_port;
+    mqtt_cfg.broker.address.transport = MQTT_TRANSPORT_OVER_TCP;
+    mqtt_cfg.credentials.client_id = client_id;
+    mqtt_cfg.buffer.size = 1024;
+    mqtt_cfg.buffer.out_size = 1024;
+    s_mqtt_client = esp_mqtt_client_init(&mqtt_cfg);
+    if (s_mqtt_client == NULL) {
+        ESP_LOGE(NET_TAG, "mqtt client init failed");
+        return;
+    }
+    ESP_ERROR_CHECK(esp_mqtt_client_register_event(
+        s_mqtt_client, MQTT_EVENT_ANY, &mqtt_event_handler, NULL));
+    ESP_ERROR_CHECK(esp_mqtt_client_start(s_mqtt_client));
+    ESP_LOGI(NET_TAG, "MQTT start requested, uid=%s",
+             s_device_config.bemfa_uid[0] ? "***" : "(empty)");
+}
+
+// 停止网络回传
+static void network_backhaul_stop(void) {
+    if (s_mqtt_client != NULL) {
+        esp_mqtt_client_stop(s_mqtt_client);
+        esp_mqtt_client_destroy(s_mqtt_client);
+        s_mqtt_client = NULL;
+    }
+    s_mqtt_connected = false;
+    s_wifi_connected = false;
+}
 
