+def fetch_current_session() -> Optional[str]:
+    """Fetch the current session_id from the gateway.
+
+    Voice calls this explicitly so the chat-context request carries a real
+    session_id rather than depending on the gateway's implicit
+    get_current_session() fallback. After the v3 auth tightening, that ambient
+    fallback would deny sensitive patient context; resolving the session here
+    keeps voice working when a recognized session exists, and cleanly returns a
+    denial prompt when none does. Returns the session_id string or None.
+    """
+    if not GATEWAY_CONTEXT_ENABLED:
+        return None
+    try:
+        r = requests.get(GATEWAY_SESSION_CURRENT_URL, timeout=GATEWAY_TIMEOUT_S)
+        r.raise_for_status()
+        obj = r.json()
+        if isinstance(obj, dict):
+            sess = obj.get("session") or {}
+            if isinstance(sess, dict):
+                return str(sess.get("session_id") or "")
+    except Exception as e:  # noqa: BLE001
+        print(f"[GATEWAY当前会话获取失败] {e}")
+    return None
+
