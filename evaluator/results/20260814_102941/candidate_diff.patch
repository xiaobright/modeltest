+def _ensure_column(conn, table: str, column: str, declaration: str) -> None:
+    cols = {str(r[1]) for r in conn.execute(f"PRAGMA table_info({table})").fetchall()}
+    if column not in cols:
+        conn.execute(f"ALTER TABLE {table} ADD COLUMN {column} {declaration}")
+
+
+def _migrate_management_db(conn) -> None:
+    """Upgrade older SQLite schemas without dropping existing rows."""
+    _ensure_column(conn, "care_events", "severity", "TEXT NOT NULL DEFAULT 'info'")
