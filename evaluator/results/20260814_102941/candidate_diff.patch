+    _ensure_column(conn, "care_events", "ts", "INTEGER NOT NULL DEFAULT 0")
+    # If legacy rows only have created_ts, use it as the event timestamp.
+    conn.execute(
+        "UPDATE care_events SET ts = created_ts WHERE ts IS NULL OR ts = 0"
