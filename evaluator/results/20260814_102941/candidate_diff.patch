+static void mqtt_publish_payload(const char *stream_suffix, const uint8_t *payload, size_t len) {
+    if (!s_device_config_ready || s_mqtt_client == NULL || payload == NULL || len == 0) {
+        return;
+    }
+
+    bool connected = false;
+    if (s_mqtt_lock != NULL && xSemaphoreTake(s_mqtt_lock, pdMS_TO_TICKS(2)) == pdTRUE) {
+        connected = s_mqtt_connected;
+        xSemaphoreGive(s_mqtt_lock);
+    }
+    if (!connected) {
+        return;
+    }
+
+    char room_l[16];
+    char bed_l[16];
+    lower_copy(room_l, sizeof(room_l), s_device_config.room);
+    lower_copy(bed_l, sizeof(bed_l), s_device_config.bed);
+    char topic[64];
+    snprintf(topic, sizeof(topic), "%s%s%s", room_l, bed_l, stream_suffix);
+
+    size_t b64_len = 0;
+    int rc = mbedtls_base64_encode(NULL, 0, &b64_len, payload, len);
+    if (rc != MBEDTLS_ERR_BASE64_BUFFER_TOO_SMALL && rc != 0) {
+        ESP_LOGW(TAG, "base64 length calc failed: %d", rc);
+        return;
+    }
+    char *b64 = (char *)malloc(b64_len + 1);
+    if (b64 == NULL) {
+        ESP_LOGE(TAG, "MQTT b64 alloc failed (%u bytes)", (unsigned)(b64_len + 1));
+        return;
+    }
+    size_t olen = 0;
+    rc = mbedtls_base64_encode((unsigned char *)b64, b64_len + 1, &olen, payload, len);
+    if (rc != 0) {
+        ESP_LOGW(TAG, "base64 encode failed: %d", rc);
+        free(b64);
+        return;
+    }
+    b64[olen] = '\0';
+
+    size_t json_len = strlen(b64) + 64;
+    char *json = (char *)malloc(json_len);
+    if (json == NULL) {
+        free(b64);
+        ESP_LOGE(TAG, "MQTT json alloc failed");
+        return;
+    }
+    snprintf(json, json_len, "{\"payload_b64\":\"%s\"}", b64);
+    int msg_id = esp_mqtt_client_publish(s_mqtt_client, topic, json, 0, 0, 0);
+    if (msg_id < 0) {
+        ESP_LOGW(TAG, "MQTT publish failed for %s", topic);
+    }
+    free(json);
+    free(b64);
+}
+
+static void wifi_event_handler(void *arg, esp_event_base_t event_base,
+                               int32_t event_id, void *event_data) {
+    (void)arg;
+    if (event_base == WIFI_EVENT && event_id == WIFI_EVENT_STA_START) {
+        esp_wifi_connect();
+    } else if (event_base == WIFI_EVENT && event_id == WIFI_EVENT_STA_DISCONNECTED) {
+        ESP_LOGW(TAG, "WiFi disconnected, retrying...");
+        if (s_wifi_event_group != NULL) {
+            xEventGroupClearBits(s_wifi_event_group, WIFI_CONNECTED_BIT);
+        }
+        esp_wifi_connect();
+    } else if (event_base == IP_EVENT && event_id == IP_EVENT_STA_GOT_IP) {
+        ip_event_got_ip_t *event = (ip_event_got_ip_t *)event_data;
+        ESP_LOGI(TAG, "WiFi connected, IP=" IPSTR, IP2STR(&event->ip_info.ip));
+        if (s_wifi_event_group != NULL) {
+            xEventGroupSetBits(s_wifi_event_group, WIFI_CONNECTED_BIT);
+        }
+    }
+}
+
+static void mqtt_event_handler(void *handler_args, esp_event_base_t base,
+                               int32_t event_id, void *event_data) {
+    (void)handler_args;
+    (void)base;
+    esp_mqtt_event_handle_t event = (esp_mqtt_event_handle_t)event_data;
+    switch ((esp_mqtt_event_id_t)event_id) {
+        case MQTT_EVENT_CONNECTED:
+            ESP_LOGI(TAG, "MQTT connected to bemfa.com");
+            if (s_mqtt_lock != NULL) {
+                xSemaphoreTake(s_mqtt_lock, portMAX_DELAY);
+                s_mqtt_connected = true;
+                xSemaphoreGive(s_mqtt_lock);
+            } else {
+                s_mqtt_connected = true;
+            }
+            ESP_LOGI(TAG, "MQTT topics: %s%s%s / %s%s%s / %s%s%s / %s%s%s",
+                     s_device_config.room, s_device_config.bed, "tof1",
+                     s_device_config.room, s_device_config.bed, "tof2",
+                     s_device_config.room, s_device_config.bed, "mlx1",
+                     s_device_config.room, s_device_config.bed, "mlx2");
+            break;
+        case MQTT_EVENT_DISCONNECTED:
+            ESP_LOGW(TAG, "MQTT disconnected");
+            if (s_mqtt_lock != NULL) {
+                xSemaphoreTake(s_mqtt_lock, portMAX_DELAY);
+                s_mqtt_connected = false;
+                xSemaphoreGive(s_mqtt_lock);
+            } else {
+                s_mqtt_connected = false;
+            }
+            break;
+        default:
+            break;
+    }
+}
+
+static void start_wifi_and_mqtt(void) {
+    if (!s_device_config_ready) {
+        ESP_LOGW(TAG, "Config incomplete, Wi-Fi/MQTT backhaul disabled");
+        return;
+    }
+
+    if (s_wifi_event_group == NULL) {
+        s_wifi_event_group = xEventGroupCreate();
+    }
+    if (s_mqtt_lock == NULL) {
+        s_mqtt_lock = xSemaphoreCreateMutex();
+    }
+
+    ESP_ERROR_CHECK(esp_netif_init());
+    ESP_ERROR_CHECK(esp_event_loop_create_default());
+    esp_netif_create_default_wifi_sta();
+
+    wifi_init_config_t wifi_cfg = WIFI_INIT_CONFIG_DEFAULT();
+    ESP_ERROR_CHECK(esp_wifi_init(&wifi_cfg));
+    ESP_ERROR_CHECK(esp_event_handler_register(WIFI_EVENT, ESP_EVENT_ANY_ID, &wifi_event_handler, NULL));
+    ESP_ERROR_CHECK(esp_event_handler_register(IP_EVENT, IP_EVENT_STA_GOT_IP, &wifi_event_handler, NULL));
+
+    wifi_config_t wifi_config = {};
+    strncpy((char *)wifi_config.sta.ssid, s_device_config.wifi_ssid,
+            sizeof(wifi_config.sta.ssid) - 1);
+    strncpy((char *)wifi_config.sta.password, s_device_config.wifi_password,
+            sizeof(wifi_config.sta.password) - 1);
+    wifi_config.sta.threshold.authmode = WIFI_AUTH_WPA2_PSK;
+
+    ESP_ERROR_CHECK(esp_wifi_set_mode(WIFI_MODE_STA));
+    ESP_ERROR_CHECK(esp_wifi_set_config(WIFI_IF_STA, &wifi_config));
+    ESP_ERROR_CHECK(esp_wifi_start());
+
+    ESP_LOGI(TAG, "WiFi+MQTT init done, MQTT target=%s:%u",
+             s_device_config.bemfa_host, (unsigned)s_device_config.bemfa_mqtt_port);
+
+    // Wait for IP before starting MQTT, but do not block forever.
+    if (s_wifi_event_group != NULL) {
+        xEventGroupWaitBits(s_wifi_event_group, WIFI_CONNECTED_BIT,
+                            pdFALSE, pdFALSE, pdMS_TO_TICKS(20000));
+    }
+
+    esp_mqtt_client_config_t mqtt_cfg = {};
+    mqtt_cfg.broker.address.hostname = s_device_config.bemfa_host;
+    mqtt_cfg.broker.address.port = s_device_config.bemfa_mqtt_port;
+    mqtt_cfg.broker.address.transport = MQTT_TRANSPORT_OVER_TCP;
+    mqtt_cfg.credentials.client_id = s_device_config.bemfa_uid;
+    mqtt_cfg.session.keepalive = 60;
+    // ToF raw payload is ~10KB -> base64 JSON can exceed 13KB; use a large outbox/buffer.
+    mqtt_cfg.buffer.size = 20480;
+    mqtt_cfg.buffer.out_size = 20480;
+    mqtt_cfg.outbox.limit = 4 * 20480;
+
+    s_mqtt_client = esp_mqtt_client_init(&mqtt_cfg);
+    if (s_mqtt_client == NULL) {
+        ESP_LOGE(TAG, "MQTT client init failed");
+        return;
+    }
+    esp_mqtt_client_register_event(s_mqtt_client, MQTT_EVENT_ANY, mqtt_event_handler, NULL);
+    ESP_ERROR_CHECK(esp_mqtt_client_start(s_mqtt_client));
+}
