+static int base64_encode(const uint8_t *src, size_t src_len, char *dst, size_t dst_len) {
+    size_t olen = 0;
+    int ret = mbedtls_base64_encode((unsigned char*)dst, dst_len, &olen, src, src_len);
+    if (ret == 0) {
+        return (int)olen;
+    }
+    return -1;
+}
 
