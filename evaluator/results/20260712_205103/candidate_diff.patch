-                    memmove(parser->buffer, &parser->buffer[i], remaining);
-                    parser->buffer_len = remaining;
-                }
-                return 0;
-            }
-            
-            // 读取数据长度（小端序）
-            uint16_t data_len = parser->buffer[i + 2] | (parser->buffer[i + 3] << 8);
