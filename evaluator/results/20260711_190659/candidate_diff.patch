+def fetch_current_session() -> Optional[str]:
+    """Fetch the current gateway session id so we can pass it explicitly.
+
+    Without this the gateway would fall back to its implicit ambient session,
+    which after the auth tightening will be denied for sensitive context.
+    Returns the session_id string, or None if unavailable.
+    """
+    try:
+        r = requests.get(GATEWAY_SESSION_CURRENT_URL, timeout=GATEWAY_TIMEOUT_S)
+        r.raise_for_status()
+        obj = r.json()
+        sess = obj.get("session") if isinstance(obj, dict) else None
+        if isinstance(sess, dict) and sess.get("session_id"):
+            return str(sess["session_id"])
+    except Exception as e:  # noqa: BLE001
+        print(f"[GATEWAY当前会话获取失败] {e}")
+    return None
+
