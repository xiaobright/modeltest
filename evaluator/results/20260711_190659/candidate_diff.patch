+def _migrate_care_events(conn):
+    """Migrate legacy care_events tables: add missing columns while preserving data.
+
+    Legacy tables may only have event_id/subject_id/room/bed/kind/title/content/
+    created_ts/updated_ts.  This adds severity/source/created_by/ts with safe
+    defaults and back-fills ts from created_ts for old rows.
+    """
+    cols = {row["name"] for row in conn.execute("PRAGMA table_info(care_events)").fetchall()}
+    if not cols:
+        return
+    if "severity" not in cols:
+        conn.execute("ALTER TABLE care_events ADD COLUMN severity TEXT NOT NULL DEFAULT 'info'")
+    if "source" not in cols:
+        conn.execute("ALTER TABLE care_events ADD COLUMN source TEXT NOT NULL DEFAULT 'manual'")
+    if "created_by" not in cols:
+        conn.execute("ALTER TABLE care_events ADD COLUMN created_by TEXT NOT NULL DEFAULT ''")
+    if "ts" not in cols:
+        conn.execute("ALTER TABLE care_events ADD COLUMN ts INTEGER NOT NULL DEFAULT 0")
+        conn.execute(
+            "UPDATE care_events SET ts = created_ts WHERE ts = 0 OR ts IS NULL"
+        )
+
