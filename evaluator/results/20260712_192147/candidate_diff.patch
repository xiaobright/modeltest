+def _migrate_care_events(conn):
+    """Upgrade the known legacy care_events schema without replacing old rows."""
+    columns = {row['name'] for row in conn.execute('PRAGMA table_info(care_events)').fetchall()}
+    additions = {
+        'severity': "TEXT NOT NULL DEFAULT 'info'",
+        'source': "TEXT NOT NULL DEFAULT 'manual'",
+        'created_by': "TEXT NOT NULL DEFAULT ''",
+        'ts': "INTEGER NOT NULL DEFAULT 0",
+    }
+    for name, declaration in additions.items():
+        if name not in columns:
+            conn.execute(f'ALTER TABLE care_events ADD COLUMN {name} {declaration}')
+    conn.execute("UPDATE care_events SET severity = 'info' WHERE severity IS NULL OR severity = ''")
+    conn.execute("UPDATE care_events SET source = 'manual' WHERE source IS NULL OR source = ''")
+    conn.execute('UPDATE care_events SET ts = created_ts WHERE ts IS NULL OR ts <= 0')
+    conn.execute(
+        'CREATE INDEX IF NOT EXISTS idx_care_events_subject_ts ON care_events(subject_id, ts DESC, created_ts DESC)'
+    )
+    conn.execute(
+        'CREATE INDEX IF NOT EXISTS idx_care_events_room_bed_ts ON care_events(room, bed, ts DESC, created_ts DESC)'
+    )
+
+
+def _migrate_legacy_admin_passwords(conn):
+    """Replace the pre-auth-fix plaintext password_hash rows in place."""
+    rows = conn.execute(
+        "SELECT username, password_hash FROM admin_accounts WHERE salt IS NULL OR salt = ''"
+    ).fetchall()
+    for row in rows:
+        legacy_password = str(row['password_hash'] or '')
+        if not legacy_password:
+            continue
+        salt = secrets.token_bytes(16)
+        digest = hashlib.pbkdf2_hmac('sha256', legacy_password.encode('utf-8'), salt, 200_000)
+        conn.execute(
+            'UPDATE admin_accounts SET password_hash = ?, salt = ?, updated_ts = ? WHERE username = ?',
+            (digest.hex(), salt.hex(), now_ms(), row['username']),
+        )
+
