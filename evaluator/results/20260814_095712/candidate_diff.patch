+def _migrate_legacy_admin_passwords(conn) -> None:
+    """Re-hash early-build admin rows that stored the password in plaintext.
+
+    The original broken seed wrote ``salt=''`` and ``password_hash=<plain
+    password>``.  Treat that legacy value as the password input once, then
+    replace it with a random salt + PBKDF2-SHA256 digest.
+    """
+    rows = conn.execute(
+        "SELECT username, password_hash FROM admin_accounts WHERE salt = ''"
+    ).fetchall()
+    for row in rows:
+        legacy_password = str(row["password_hash"] or "")
+        if not legacy_password:
+            continue
+        salt = secrets.token_bytes(16)
+        digest = hashlib.pbkdf2_hmac(
+            "sha256", legacy_password.encode("utf-8"), salt, 200_000
+        )
+        conn.execute(
+            """
+            UPDATE admin_accounts
+               SET salt = ?, password_hash = ?, updated_ts = ?
+             WHERE username = ?
+            """,
+            (salt.hex(), digest.hex(), now_ms(), row["username"]),
+        )
+
+
+def _ensure_column(conn, table: str, column: str, definition: str) -> None:
+    existing = {
+        str(row["name"])
+        for row in conn.execute(f"PRAGMA table_info({table})").fetchall()
+    }
+    if column not in existing:
+        conn.execute(f"ALTER TABLE {table} ADD COLUMN {column} {definition}")
+
+
+def init_care_events_schema(conn) -> None:
+    """Create or migrate the care_events table without losing legacy rows.
+
+    ``CREATE TABLE IF NOT EXISTS`` is intentionally followed by explicit
+    ``PRAGMA table_info`` checks: historical SQLite files may already contain
+    the early draft table with only a subset of the v3 columns.
+    """
+    conn.execute(
+        """
+        CREATE TABLE IF NOT EXISTS care_events (
+            event_id TEXT PRIMARY KEY,
+            subject_id TEXT NOT NULL,
+            room TEXT NOT NULL,
+            bed TEXT NOT NULL,
+            kind TEXT NOT NULL,
+            title TEXT NOT NULL DEFAULT '',
+            content TEXT NOT NULL DEFAULT '',
+            severity TEXT NOT NULL DEFAULT 'info',
+            source TEXT NOT NULL DEFAULT 'manual',
+            created_by TEXT NOT NULL DEFAULT '',
+            ts INTEGER NOT NULL DEFAULT 0,
+            created_ts INTEGER NOT NULL DEFAULT 0,
+            updated_ts INTEGER NOT NULL DEFAULT 0
+        )
+        """
+    )
+
+    columns = {
+        "subject_id": "TEXT NOT NULL DEFAULT ''",
+        "room": "TEXT NOT NULL DEFAULT ''",
+        "bed": "TEXT NOT NULL DEFAULT ''",
+        "kind": "TEXT NOT NULL DEFAULT 'note'",
+        "title": "TEXT NOT NULL DEFAULT ''",
+        "content": "TEXT NOT NULL DEFAULT ''",
+        "severity": "TEXT NOT NULL DEFAULT 'info'",
+        "source": "TEXT NOT NULL DEFAULT 'manual'",
+        "created_by": "TEXT NOT NULL DEFAULT ''",
+        "ts": "INTEGER NOT NULL DEFAULT 0",
+        "created_ts": "INTEGER NOT NULL DEFAULT 0",
+        "updated_ts": "INTEGER NOT NULL DEFAULT 0",
+    }
+    for column, definition in columns.items():
+        _ensure_column(conn, "care_events", column, definition)
+
+    # Old rows may predate the timestamp contract or the normalization rule.
+    conn.execute("UPDATE care_events SET ts = created_ts WHERE ts IS NULL OR ts <= 0")
+    conn.execute("UPDATE care_events SET created_ts = ts WHERE created_ts IS NULL OR created_ts <= 0")
+    conn.execute("UPDATE care_events SET updated_ts = created_ts WHERE updated_ts IS NULL OR updated_ts <= 0")
+    conn.execute(
+        "UPDATE care_events SET room = UPPER(TRIM(room)), bed = UPPER(TRIM(bed)) "
+        "WHERE room IS NOT NULL AND bed IS NOT NULL"
+    )
+    conn.execute(
+        "UPDATE care_events SET severity = 'info' WHERE severity IS NULL OR TRIM(severity) = ''"
+    )
+    conn.execute(
+        "UPDATE care_events SET source = 'manual' WHERE source IS NULL OR TRIM(source) = ''"
+    )
+    conn.execute(
