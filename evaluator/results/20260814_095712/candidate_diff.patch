+def fetch_current_gateway_session() -> Optional[dict]:
+    """Fetch the current local actor session, then pass it explicitly below.
+
+    Voice must not rely on the gateway silently substituting an ambient
+    session.  If no reliable session is available this returns None and the
+    context request is intentionally sent without one, so the gateway denies
+    access instead of leaking patient data.
+    """
+    try:
+        r = requests.get(GATEWAY_CURRENT_SESSION_URL, timeout=GATEWAY_TIMEOUT_S)
+        r.raise_for_status()
+        obj = r.json()
+        if isinstance(obj, dict):
+            session = obj.get("session") if isinstance(obj.get("session"), dict) else None
+            if session and str(session.get("session_id") or "").strip():
+                return session
+    except Exception as e:  # noqa: BLE001
+        print(f"[GATEWAY当前会话获取失败] {e}")
+    return None
+
+
+def resolve_gateway_session_id(explicit_session_id=None) -> str:
+    sid = (explicit_session_id if explicit_session_id is not None else VOICE_SESSION_ID).strip()
+    if sid:
+        return sid
+    current = fetch_current_gateway_session()
+    if not current:
+        return ""
+    return str(current.get("session_id") or "").strip()
+
