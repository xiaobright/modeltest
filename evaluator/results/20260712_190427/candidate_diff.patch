+def _migrate_legacy_admin_passwords(conn):
+    rows = conn.execute(
+        "SELECT username, password_hash FROM admin_accounts WHERE salt IS NULL OR salt = ''"
+    ).fetchall()
+    for row in rows:
+        salt = secrets.token_bytes(16)
+        digest = hashlib.pbkdf2_hmac(
+            'sha256', str(row['password_hash']).encode('utf-8'), salt, 200_000
+        )
+        conn.execute(
+            'UPDATE admin_accounts SET password_hash = ?, salt = ?, updated_ts = ? WHERE username = ?',
