+            conn.execute(f'ALTER TABLE care_events ADD COLUMN {name} {declaration}')
+    conn.execute("UPDATE care_events SET ts = created_ts WHERE ts IS NULL OR ts <= 0")
+    conn.execute('CREATE INDEX IF NOT EXISTS idx_care_events_ts ON care_events(ts DESC)')
