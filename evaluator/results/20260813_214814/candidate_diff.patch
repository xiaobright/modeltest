+def table_columns(conn, table: str) -> set:
+    rows = conn.execute(f"PRAGMA table_info({table})").fetchall()
+    return {str(r["name"]) for r in rows}
+
+
+def ensure_columns(conn, table: str, column_specs: dict) -> None:
+    """Add missing columns to a legacy table without touching existing rows.
+
+    `CREATE TABLE IF NOT EXISTS` only handles brand-new databases; historical
+    SQLite files may already contain an older version of the table. Table and
+    column names come from internal schema constants only (never from user
+    input), so f-string interpolation here is not an injection surface.
+    """
+    existing = table_columns(conn, table)
+    for column, ddl in column_specs.items():
+        if column not in existing:
+            conn.execute(f"ALTER TABLE {table} ADD COLUMN {column} {ddl}")
+
+
+def init_care_events_table(conn) -> None:
+    """Create or migrate the care_events table.
+
+    Older databases may already have a care_events table that lacks
+    severity / source / created_by / ts. Those columns are appended in place
+    and the legacy rows are kept, backfilling ts from created_ts.
+    """
+    conn.executescript(
+        """
+        CREATE TABLE IF NOT EXISTS care_events (
+            event_id TEXT PRIMARY KEY,
+            subject_id TEXT NOT NULL,
+            room TEXT NOT NULL,
+            bed TEXT NOT NULL,
+            kind TEXT NOT NULL,
+            title TEXT NOT NULL DEFAULT '',
+            content TEXT NOT NULL DEFAULT '',
+            severity TEXT NOT NULL DEFAULT 'info',
+            source TEXT NOT NULL DEFAULT 'manual',
+            created_by TEXT NOT NULL DEFAULT '',
+            ts INTEGER NOT NULL DEFAULT 0,
+            created_ts INTEGER NOT NULL,
+            updated_ts INTEGER NOT NULL
+        );
+        """
+    )
+    ensure_columns(
