+// 将原始传感器 payload（不是完整 USB packet）镜像发布到对应 MQTT topic。
+static void network_publish_sensor_payload(uint8_t sensor_type, uint8_t sensor_id,
+                                           const uint8_t *payload, size_t len) {
+    if (!s_mqtt_connected || s_mqtt_client == NULL || payload == NULL || len == 0) {
+        return;
+    }
+    char topic[DEVICE_CONFIG_TOPIC_MAX];
+    if (!device_config_build_topic(&s_device_config, sensor_type, sensor_id,
+                                   topic, sizeof(topic))) {
+        return;
+    }
+    size_t json_len = 0;
+    char *json = mqtt_payload_build_json(payload, len, &json_len);
+    if (json == NULL) {
+        s_mqtt_publish_fail++;
+        ESP_LOGW(TAG, "MQTT payload_b64 build failed (len=%u)", (unsigned)len);
+        return;
+    }
+    int msg_id = esp_mqtt_client_publish(s_mqtt_client, topic, json, (int)json_len, 0, 0);
+    if (msg_id < 0) {
+        s_mqtt_publish_fail++;
+    } else {
+        s_mqtt_publish_ok++;
+    }
+    free(json);
+}
