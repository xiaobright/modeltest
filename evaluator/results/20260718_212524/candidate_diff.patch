+def fetch_current_session() -> Optional[dict]:
+    """显式向 gateway 查询当前识别会话（GET /api/v3/session/current）。
+
+    返回 session dict（含 session_id / identity_state / expires_ts 等），
+    没有可用会话或请求失败时返回 None。
+    """
+    try:
+        r = requests.get(GATEWAY_SESSION_CURRENT_URL, timeout=GATEWAY_TIMEOUT_S)
+        r.raise_for_status()
+        obj = r.json()
+        session = obj.get("session") if isinstance(obj, dict) else None
+        if isinstance(session, dict) and str(session.get("session_id") or ""):
+            return session
+    except Exception as e:  # noqa: BLE001
+        print(f"[GATEWAY当前会话获取失败] {e}")
+    return None
+
+
+def resolve_session_id() -> str:
+    """优先使用显式 VOICE_SESSION_ID，否则调用 fetch_current_session 获取。
+
+    结果做短暂缓存，避免每条语音都多打一次 HTTP。
+    """
+    if VOICE_SESSION_ID:
+        return VOICE_SESSION_ID
+    now = time.time()
+    if _session_cache["session_id"] and (now - _session_cache["checked_at"]) < SESSION_REFRESH_MIN_INTERVAL_S:
+        return _session_cache["session_id"]
+    session = fetch_current_session()
+    _session_cache["session_id"] = str(session.get("session_id")) if session else ""
+    _session_cache["checked_at"] = now
+    return _session_cache["session_id"]
+
