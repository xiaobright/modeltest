+static void start_mqtt_client(void) {
+    if (s_mqtt_client != NULL) {
+        return;
+    }
+    esp_mqtt_client_config_t cfg = {};
+    cfg.broker.address.hostname = s_device_config.bemfa_host;
+    cfg.broker.address.port = s_device_config.bemfa_mqtt_port;
+    cfg.broker.address.transport = MQTT_TRANSPORT_OVER_TCP;
+    // 巴法云契约：ClientID 即用户私钥 UID
+    cfg.credentials.client_id = s_device_config.bemfa_uid;
+    cfg.session.keepalive = 60;
+    cfg.network.reconnect_timeout_ms = 5000;
+    cfg.buffer.size = 4096;
+    // 完整 ToF payload_b64 JSON 约 13.4 KB；出站缓冲必须能容纳，
+    // 小的固定栈缓冲（如 char b64_buf[256]）在这里是经典错误。
+    cfg.buffer.out_size = 20480;
+
+    s_mqtt_client = esp_mqtt_client_init(&cfg);
+    if (s_mqtt_client == NULL) {
+        ESP_LOGE(TAG, "MQTT client init failed");
+        return;
+    }
+    ESP_ERROR_CHECK(esp_mqtt_client_register_event(
+        s_mqtt_client, (esp_mqtt_event_id_t)ESP_EVENT_ANY_ID, mqtt_event_handler, NULL));
+    ESP_ERROR_CHECK(esp_mqtt_client_start(s_mqtt_client));
+    ESP_LOGI(TAG, "MQTT client started (broker=%s:%u)",
