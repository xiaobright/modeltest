-                // 复制完整帧
-                memcpy(frame_out, &parser->buffer[i], frame_len);
-                
-                // 移除已处理的数据
-                uint32_t remaining = parser->buffer_len - (i + frame_len);
-                if (remaining > 0) {
-                    memmove(parser->buffer, &parser->buffer[i + frame_len], remaining);
-                }
-                parser->buffer_len = remaining;
-                parser->frames_parsed++;
