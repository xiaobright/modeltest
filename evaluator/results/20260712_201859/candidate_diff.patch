+static void wifi_init_sta(const char* ssid, const char* pass)
+{
+    s_wifi_event_group = xEventGroupCreate();
+
+    ESP_ERROR_CHECK(esp_netif_init());
+    esp_err_t event_loop_err = esp_event_loop_create_default();
+    if (event_loop_err != ESP_OK && event_loop_err != ESP_ERR_INVALID_STATE) {
+        ESP_ERROR_CHECK(event_loop_err);
+    }
+    
+    esp_netif_t *sta_netif = esp_netif_get_handle_from_ifkey("WIFI_STA_DEF");
+    if (!sta_netif) {
+        sta_netif = esp_netif_create_default_wifi_sta();
+    }
+    (void)sta_netif;
+
+    wifi_init_config_t cfg = WIFI_INIT_CONFIG_DEFAULT();
+    ESP_ERROR_CHECK(esp_wifi_init(&cfg));
+
+    esp_event_handler_instance_t instance_any_id;
+    esp_event_handler_instance_t instance_got_ip;
+    ESP_ERROR_CHECK(esp_event_handler_instance_register(WIFI_EVENT,
+                                                        ESP_EVENT_ANY_ID,
+                                                        &wifi_event_handler,
+                                                        NULL,
+                                                        &instance_any_id));
+    ESP_ERROR_CHECK(esp_event_handler_instance_register(IP_EVENT,
+                                                        IP_EVENT_STA_GOT_IP,
+                                                        &wifi_event_handler,
+                                                        NULL,
+                                                        &instance_got_ip));
+
+    wifi_config_t wifi_config = {};
+    strncpy((char*)wifi_config.sta.ssid, ssid, sizeof(wifi_config.sta.ssid));
+    strncpy((char*)wifi_config.sta.password, pass, sizeof(wifi_config.sta.password));
+    wifi_config.sta.threshold.authmode = WIFI_AUTH_WPA2_PSK;
+
+    ESP_ERROR_CHECK(esp_wifi_set_mode(WIFI_MODE_STA));
+    ESP_ERROR_CHECK(esp_wifi_set_config(WIFI_IF_STA, &wifi_config));
+    ESP_ERROR_CHECK(esp_wifi_start());
+
+    ESP_LOGI(TAG, "wifi_init_sta finished.");
+}
+
+static void mqtt_event_handler(void *handler_args, esp_event_base_t base, int32_t event_id, void *event_data)
+{
+    (void)handler_args;
+    (void)base;
+    esp_mqtt_event_handle_t event = (esp_mqtt_event_handle_t)event_data;
+    (void)event;
+    switch ((esp_mqtt_event_id_t)event_id) {
+        case MQTT_EVENT_CONNECTED:
+            ESP_LOGI(TAG, "MQTT_EVENT_CONNECTED");
+            s_mqtt_connected = true;
+            break;
+        case MQTT_EVENT_DISCONNECTED:
+            ESP_LOGI(TAG, "MQTT_EVENT_DISCONNECTED");
+            s_mqtt_connected = false;
+            break;
+        default:
+            break;
+    }
+}
+
+static void mqtt_app_start(const char* host, uint16_t port, const char* client_id)
+{
+    esp_mqtt_client_config_t mqtt_cfg = {};
+#if ESP_IDF_VERSION >= ESP_IDF_VERSION_VAL(5, 0, 0)
+    mqtt_cfg.broker.address.hostname = host;
+    mqtt_cfg.broker.address.port = port;
+    mqtt_cfg.broker.address.transport = MQTT_TRANSPORT_OVER_TCP;
+    mqtt_cfg.credentials.client_id = client_id;
+#else
+    mqtt_cfg.host = host;
+    mqtt_cfg.port = port;
+    mqtt_cfg.client_id = client_id;
+#endif
+
+    s_mqtt_client = esp_mqtt_client_init(&mqtt_cfg);
+    esp_mqtt_client_register_event(s_mqtt_client, MQTT_EVENT_ANY, mqtt_event_handler, NULL);
+    esp_mqtt_client_start(s_mqtt_client);
+}
+
+static void mqtt_publish_sensor_payload(const char* stream_type, uint8_t src_id, const uint8_t *payload, uint16_t len) {
+    if (!s_mqtt_connected || s_mqtt_client == NULL) {
+        return;
+    }
+    
+    char room_lower[16];
+    char bed_lower[16];
+    lower_copy(room_lower, sizeof(room_lower), s_device_config.room);
+    lower_copy(bed_lower, sizeof(bed_lower), s_device_config.bed);
+    
+    char topic[64];
+    snprintf(topic, sizeof(topic), "%s%s%s%d", room_lower, bed_lower, stream_type, src_id);
+    
+    size_t b64_len_needed = (len * 4 / 3) + 10;
+    unsigned char *b64_buf = (unsigned char *)malloc(b64_len_needed);
+    if (b64_buf == NULL) {
+        ESP_LOGE(TAG, "Failed to allocate memory for base64 encoding");
+        return;
+    }
+    
+    size_t olen = 0;
+    int ret = mbedtls_base64_encode(b64_buf, b64_len_needed, &olen, payload, len);
+    if (ret != 0) {
+        ESP_LOGE(TAG, "Base64 encoding failed: %d", ret);
+        free(b64_buf);
+        return;
+    }
+    b64_buf[olen] = '\0';
+    
+    size_t json_len_needed = olen + 32;
+    char *json_buf = (char *)malloc(json_len_needed);
+    if (json_buf == NULL) {
+        ESP_LOGE(TAG, "Failed to allocate memory for JSON");
+        free(b64_buf);
+        return;
+    }
+    
+    snprintf(json_buf, json_len_needed, "{\"payload_b64\":\"%s\"}", (char*)b64_buf);
+    
+    int msg_id = esp_mqtt_client_publish(s_mqtt_client, topic, json_buf, 0, 0, 0);
+    if (msg_id < 0) {
+        ESP_LOGW(TAG, "MQTT publish failed for topic %s", topic);
+    }
+    
+    free(json_buf);
+    free(b64_buf);
+}
 
