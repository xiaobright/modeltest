+static void mqtt_publish_sensor_payload(const char *kind, int src_id, const uint8_t *payload, size_t len) {
+    if (!s_mqtt_client || !s_mqtt_connected) {
+        return;
+    }
+    
+    char topic[128];
+    get_mqtt_topic(topic, sizeof(topic), kind, src_id);
+    
+    size_t b64_len = 0;
+    mbedtls_base64_encode(NULL, 0, &b64_len, payload, len);
+    
+    unsigned char *b64_buf = (unsigned char *)malloc(b64_len + 1);
+    if (!b64_buf) {
+        ESP_LOGE("MQTT_UPLINK", "Failed to allocate base64 buffer of size %u", (unsigned int)b64_len);
+        return;
+    }
+    
+    size_t olen = 0;
+    int err = mbedtls_base64_encode(b64_buf, b64_len + 1, &olen, payload, len);
+    if (err != 0) {
+        ESP_LOGE("MQTT_UPLINK", "Base64 encoding failed: %d", err);
+        free(b64_buf);
+        return;
+    }
+    b64_buf[olen] = '\0';
+    
+    size_t json_len = olen + 64;
+    char *json_buf = (char *)malloc(json_len);
+    if (!json_buf) {
+        ESP_LOGE("MQTT_UPLINK", "Failed to allocate JSON buffer of size %u", (unsigned int)json_len);
+        free(b64_buf);
+        return;
+    }
+    
+    int formatted_len = snprintf(json_buf, json_len, "{\"payload_b64\":\"%s\"}", (char *)b64_buf);
+    
+    int msg_id = esp_mqtt_client_publish(s_mqtt_client, topic, json_buf, formatted_len, 0, 0);
+    if (msg_id < 0) {
+        ESP_LOGE("MQTT_UPLINK", "Failed to publish to MQTT topic %s", topic);
+    } else {
+        ESP_LOGD("MQTT_UPLINK", "Published to %s, msg_id=%d", topic, msg_id);
+    }
+    
+    free(json_buf);
+    free(b64_buf);
+}
 
