+
+def fetch_current_session() -> Optional[dict]:
+    """GET /api/v3/session/current，返回当前会话对象并缓存 session_id。"""
+    try:
+        r = requests.get(GATEWAY_SESSION_URL, timeout=GATEWAY_TIMEOUT_S)
