+static void usb_send_mlx_payload(uint8_t sensor_id, const uint8_t *payload, uint32_t total) {
+    bool cdc0_connected = false;
+    if (usb_lock(pdMS_TO_TICKS(2))) {
+        cdc0_connected = tud_cdc_n_connected(0);
+        usb_unlock();
+    }
+    if (!cdc0_connected) {
+        return;
+    }
+
+    // 发送统一包头: [0xAA, 0x55, TYPE, ID, LEN_LOW, LEN_HIGH]
+    if (usb_lock(pdMS_TO_TICKS(2))) {
+        uint8_t header[PACKET_HEADER_LEN];
+        protocol_fill_header(header, SENSOR_TYPE_MLX, sensor_id, (uint16_t)total);
+        tud_cdc_n_write(0, header, sizeof(header));
+        tud_cdc_n_write_flush(0);
+        usb_unlock();
+    }
+
+    // 发送 3072 字节的 Body
+    // TinyUSB 的内部 FIFO 默认可能只有 64~256 字节，所以要分块发送或等待
+    uint32_t sent = 0;
+    while (sent < total) {
+        if (usb_lock(pdMS_TO_TICKS(2))) {
+            int avail = tud_cdc_n_write_available(0);
+            if (avail > 0) {
+                int chunk = (total - sent) > (uint32_t)avail ? avail : (int)(total - sent);
+                int written = tud_cdc_n_write(0, payload + sent, chunk);
+                sent += written;
+                tud_cdc_n_write_flush(0);
+            }
+            usb_unlock();
+        }
+        vTaskDelay(1); // 等待 USB 主机取走数据
+    }
+
+    // 发送CRC校验
+    uint8_t crc_bytes[PACKET_CRC_LEN];
+    protocol_fill_crc(crc_bytes, payload, total);
+    if (usb_lock(pdMS_TO_TICKS(2))) {
+        tud_cdc_n_write(0, crc_bytes, sizeof(crc_bytes));
+        tud_cdc_n_write_flush(0);
+        usb_unlock();
+    }
+}
