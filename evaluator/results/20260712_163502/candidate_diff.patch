+def _migrate_care_events(conn):
+    """Add missing columns to care_events table if it was created by an older schema.
+
+    Old schema: event_id, subject_id, room, bed, kind, title, content, created_ts, updated_ts
+    New schema adds: severity, source, created_by, ts
+    """
+    existing_cols = set()
+    try:
+        rows = conn.execute("PRAGMA table_info(care_events)").fetchall()
+        existing_cols = {str(r["name"]) for r in rows}
+    except Exception:
+        return
+    if not existing_cols:
+        return
+    migrations = {
+        "severity": "ALTER TABLE care_events ADD COLUMN severity TEXT NOT NULL DEFAULT 'info'",
+        "source": "ALTER TABLE care_events ADD COLUMN source TEXT NOT NULL DEFAULT 'manual'",
+        "created_by": "ALTER TABLE care_events ADD COLUMN created_by TEXT NOT NULL DEFAULT ''",
+        "ts": "ALTER TABLE care_events ADD COLUMN ts INTEGER NOT NULL DEFAULT 0",
+    }
+    for col, sql in migrations.items():
+        if col not in existing_cols:
+            try:
+                conn.execute(sql)
+                # Backfill ts from created_ts for existing rows
+                if col == "ts":
+                    conn.execute("UPDATE care_events SET ts = created_ts WHERE ts = 0")
+                print(f"[DB] Migrated care_events: added column '{col}'")
+            except Exception as e:
+                print(f"[DB] Migration warning: {e}")
