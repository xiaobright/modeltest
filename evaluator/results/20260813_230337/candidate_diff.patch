+def _table_columns(conn, table: str) -> set:
+    return {str(row["name"]).lower() for row in conn.execute(f'PRAGMA table_info("{table}")').fetchall()}
+
+
+def _migrate_table_columns(conn, table: str) -> None:
+    existing = _table_columns(conn, table)
+    for column, definition in _TABLE_COLUMNS.get(table, {}).items():
+        if column not in existing:
+            conn.execute(f'ALTER TABLE "{table}" ADD COLUMN "{column}" {definition}')
+
+
+def _migrate_care_events(conn) -> None:
+    """Upgrade the pre-v4 care_events draft table in place.
+
+    Historical databases may already contain a care_events table with only
+    event_id/subject_id/room/bed/kind/title/content/created_ts/updated_ts.
+    CREATE TABLE IF NOT EXISTS leaves that table untouched, so missing
+    severity/source/created_by/ts are added explicitly and old rows are kept.
+    """
+    existing = _table_columns(conn, "care_events")
+    for column, definition in {
+        "severity": "TEXT NOT NULL DEFAULT 'info'",
+        "source": "TEXT NOT NULL DEFAULT 'manual'",
+        "created_by": "TEXT NOT NULL DEFAULT ''",
+        "ts": "INTEGER NOT NULL DEFAULT 0",
+    }.items():
+        if column not in existing:
+            conn.execute(f'ALTER TABLE care_events ADD COLUMN {column} {definition}')
+
+    # ts was introduced in v4; backfill from the legacy created_ts column so
+    # existing rows are ordered and queryable by the new contract.
+    if "created_ts" in existing:
+        conn.execute("UPDATE care_events SET ts = created_ts WHERE ts = 0 OR ts IS NULL")
+
