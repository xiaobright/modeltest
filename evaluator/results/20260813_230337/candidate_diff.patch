+def fetch_current_gateway_session() -> Optional[dict]:
+    """Explicitly discover the active recognition session.
+
+    The gateway no longer falls back to an ambient/current session inside
+    /api/v3/context/chat, so the voice assistant must ask for the current
+    session_id first and then carry it on the sensitive context request.
+    """
+    if not GATEWAY_CONTEXT_ENABLED:
+        return None
+    try:
+        url = f"{GATEWAY_BASE}/api/v3/session/current"
+        r = requests.get(url, timeout=GATEWAY_TIMEOUT_S)
+        r.raise_for_status()
+        obj = r.json()
+        if isinstance(obj, dict):
+            session = obj.get("session")
+            return session if isinstance(session, dict) else None
+    except Exception as e:  # noqa: BLE001
+        print(f"[GATEWAY当前会话获取失败] {e}")
+    return None
+
