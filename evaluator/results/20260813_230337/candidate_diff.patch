+# -*- coding: utf-8 -*-
+from collections import defaultdict
+from pypinyin import lazy_pinyin
+from rapidfuzz import fuzz
+import re
+
+INTENTS = {
+    "HEART_RATE": {
+        "phrases": ["心率检测", "测心率", "查看心率", "心跳检测", "测心跳", "看看心跳", "测脉搏"],
+        "keywords": ["心率", "心跳", "脉搏", "心律"],
