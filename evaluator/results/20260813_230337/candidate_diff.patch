-    for(int i=8; i<19; i++)
-    {
-        if(auxData[i] == 0x7FFF) return -8;
-    }
-    
-    for(int i=20; i<23; i++)
-    {
-        if(auxData[i] == 0x7FFF) return -8;
-    }
-    
-    for(int i=24; i<33; i++)
-    {
-        if(auxData[i] == 0x7FFF) return -8;
-    }
-    
-    for(int i=40; i<51; i++)
-    {
-        if(auxData[i] == 0x7FFF) return -8;
-    }
-    
-    for(int i=52; i<55; i++)
-    {
-        if(auxData[i] == 0x7FFF) return -8;
-    }
-    
-    for(int i=56; i<64; i++)
-    {
-        if(auxData[i] == 0x7FFF) return -8;
-    }
-    
-    return 0;
-    
